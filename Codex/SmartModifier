        return out

    def _move_setting_row(self, old_row, new_row, label_text=None, widget_span=1):
        """Move a settings grid row without losing the original column.

        The Modifier Stack UI reuses the Boolean settings grid, then moves some
        Bevel-only widgets lower in the section. Some rows only contain a
        checkbox in column 1. The old helper treated the first widget found as
        the label and re-added it in column 0, which caused Fractional / Chamfer
        / Force Parallel to jump left. This version preserves the original
        columns and only edits a real column-0 label.
        """
        try:
            old_row = int(old_row)
            new_row = int(new_row)
        except Exception:
            return []

        entries = []
        for col in (0, 1, 2):
            try:
                item = self.settings_layout.itemAtPosition(old_row, col)
                w = item.widget() if item else None
                if w is not None and all(w is not e[1] for e in entries):
                    entries.append((int(col), w))
            except Exception:
                pass
        if not entries:
            return []

        for _col, w in entries:
            try:
                self.settings_layout.removeWidget(w)
            except Exception:
                pass

        try:
            if label_text is not None:
                for col, w in entries:
                    if col == 0 and hasattr(w, "setText"):
                        w.setText(str(label_text))
                        break
        except Exception:
            pass

        try:
            for col, w in entries:
                if col <= 0:
                    self.settings_layout.addWidget(w, new_row, 0)
                elif col == 1:
                    self.settings_layout.addWidget(w, new_row, 1, 1, int(widget_span))
                else:
                    self.settings_layout.addWidget(w, new_row, 2)
        except Exception:
            pass
        return [w for _col, w in entries]

