# ---------------------------------------------------------------------------
# v6.10 Shell no-face-growth mode
# ---------------------------------------------------------------------------
# The native polyExtrudeFace.thickness attribute can visually grow/skew faces on
# bent/non-planar surfaces because Maya offsets/miter-solves the selected face
# island. For a modifier-stack Shell we want the default behavior to preserve the
# original face size and simply create side walls. Therefore SmartModifier stores
# the user-facing Thickness in custom attrs and drives the native extrusion with
# localTranslateZ instead of the unsafe native thickness channel.
#
# UI mapping in this mode:
#   Local Translate Z  -> extra translate amount
#   Thickness          -> main shell amount
#   Native thickness   -> forced to 0.0 to avoid face growth
#   Native localTranslateZ -> Local Translate Z + Thickness

_SM_SHELL_STORE_ATTRS = {
    "amount": "smShellAmountZ",
    "divisions": "smShellDivisions",
    "thickness": "smShellThickness",
    "offset": "smShellOffset",
    "keep_together": "smShellKeepTogether",
}


def _sm_ensure_shell_store_attrs(node):
    if not ex(node):
        return
    specs = (
        ("smShellAmountZ", "double", 0.0),
        ("smShellDivisions", "long", 1),
        ("smShellThickness", "double", 0.1),
        ("smShellOffset", "double", 0.0),
        ("smShellKeepTogether", "bool", 1),
        ("smShellNoFaceGrowthMode", "bool", 1),
    )
    try:
        c.lockNode(node, l=False)
    except Exception:
        pass
    for attr_name, attr_type, default_value in specs:
        try:
            if not c.attributeQuery(attr_name, n=node, ex=True):
                c.addAttr(node, ln=attr_name, at=attr_type, dv=default_value)
        except Exception:
            pass


def _sm_set_shell_store_attrs(node, values):
    if not ex(node):
        return
    values = _qd_shell_values(values)
    _sm_ensure_shell_store_attrs(node)
    data = (
        ("smShellAmountZ", float(values.get("amount", 0.0))),
        ("smShellDivisions", int(values.get("divisions", 1))),
        ("smShellThickness", float(values.get("thickness", 0.1))),
        ("smShellOffset", float(values.get("offset", 0.0))),
        ("smShellKeepTogether", int(bool(values.get("keep_together", True)))),
        ("smShellNoFaceGrowthMode", 1),
    )
    for attr_name, value in data:
        try:
            if c.attributeQuery(attr_name, n=node, ex=True):
                c.setAttr(node + "." + attr_name, value)
        except Exception:
            pass


def _sm_get_attr_if_exists(node, attr_name, default=None):
    if not ex(node):
        return default
    try:
        if c.attributeQuery(attr_name, n=node, ex=True):
            return c.getAttr(node + "." + attr_name)
    except Exception:
        pass
    return default


def _qd_shell_values_from_node(node):
    values = _qd_shell_defaults()
    if not ex(node):
        return _qd_shell_values(values)

    # Prefer SmartModifier user-facing values. Native polyExtrudeFace.thickness
    # is intentionally forced to zero in no-face-growth mode, so reading it would
    # make the UI incorrectly show Thickness = 0 after refresh.
    custom_present = False
    for key, attr_name in _SM_SHELL_STORE_ATTRS.items():
        value = _sm_get_attr_if_exists(node, attr_name, None)
        if value is not None:
            values[key] = value
            custom_present = True

    if custom_present:
        return _qd_shell_values(values)

    # Legacy fallback for Shell nodes created by v6.4-v6.9.
    mapping = {
        "amount": "localTranslateZ",
        "divisions": "divisions",
        "thickness": "thickness",
        "offset": "offset",
        "keep_together": "keepFacesTogether",
    }
    for key, attr_name in mapping.items():
        try:
            if c.attributeQuery(attr_name, n=node, ex=True):
                values[key] = c.getAttr(node + "." + attr_name)
        except Exception:
            pass
    return _qd_shell_values(values)


def _qd_set_shell_node(node, values=None):
    if not ex(node):
        return
    values = _qd_shell_values(values)
    try:
        c.lockNode(node, l=False)
    except Exception:
        pass
    try:
        _qd_force_shell_all_faces_component(node)
    except Exception:
        pass

    _sm_set_shell_store_attrs(node, values)

    amount = float(values.get("amount", 0.0))
    thickness = float(values.get("thickness", 0.1))
    native_translate_z = amount + thickness

    # Reset hidden transform channels. Pass the final native Z value, because in
    # this mode the Maya extrude distance lives on localTranslateZ.
    try:
        _sm_reset_shell_extrude_hidden_transform_attrs(node, amount_z=native_translate_z)
    except Exception:
        pass

    # Main native polyExtrudeFace attributes. Native thickness is deliberately
    # zero: it is the channel that was making faces visually enlarge/skew.
    mapping = (
        ("keepFacesTogether", int(bool(values["keep_together"]))),
        ("divisions", int(values["divisions"])),
        ("localTranslateZ", native_translate_z),
        ("thickness", 0.0),
        ("offset", float(values["offset"])),
        ("smoothingAngle", 30.0),
    )
    for attr_name, value in mapping:
        _sm_set_attr_if_exists(node, attr_name, value)

    # Keep every unexposed transform-style channel neutral.
    for attr_name, value in (
        ("localTranslateX", 0.0),
        ("localTranslateY", 0.0),
        ("localRotateX", 0.0),
        ("localRotateY", 0.0),
        ("localRotateZ", 0.0),
        ("localScaleX", 1.0),
        ("localScaleY", 1.0),
        ("localScaleZ", 1.0),
        ("random", 0.0),
        ("twist", 0.0),
        ("taper", 1.0),
    ):
        _sm_set_attr_if_exists(node, attr_name, value)

    try:
        c.dgdirty(node)
    except Exception:
        pass


def _qd_create_shell_node(t, result_shape, values=None):
    values = _qd_shell_values(values)
    if not result_shape or not ex(result_shape):
        return None

    before = set(c.ls(type="polyExtrudeFace") or [])
    old_selection = []
    try:
        old_selection = c.ls(sl=True, long=True, flatten=True) or []
    except Exception:
        old_selection = []

    native_translate_z = float(values.get("amount", 0.0)) + float(values.get("thickness", 0.1))
    made = None
    try:
        for shape_node in sh(t):
            setv(shape_node, lg(shape_node) == lg(result_shape))
        try:
            c.selectMode(component=True)
        except Exception:
            pass
        try:
            c.select(t + ".f[*]", replace=True)
        except Exception:
            c.select(t, replace=True)

        # Create with native thickness = 0, then store the UI thickness on custom
        # attrs and drive the extrude through localTranslateZ. This avoids the
        # unwanted face-growth behavior visible in v6.9.
        made = c.polyExtrudeFacet(
            constructionHistory=True,
            keepFacesTogether=int(bool(values["keep_together"])),
            divisions=int(values["divisions"]),
            twist=0,
            taper=1,
            offset=float(values["offset"]),
            thickness=0.0,
            smoothingAngle=30,
        )
    finally:
        try:
            c.selectMode(object=True)
        except Exception:
            pass
        try:
            c.select(t, replace=True)
        except Exception:
            try:
                c.select(old_selection, replace=True)
            except Exception:
                pass

    node = _qd_new_shell_node_from_command(before, made)
    if not node:
        raise RuntimeError("polyExtrudeFace node not found after Shell creation.")
    node = _qd_mark_shell_node(node) or node
    try:
        node = lg(c.rename(node, sn(t) + "_shellModifier"))
    except Exception:
        pass
    node = _qd_mark_shell_node(node) or node
    _qd_force_shell_all_faces_component(node)
    _qd_set_shell_node(node, values)
    # Make sure localTranslateZ is set even if _qd_set_shell_node got overridden
    # by an older patch earlier in the file.
    _sm_set_attr_if_exists(node, "localTranslateZ", native_translate_z)
    _sm_set_attr_if_exists(node, "thickness", 0.0)
    return node


