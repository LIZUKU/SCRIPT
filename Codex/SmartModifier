        c.warning('Select the boolean result mesh, then the Live Bevel object.')
        return
    src=srcs[0]
    if tgts: tgt=tgts[-1]
    else:
        lives=[t for t in all_live() if lg(t)!=lg(src)]
        if len(lives)!=1:
            c.warning('Select source mesh + target Live Bevel object.')
            return
        tgt=lives[0]
