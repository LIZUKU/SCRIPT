        n = _ms_add_bevel(self.target, self._values_from_settings())
        self.input_names = _ms_stack_nodes(self.target)
        if n in self.input_names:
            self._selected_row_index = self.input_names.index(n)
            self.current_node = n
        self.refresh_from_scene()

