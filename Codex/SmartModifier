# ---------------------------------------------------------------------------
# Safe Shell modifier patch
# ---------------------------------------------------------------------------
# This patch is intentionally isolated from the core Bevel backend. The previous
# Shell build touched too many base functions at once; this version keeps the
# stable Bevel workflow and only adds a guarded polyExtrudeFace modifier path.

_QD_SHELL_NODE_TYPES = ("polyExtrudeFace",)


def _qd_is_live_shell_node(node):
    if not ex(node):
        return False
    try:
        if c.nodeType(node) not in _QD_SHELL_NODE_TYPES:
            return False
    except Exception:
        return False
    try:
        if c.attributeQuery("liveShellNode", n=node, ex=True):
            return True
    except Exception:
        pass
    try:
        return sn(node).endswith("_shellModifier")
    except Exception:
        return False


# Public name used by the UI/row label helpers.
def is_live_shell_node(node):
    return _qd_is_live_shell_node(node)


def _qd_is_live_modifier_node(node):
    try:
        return bool(is_live_bevel_node(node) or _qd_is_live_shell_node(node))
    except Exception:
        try:
            return bool(is_live_bevel_node(node))
        except Exception:
            return False


_ORIG_MS_STACK_NODES = _ms_stack_nodes
_ORIG_LIVE_FUNC = live
_ORIG_BAKE_FUNC = bake
_ORIG_LOAD_SETTINGS = ModifierStackExactUI._load_current_modifier_settings
_ORIG_APPLY_SETTINGS = ModifierStackExactUI._apply_settings_from_ui
_ORIG_ON_DROPPED = ModifierStackExactUI._on_objects_dropped
_ORIG_LABEL_FOR_NODE = _ms_label_for_node


def _ms_stack_nodes(t):
    if not ex(t):
        return []
    out = []
    search = []
    rr = res(t)
    if rr:
        search.append(rr)
    for shape_node in sh(t):
        if shape_node not in search:
            search.append(shape_node)
    for shape_node in search:
        try:
            nodes = hist(shape_node)
        except Exception:
            nodes = []
        for node in nodes:
            if ex(node) and _qd_is_live_modifier_node(node):
                ln = lg(node)
                if ln not in out:
                    out.append(ln)
    return out


def live(t):
    try:
        return bool(base(t) and res(t) and tag(t) and _ms_stack_nodes(t))
    except Exception:
        return _ORIG_LIVE_FUNC(t)


def _ms_label_for_node(node):
    if not ex(node):
        return "Missing"
    if _qd_is_live_shell_node(node):
        return "Shell"
    return _ORIG_LABEL_FOR_NODE(node)


def _qd_mark_shell_node(node):
    if not ex(node):
        return node
    try:
        c.lockNode(node, l=False)
    except Exception:
        pass
    try:
        if not c.attributeQuery("liveShellNode", n=node, ex=True):
            c.addAttr(node, ln="liveShellNode", at="bool", dv=1)
        c.setAttr(node + ".liveShellNode", 1)
    except Exception:
        pass
    try:
        if not sn(node).endswith("_shellModifier"):
            node = c.rename(node, "shellModifier")
    except Exception:
        pass
    # Important: do not lock polyExtrudeFace nodes. Locked native extrude nodes can
    # become unstable while Maya is evaluating history during slider drags.
    return lg(node) if ex(node) else node


def _qd_mark_shell_transform(t):
    if not ex(t):
        return
    # Keep the existing tag() function compatible: liveBevel is the historical
    # stack marker even when the stack currently contains only Shell.
    for attr_name in ("liveBevel", "liveModifierStack"):
        try:
            if not c.attributeQuery(attr_name, n=t, ex=True):
                c.addAttr(t, ln=attr_name, at="bool", dv=1)
            c.setAttr(t + "." + attr_name, 1)
        except Exception:
            pass


def _qd_shell_defaults():
    return {
        # Shell should behave like a thickness modifier first. Keep Local Translate Z
        # neutral by default so the native extrude node does not drag a whole face
        # selection along an averaged manipulator direction on bent surfaces.
        "amount": 0.0,
        "divisions": 1,
        "thickness": 0.1,
        "offset": 0.0,
        "keep_together": True,
    }


def _qd_shell_values(values=None):
    base_values = _qd_shell_defaults()
    if isinstance(values, dict):
        for key in base_values:
            if key in values:
                base_values[key] = values[key]
    else:
        try:
            data = list(values or [])
        except Exception:
            data = []
        keys = ["amount", "divisions", "thickness", "offset", "keep_together"]
        for index, key in enumerate(keys):
            if index < len(data):
                base_values[key] = data[index]
    try:
        base_values["amount"] = float(base_values.get("amount", 0.1))
    except Exception:
        base_values["amount"] = 0.1
    try:
        base_values["divisions"] = max(1, int(float(base_values.get("divisions", 1))))
    except Exception:
        base_values["divisions"] = 1
    try:
        base_values["thickness"] = float(base_values.get("thickness", 0.0))
    except Exception:
        base_values["thickness"] = 0.0
    try:
        base_values["offset"] = float(base_values.get("offset", 0.0))
    except Exception:
        base_values["offset"] = 0.0
    base_values["keep_together"] = bool(base_values.get("keep_together", True))
    return base_values


def _qd_shell_values_from_node(node):
    values = _qd_shell_defaults()
    if not ex(node):
        return values
    mapping = {
        "amount": "localTranslateZ",
        "divisions": "divisions",
        "thickness": "thickness",
        "offset": "offset",
        "keep_together": "keepFacesTogether",
    }
    for key, attr_name in mapping.items():
        try:
            if c.attributeQuery(attr_name, n=node, ex=True):
                values[key] = c.getAttr(node + "." + attr_name)
        except Exception:
            pass
    return _qd_shell_values(values)


def _qd_set_shell_node(node, values=None):
    if not ex(node):
        return
    values = _qd_shell_values(values)
    try:
        c.lockNode(node, l=False)
    except Exception:
        pass
    _qd_force_shell_all_faces_component(node)
    mapping = (
        ("keepFacesTogether", int(bool(values["keep_together"]))),
        ("divisions", int(values["divisions"])),
        ("offset", float(values["offset"])),
        ("thickness", float(values["thickness"])),
        ("localTranslateZ", float(values["amount"])),
        ("smoothingAngle", 30.0),
    )
    for attr_name, value in mapping:
        try:
            if c.attributeQuery(attr_name, n=node, ex=True):
                c.setAttr(node + "." + attr_name, value)
        except Exception:
            pass


def _qd_ensure_stack_for_shell(t):
    if not ex(t) or not sh(t):
        return None
    _qd_mark_shell_transform(t)
    b = base(t)
    rr = res(t)
    if b and rr and ex(rr):
        return rr
    src = vis(t) or (sh(t)[0] if sh(t) else None)
    if not src:
        return None
    b = ren(src, sn(t) + "_baseShape")
    rr = dupshape(t, sn(t) + "_resultShape")
    try:
        c.connectAttr(b + ".outMesh", rr + ".inMesh", force=True)
    except Exception:
        pass
    setv(b, False)
    setv(rr, True)
    try:
        c.setAttr(t + ".visibility", 1)
    except Exception:
        pass
    return rr


def _qd_new_shell_node_from_command(before, made):
    after = set(c.ls(type="polyExtrudeFace") or [])
    new_nodes = [node for node in after - before if ex(node)]
    if new_nodes:
        return lg(new_nodes[0])
    for item in (made if isinstance(made, (list, tuple)) else [made]):
        try:
            if ex(item) and c.nodeType(item) in _QD_SHELL_NODE_TYPES:
                return lg(item)
        except Exception:
            pass
    return None



def _qd_force_shell_all_faces_component(node):
    """Keep Shell procedural on the whole incoming mesh.

    Maya's selection string t.f[*] is often expanded into the exact face range that
    existed when the extrude node was created. That behaves like a static component
    selection and does not include faces added later in Edit Base. For a modifier
    workflow we want the node to evaluate on every face of its current input, so we
    force the componentList attr back to the wildcard form when Maya exposes it.
    """
    if not ex(node):
        return False
    ok = False
    try:
        c.lockNode(node, l=False)
    except Exception:
        pass
    for attr_name in ("inputComponents", "inputComponent"):
        try:
            if c.attributeQuery(attr_name, n=node, ex=True):
                c.setAttr(node + "." + attr_name, 1, "f[*]", type="componentList")
                ok = True
        except Exception:
            pass
    return ok


def _qd_shell_uses_all_faces_component(node):
    if not ex(node):
        return False
    for attr_name in ("inputComponents", "inputComponent"):
        try:
            if c.attributeQuery(attr_name, n=node, ex=True):
                raw = c.getAttr(node + "." + attr_name)
                return "f[*]" in str(raw)
        except Exception:
            pass
    return False

def _qd_create_shell_node(t, result_shape, values=None):
    values = _qd_shell_values(values)
    if not result_shape or not ex(result_shape):
        return None

    before = set(c.ls(type="polyExtrudeFace") or [])
    old_selection = []
    try:
        old_selection = c.ls(sl=True, long=True, flatten=True) or []
    except Exception:
        old_selection = []

    made = None
    try:
        # Make the result shape the only visible/live shape before adding the node.
        for shape_node in sh(t):
            setv(shape_node, lg(shape_node) == lg(result_shape))
        try:
            c.selectMode(component=True)
        except Exception:
            pass
        try:
            c.select(t + ".f[*]", replace=True)
        except Exception:
            c.select(t, replace=True)
        # Selection-driven call is safer with Maya's native polyExtrudeFacet than
        # passing a locked/intermediate shape component directly as the first arg.
        made = c.polyExtrudeFacet(
            constructionHistory=True,
            keepFacesTogether=int(bool(values["keep_together"])),
            divisions=int(values["divisions"]),
            twist=0,
            taper=1,
            offset=float(values["offset"]),
            thickness=float(values["thickness"]),
            smoothingAngle=30,
        )
    finally:
        try:
            c.selectMode(object=True)
        except Exception:
            pass
        try:
            c.select(t, replace=True)
        except Exception:
            try:
                c.select(old_selection, replace=True)
            except Exception:
                pass

    node = _qd_new_shell_node_from_command(before, made)
    if not node:
        raise RuntimeError("polyExtrudeFace node not found after Shell creation.")
    node = _qd_mark_shell_node(node) or node
    try:
        node = lg(c.rename(node, sn(t) + "_shellModifier"))
    except Exception:
        pass
    node = _qd_mark_shell_node(node) or node
    _qd_force_shell_all_faces_component(node)
    _qd_set_shell_node(node, values)
    return node


def _ms_add_shell(t, values=None):
    if not ex(t) or not sh(t):
        return None
    unlock_result(t)
    rr = _qd_ensure_stack_for_shell(t)
    if not rr:
        return None
    unlock_result(t)
    node = _qd_create_shell_node(t, rr, values)
    _qd_mark_shell_transform(t)
    try:
        show_res(t)
    except Exception:
        for shape_node in sh(t):
            setv(shape_node, lg(shape_node) == lg(rr))
    try:
        c.select(t, replace=True)
    except Exception:
        pass
    return node


