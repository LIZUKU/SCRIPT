def _qd_on_objects_dropped(self, objects):
    try:
        modifier_kind = str(self.op_combo.currentText())
    except Exception:
        modifier_kind = "Bevel"
    if not modifier_kind.lower().startswith("shell"):
        return _ORIG_ON_DROPPED(self, objects)
    if not maya_available():
        return
    meshes = _mesh_transforms_from_names(objects, exclude=[], skip_existing=None)
    if not meshes:
        self._warning("Drop ignore : aucun mesh valide pour recevoir un modifier.")
        return
    values = _qd_shell_values_from_ui(self)
    added = []
    try:
        c.undoInfo(openChunk=True, chunkName="Modifier Stack Drop Add Shell")
    except Exception:
        pass
    try:
        for mesh in meshes:
            node = _ms_add_shell(mesh, values)
            if node:
                added.append((mesh, node))
    finally:
        try:
            c.undoInfo(closeChunk=True)
        except Exception:
            pass
    if not added:
        self._warning("Drop reçu, mais aucun Shell modifier n'a pu être ajouté.")
        self.refresh_from_scene()
        return
    self.target = lg(added[-1][0]) or added[-1][0]
    self.current_node = added[-1][1]
    try:
        c.select([mesh for mesh, _node in added], replace=True)
    except Exception:
        pass
    self.refresh_from_scene()


def _qd_bake():
    ts = [t for t in sel() if tag(t)]
    if not ts:
        return
    t = ts[0]
    try:
        live_nodes = _ms_stack_nodes(t)
    except Exception:
        live_nodes = [bev(t)] if bev(t) else []
    try:
        c.undoInfo(openChunk=True, chunkName="Bake Modifier Stack")
    except Exception:
        pass
    try:
        for node in live_nodes:
            try: c.lockNode(node, l=False)
            except Exception: pass
        ns = baked_shape_from_result(t)
        unlock_result(t)
        if not ns:
            return
        for shape_node in [x for x in sh(t) if lg(x) != lg(ns)]:
            try: c.delete(shape_node)
            except Exception: pass
        for node in live_nodes:
            if ex(node):
                try: c.delete(node)
                except Exception: pass
        setv(ns, True)
        clean(t)
        try:
            if c.attributeQuery("liveModifierStack", n=t, ex=True):
                c.deleteAttr(t + ".liveModifierStack")
        except Exception:
            pass
        for shape_node in sh(t):
            setv(shape_node, lg(shape_node) == lg(ns))
        try:
            c.setAttr(t + ".visibility", 1)
            c.refresh(force=True)
        except Exception:
            pass
        c.select(t, replace=True)
    finally:
        try:
            c.undoInfo(closeChunk=True)
        except Exception:
            pass



