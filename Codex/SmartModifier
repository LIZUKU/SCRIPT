def _draw_down_arrow(painter, x, y, color):
    path = QtGui.QPainterPath()
    path.moveTo(x, y)
    path.lineTo(x + 6, y)
    path.lineTo(x + 3, y + 4)
    path.closeSubpath()
    painter.setPen(QT_NO_PEN)
    painter.setBrush(QtGui.QBrush(color))
    painter.drawPath(path)


def draw_operation_icon(painter, rect, label):
    painter.save()
    painter.setRenderHint(QT_ANTIALIAS, True)
    red = _qcolor("#cc4444")
    grey = _qcolor("#aaaaaa")
    dark = _qcolor("#3e3e3e")
    white = _qcolor("#dedede")

    r = QtCore.QRectF(rect)
    cx = r.center().x()
    cy = r.center().y()
    rad = min(r.width(), r.height()) * 0.32
    label_norm = label.lower()

    pen_red = QtGui.QPen(red, 1.4)
    pen_grey = QtGui.QPen(grey, 1.2)
    pen_white = QtGui.QPen(white, 1.2)

    if label_norm.startswith("bevel"):
        outer = QtCore.QRectF(cx - rad * 1.10, cy - rad * 1.10, rad * 2.20, rad * 2.20)
        inner = QtCore.QRectF(cx - rad * 0.52, cy - rad * 0.52, rad * 1.04, rad * 1.04)
        path = QtGui.QPainterPath()
        path.moveTo(outer.left(), outer.top() + outer.height() * 0.30)
        path.lineTo(outer.left() + outer.width() * 0.30, outer.top())
        path.lineTo(outer.right(), outer.top())
        path.lineTo(outer.right(), outer.top() + outer.height() * 0.70)
        path.lineTo(outer.right() - outer.width() * 0.30, outer.bottom())
        path.lineTo(outer.left(), outer.bottom())
        path.closeSubpath()
        painter.setPen(QtGui.QPen(red, 1.45))
        painter.setBrush(QtCore.Qt.NoBrush)
        painter.drawPath(path)
        painter.setPen(QtGui.QPen(white, 1.05))
        painter.drawRoundedRect(inner, 1.4, 1.4)
    elif label_norm.startswith("union"):
        painter.setPen(pen_red)
        painter.setBrush(QtGui.QBrush(_qcolor("#9b2424", 145)))
        painter.drawEllipse(QtCore.QPointF(cx - rad * 0.45, cy), rad, rad)
        painter.drawEllipse(QtCore.QPointF(cx + rad * 0.45, cy), rad, rad)
    elif "difference (a-b)" in label_norm:
        painter.setPen(pen_grey)
        painter.setBrush(QtCore.Qt.NoBrush)
        painter.drawEllipse(QtCore.QPointF(cx - rad * 0.25, cy), rad, rad)
        painter.setPen(pen_red)
        painter.setBrush(QtGui.QBrush(red))
        painter.drawEllipse(QtCore.QPointF(cx + rad * 0.45, cy), rad * 0.72, rad * 0.72)
    elif "difference (b-a)" in label_norm:
        painter.setPen(pen_red)
        painter.setBrush(QtGui.QBrush(red))
        painter.drawEllipse(QtCore.QPointF(cx - rad * 0.45, cy), rad * 0.72, rad * 0.72)
        painter.setPen(pen_grey)
        painter.setBrush(QtCore.Qt.NoBrush)
        painter.drawEllipse(QtCore.QPointF(cx + rad * 0.25, cy), rad, rad)
    elif label_norm.startswith("intersection"):
        painter.setPen(pen_red)
        painter.setBrush(QtCore.Qt.NoBrush)
        painter.drawEllipse(QtCore.QPointF(cx - rad * 0.45, cy), rad, rad)
        painter.drawEllipse(QtCore.QPointF(cx + rad * 0.45, cy), rad, rad)
        painter.setBrush(QtGui.QBrush(_qcolor("#cc4444", 150)))
        painter.drawEllipse(QtCore.QPointF(cx, cy), rad * 0.42, rad * 0.82)
    elif label_norm.startswith("slice"):
        painter.setPen(pen_red)
        painter.setBrush(QtGui.QBrush(red))
        painter.drawRect(QtCore.QRectF(cx - rad, cy - rad * 0.45, rad * 1.8, rad * 0.9))
        painter.setPen(QtGui.QPen(white, 1.4))
        painter.drawLine(QtCore.QPointF(cx - rad * 1.1, cy - rad), QtCore.QPointF(cx + rad * 1.1, cy + rad))
    elif label_norm.startswith("hole"):
        painter.setPen(pen_red)
        painter.setBrush(QtCore.Qt.NoBrush)
