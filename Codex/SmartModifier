    def _objects_from_event_for_drop(self, event):


        return _objects_from_drop_event(event, exclude=self._drop_exclude_names(), skip_existing=None)

    def _accept_drag_event(self, event):
        try:
            if QT_COPY_ACTION is not None:
                event.setDropAction(QT_COPY_ACTION)
                event.accept()
            else:
                event.acceptProposedAction()
        except Exception:
            try:
                event.acceptProposedAction()
            except Exception:
                event.accept()

    def _handle_drop_event(self, event):
        et = event.type()

        if et in (QT_EVENT_DRAG_ENTER, QT_EVENT_DRAG_MOVE):
            objects = self._objects_from_event_for_drop(event)
            if objects:
                self._last_drop_objects = objects
                self._set_drop_active(True)
                self._accept_drag_event(event)
                return True
            self._last_drop_objects = []
            self._set_drop_active(False)
            try:
                event.ignore()
            except Exception:
                pass
            return True

        if et == QT_EVENT_DRAG_LEAVE:
            self._last_drop_objects = []
            self._set_drop_active(False)
            try:
                event.accept()
            except Exception:
                pass
            return True

        if et == QT_EVENT_DROP:
            objects = self._objects_from_event_for_drop(event) or list(self._last_drop_objects)
            self._last_drop_objects = []
            self._set_drop_active(False)
            if objects:
                self._accept_drag_event(event)
                self._on_objects_dropped(objects)
                return True
            try:
                event.ignore()
            except Exception:
                pass
            return True

        return False

