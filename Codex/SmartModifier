        painter.drawLine(QtCore.QPointF(cx - rad, cy + rad), QtCore.QPointF(cx + rad, cy - rad))
    else:
        painter.setPen(QtGui.QPen(red, 1.4))
        y0 = cy - rad * 0.6
        for k in range(3):
            painter.drawLine(QtCore.QPointF(cx - rad * 1.1, y0 + k * rad * 0.6),
                             QtCore.QPointF(cx + rad * 1.1, y0 + k * rad * 0.6))
