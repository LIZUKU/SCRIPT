        except Exception:
            pass
        if widget not in self._drop_widgets:
            self._drop_widgets.append(widget)

    def eventFilter(self, obj, event):
        et = event.type()
        if obj in getattr(self, "_drop_widgets", []) and et in (QT_EVENT_DRAG_ENTER, QT_EVENT_DRAG_MOVE, QT_EVENT_DRAG_LEAVE, QT_EVENT_DROP):
            return self._handle_drop_event(event)
        return QtWidgets.QDialog.eventFilter(self, obj, event)


