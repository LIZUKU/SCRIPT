        self.input_names = []
        self.current_node = None
        self._rebuild_input_rows()

    def _sync_selection_from_maya(self):
        if self._building:
            return
        try:
            if getattr(self, "lock_list_cb", None) is not None and self.lock_list_cb.isChecked() and self.target and ex(self.target):
                return
        except Exception:
            pass

        t = _ms_target_from_selection()
        if not t or not ex(t):
            return

        try:
            current_is_live = bool(self.target and ex(self.target) and tag(self.target))
        except Exception:
            current_is_live = False
        try:
            selected_is_live = bool(tag(t))
        except Exception:
            selected_is_live = False

        # Important boolean workflow protection:
        # Edit Base -> select cutters / boolean output should not make the UI
        # forget the old live stack. Show Result then still has the source and
        # can transfer to NEWEDITBASE automatically.
        if current_is_live and not selected_is_live:
            return

        if lg(t) != lg(self.target):
            self.target = lg(t)
            self.refresh_from_scene()

    def _rebuild_input_rows(self):
        self._clear_rows()
        if not self.input_names:
            self._selected_row_index = -1
            self._selected_row_indices = set()
            self._last_clicked_row_index = -1
            self.empty_state_widget = EmptyModifierStackState()
            self.empty_state_widget.setToolTip("Drop a mesh here or click + Bevel to create a modifier stack.")
            self._register_drop_widget(self.empty_state_widget)
            self.rows_layout.addWidget(self.empty_state_widget, 1)
        else:
            if self._selected_row_index < 0 or self._selected_row_index >= len(self.input_names):
                self._selected_row_index = len(self.input_names) - 1
            self._selected_row_indices = set([self._selected_row_index])
            for i, node in enumerate(self.input_names):
                label = _ms_label_for_node(node)
                try:
                    if len(self.input_names) > 1:
                        label = "%s %02d" % (label, i + 1)
                except Exception:
                    pass
                row = InputRow(label, index=i, is_base=(i == 0))
                row.object_name = node
                try:
                    # Modifier Stack rows are compact: keep the action buttons glued
                    # to the modifier label. The previous fixed label width left a
                    # visible gap between "Bevel" and the buttons.
                    try:
                        fm = row.name_label.fontMetrics()
                        if hasattr(fm, "horizontalAdvance"):
                            label_px = fm.horizontalAdvance(str(label))
                        else:
                            label_px = fm.width(str(label))
                    except Exception:
                        label_px = 34
                    # Make the modifier action buttons sit immediately after the label.
                    # For the single Bevel modifier row, do not keep a hidden generic label column.
                    if str(label).strip().lower() == "bevel":
                        label_w = max(self._scaled_w_floor(28, 34), int(label_px) + self._scaled_w_floor(5, 4))
                    else:
                        label_w = int(label_px) + self._scaled_w_floor(6, 4)
                    row.name_label.setAlignment((QT_ALIGN_LEFT or 0) | (QT_ALIGN_VCENTER or 0))
                    row.name_label.setMinimumWidth(int(label_w))
                    row.name_label.setMaximumWidth(int(label_w))
                    row.name_label.setFixedWidth(int(label_w))
                    row.name_label.setSizePolicy(QtWidgets.QSizePolicy.Fixed, QtWidgets.QSizePolicy.Fixed)
                    row.layout().setSpacing(self._scaled_gap(4, 3, 5))
                    row_menu_w = self._scaled_w_floor(40, 52)
                    row_menu_h = min(26, max(23, row.height() - 6))
                    row_eye_w = self._scaled_w_floor(24, 30)
                    row_toggle_w = self._scaled_w_floor(28, 32)
                    row_toggle_h = min(row_menu_h, self._scaled_floor(17, 16))
                    row.operation_btn.setFixedSize(row_menu_w, row_menu_h)
                    row.display_btn.setFixedSize(row_menu_w, row_menu_h)
                    row.visibility_btn.setFixedSize(row_eye_w, row_menu_h)
                    row.toggle.setFixedSize(row_toggle_w, row_toggle_h)
                    row.layout().setStretchFactor(row.name_label, 0)
                    row.layout().setStretchFactor(row.operation_btn, 0)
                    row.layout().setStretchFactor(row.display_btn, 0)
                    row.layout().setStretchFactor(row.visibility_btn, 0)
                    row.layout().setStretchFactor(row.toggle, 0)
                    row.layout().addStretch(1)
                    try:
                        row_w = int(self._modifier_panel_width())
                    except Exception:
                        row_w = self._scaled_w_floor(255, 316)
                    row.setMinimumWidth(row_w)
                    row.setMaximumWidth(16777215)
                    row.setSizePolicy(QtWidgets.QSizePolicy.Expanding, QtWidgets.QSizePolicy.Fixed)
                    try:
                        self._hide_modifier_list_scrollbars()
                    except Exception:
                        pass
                except Exception:
                    pass
                row.setToolTip("Modifier row: RMB options | toggle enable | drag reorder preview | node: %s" % sn(node))
                self._register_drop_widget(row)
                for child in (row.left_bar, row.name_label, row.operation_btn, row.display_btn, row.visibility_btn, row.toggle):
                    self._register_drop_widget(child)
                try:
                    row.operation_btn.labels = ["Bevel", "Shell"]
                    row.operation_btn._build_menu()
                    row.operation_btn.set_value(_ms_label_for_node(node), emit_signal=False)
                except Exception:
                    pass
                try:
                    row.display_btn.labels = ["Node", "Show Result", "Edit Base"]
                    row.display_btn._build_menu()
                    row.display_btn.set_value("Node", emit_signal=False)
                except Exception:
                    pass
                try:
                    row.visibility_btn.setChecked(True)
                except Exception:
                    pass
                try:
                    row.toggle.setChecked(_ms_node_enabled(node), emit_signal=False)
                except Exception:
                    pass
                row.operation_changed.connect(self._on_modifier_type_changed)
                row.display_changed.connect(self._on_modifier_display_action)
                row.visibility_changed.connect(self._on_modifier_visibility_changed)
                row.active_changed.connect(self._on_modifier_active_changed)
                row.selected.connect(self._set_selected_row)
                row.context_menu_requested.connect(self._show_modifier_row_context_menu)
                row.reorder_drag_started.connect(self._on_input_reorder_drag_started)
                row.reorder_drag_moved.connect(self._on_input_reorder_drag_moved)
                row.reorder_drag_released.connect(self._on_input_reorder_drag_released)
                row.setSelected(i == self._selected_row_index)
                self.rows_layout.addWidget(row)
                self.input_rows.append(row)
            self.rows_layout.addStretch(1)
        self._update_input_list_height()
        try:
            self._queue_layout_rebalance()
        except Exception:
            pass

    def _set_selected_row(self, row_index):
        try:
            row_index = int(row_index)
        except Exception:
            row_index = -1
        if row_index < 0 or row_index >= len(self.input_names):
            return
        self._selected_row_index = row_index
        self._selected_row_indices = set([row_index])
        self.current_node = self.input_names[row_index]
        for i, row in enumerate(self.input_rows):
            try:
                row.setSelected(i == row_index)
            except Exception:
                pass
        self._load_current_modifier_settings()
        if self.target and ex(self.target):
            try: c.select(self.target, r=1)
            except Exception: pass

    def _current_node(self):
        if self.current_node and ex(self.current_node):
            return self.current_node
        if 0 <= self._selected_row_index < len(self.input_names):
            self.current_node = self.input_names[self._selected_row_index]
            return self.current_node
        if self.input_names:
            self.current_node = self.input_names[-1]
            return self.current_node
        return None

    def _load_current_modifier_settings(self):
        n = self._current_node()
        if not n or not ex(n):
            return
        self._building = True
        try:
            w, seg, frac, m, ma, cham, fp, se, he, eba, fa = vals(self.target, n)
            depth = depth_val(self.target, n)
            self.interactive_cb.setChecked(_ms_node_enabled(n))
            self._set_combo_text(self.op_combo, "Bevel")
            self._set_combo_text(self.display_combo, ["Auto", "Uniform", "Patch", "Radial", "None"][max(0, min(4, int(m)))])
            self._set_combo_text(self.geometry_combo, ["Auto", "Center", "Edge"][max(0, min(2, int(ma)))])
            self.voxel_edit.setValue(float(w))
            self.segments_edit.setValue(int(seg))
            self.depth_edit.setValue(float(depth))
            self.fractional_cb.setChecked(bool(frac))
            self.chamfer_cb.setChecked(bool(cham))
            self.force_parallel_cb.setChecked(bool(fp))
            self.filter_angle_edit.setValue(float(fa))
            self.radio_auto.setChecked(bool(se))
            self.radio_edge.setChecked(bool(he))
            self.radio_normal.setChecked(bool(eba))
        finally:
            self._building = False

    def _values_from_settings(self):
        m = max(0, self.display_combo.currentIndex())
        ma = max(0, self.geometry_combo.currentIndex())
        return (
            float(self.voxel_edit.value()),
            int(self.segments_edit.value()),
            bool(self.fractional_cb.isChecked()),
            int(m),
            int(ma),
            bool(self.chamfer_cb.isChecked()),
            bool(self.force_parallel_cb.isChecked()),
            bool(self.radio_auto.isChecked()),
            bool(self.radio_edge.isChecked()),
            bool(self.radio_normal.isChecked()),
            float(self.filter_angle_edit.value()),
            float(self.depth_edit.value()),
        )

    def _apply_settings_from_ui(self, *_):
        if self._building:
            return
        n = self._current_node()
        if not n or not ex(n):
            return
        values = self._values_from_settings()
        setbev(n, *values)
        if self.target and ex(self.target):
            mark(self.target, *values)
            try: c.select(self.target, r=1)
