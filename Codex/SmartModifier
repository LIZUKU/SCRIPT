    def _validation_target_name(self):

        if maya_available():
            try:
                result = find_result_transform(self.poly_node) if self.poly_node else self.result_transform
                if result and cmds.objExists(result):
                    tr = _as_transform(result)
                    if tr and cmds.objExists(tr) and _has_mesh_shape(tr):
                        return tr
            except Exception:
                pass
            try:
                if self.result_transform and cmds.objExists(self.result_transform):
                    return self.result_transform
            except Exception:
                pass
            try:
                source = self._source_input_name()
                if source and cmds.objExists(source):
                    return source
            except Exception:
                pass
        return self.result_transform or self._source_input_name()

    def _boolean_stack_meshes_for_backup(self):

        meshes = []
        try:
            source = self._source_input_name()
            if source:
                meshes.append(source)
        except Exception:
            pass
        try:
            meshes.extend(list(self.input_names or []))
        except Exception:
            pass
        out = []
        seen = set()
        if not maya_available():
            return meshes
        for name in meshes:
            try:
                if not name or not cmds.objExists(name):
                    continue
                transform = _as_transform(name)
                short = _short_name(transform)
                if not transform or short in seen:
                    continue
                if _safe_node_type(transform) != "transform" or not _has_mesh_shape(transform):
                    continue
                seen.add(short)
                out.append(transform)
            except Exception:
                pass
        return out

    def _duplicate_boolean_stack_to_hidden_group(self, select_group=False):

        if not maya_available():
            return None
        meshes = self._boolean_stack_meshes_for_backup()
        if not meshes:
            self._warning("Backup boolean : aucun mesh source/cutter valide a dupliquer.")
            return None

        source = self._source_input_name()
        group = None
        duplicated = []
        undo_open = False
        try:
            try:
                cmds.undoInfo(openChunk=True, chunkName="UiBoolean Backup Inputs")
                undo_open = True
            except Exception:
                pass

            group_name = _unique_hidden_backup_group_name(self.poly_node, source)
            try:
                group = cmds.group(empty=True, name=group_name)
            except Exception:
                group = cmds.createNode("transform", name=group_name)

            for obj in meshes:
                if not obj or not cmds.objExists(obj):
                    continue
                dup = []
                try:
                    dup = cmds.duplicate(
                        obj,
                        returnRootsOnly=True,
                        renameChildren=True,
                        inputConnections=False,
                        upstreamNodes=False,
                    ) or []
                except TypeError:
                    try:
                        dup = cmds.duplicate(obj, returnRootsOnly=True, renameChildren=True) or []
                    except Exception:
                        dup = []
                except Exception:
                    dup = []
                new_obj = dup[0] if dup else None
                if not new_obj or not cmds.objExists(new_obj):
                    continue
                try:
                    new_obj = cmds.rename(new_obj, _safe_maya_node_base(obj, "mesh") + "_boolBackup#")
                except Exception:
                    pass
                try:
                    parented = cmds.parent(new_obj, group, absolute=True) or []
                    if parented:
                        new_obj = parented[0]
                except Exception:
                    pass
                duplicated.append(new_obj)

            try:
                cmds.setAttr(group + ".visibility", 0)
            except Exception:
                pass

            if not duplicated:
                self._warning("Backup boolean : le groupe a ete cree mais aucune duplication n'a reussi.")
            if select_group and group and cmds.objExists(group):
                try:
                    cmds.select(group, r=True)
                except Exception:
                    pass
        finally:
            if undo_open:
                try:
                    cmds.undoInfo(closeChunk=True)
                except Exception:
                    pass

        try:
            if group and cmds.objExists(group):
                cmds.inViewMessage(
                    amg="Backup hidden group created: <hl>{}</hl> ({} mesh(es))".format(_short_name(group), len(duplicated)),
                    pos="midCenterTop",
                    fade=True,
                )
        except Exception:
            pass
        return group

    def _validate_current_boolean(self, backup_first=False):

        if not maya_available():
            return False
        if not self.poly_node or not cmds.objExists(self.poly_node):
            self._warning("Validate boolean : aucun polyBoolean actif.")
            return False

        target = self._validation_target_name()
        if not target or not cmds.objExists(target):
            self._warning("Validate boolean : mesh resultat introuvable.")
            return False


        inputs_to_cleanup = []
        try:
            inputs_to_cleanup = self._boolean_stack_meshes_for_backup()
        except Exception:
            inputs_to_cleanup = []

        if backup_first:
            self._duplicate_boolean_stack_to_hidden_group(select_group=False)

        target_short = _short_name(target)
        undo_open = False
        try:
            try:
                cmds.undoInfo(openChunk=True, chunkName="UiBoolean Validate Boolean")
                undo_open = True
            except Exception:
                pass

            try:
                cmds.select(target, r=True)
            except Exception:
                pass
            try:
                cmds.setAttr(target + ".visibility", 1)
            except Exception:
                pass
            try:
                _set_transform_visibility(target, True)
                _set_input_viewport_display(target, "Shaded")
            except Exception:
                pass
            try:
                cmds.makeIdentity(target, apply=True, translate=True, rotate=True, scale=True, normal=False, preserveNormals=True)
            except Exception:
                try:
                    cmds.makeIdentity(target, apply=True, t=True, r=True, s=True, n=False, pn=True)
                except Exception:
                    pass
            try:
                cmds.delete(target, constructionHistory=True)
            except Exception:
                try:
                    cmds.delete(target, ch=True)
                except Exception:
                    pass


            cleanup_seen = set()
            for obj in inputs_to_cleanup:
                try:
                    if not obj or not cmds.objExists(obj):
                        continue
                    tr = _as_transform(obj)
                    short = _short_name(tr)
                    if not short or short == target_short or short in cleanup_seen:
                        continue
                    cleanup_seen.add(short)
                    cmds.delete(tr)
                except Exception:
                    pass

            try:
                cmds.xform(target, centerPivots=True)
            except Exception:
                try:
                    cmds.xform(target, cp=True)
                except Exception:
                    if mel is not None:
                        try:
                            cmds.select(target, r=True)
                            mel.eval("CenterPivot;")
                        except Exception:
                            pass
            try:
                cmds.select(target, r=True)
            except Exception:
                pass
        finally:
            if undo_open:
                try:
                    cmds.undoInfo(closeChunk=True)
                except Exception:
                    pass


        try:
            detected = find_polybooleans_from_selection_strict()
        except Exception:
            detected = []
        if detected:
            self.poly_node = detected[0]
            self.refresh_from_scene()
        else:
            self._clear_current_boolean_state()
            try:
                if target and cmds.objExists(target):
                    cmds.select(target, r=True)
            except Exception:
                pass

        try:
            cmds.inViewMessage(
                amg="Boolean validated on result <hl>{}</hl>".format(_short_name(target)),
                pos="midCenterTop",
                fade=True,
            )
        except Exception:
            pass
        return True

