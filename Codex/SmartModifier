        except Exception:
            pass

        for obj in objects:
            if _add_single_mesh_to_existing_boolean(poly_node, obj, operation_label):
                added.append(obj)
            else:
                failed.append(obj)

    finally:
        if undo_open:
            try:
                cmds.undoInfo(closeChunk=True)
            except Exception:
                pass

    if failed:
        cmds.warning(
            "Certains meshes n'ont pas pu etre ajoutes au polyBoolean existant : {0}".format(
