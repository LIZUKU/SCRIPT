# ---------------------------------------------------------------------------
# Procedural Shell safeguard
# ---------------------------------------------------------------------------
# polyExtrudeFace is component-based. Maya can store the face selection as a
# static list at creation time, so added faces in Edit Base may not be included.
# For a modifier-stack behavior, rebuild the native stack from the editable base
# when returning to Show Result if the stack contains Shell. This preserves the
# non-destructive base/result structure while keeping Shell evaluated on the
# current mesh, not only on the old face range.

_QD_STACK_REBUILDING = False
_QD_PREV_SHOW_RES_FUNC = show_res
_QD_PREV_AUTO_BOOLEAN_TRANSFER = auto_boolean_transfer_from_live
_QD_PREV_TRANSFER_SELECTED_BOOLEAN_OUTPUTS = transfer_selected_boolean_outputs
_QD_PREV_AUTO_TRANSFER_TO_TARGETS = auto_transfer_to_targets
_QD_PREV_MS_SET_NODE_ENABLED = _ms_set_node_enabled


def _qd_stack_contains_shell(t):
    try:
        return any(_qd_is_live_shell_node(n) for n in _ms_stack_nodes(t))
    except Exception:
        return False


def _qd_base_shape_is_visible(t):
    b = base(t)
    if not b or not ex(b):
        return False
    try:
        return not bool(c.getAttr(b + ".intermediateObject"))
    except Exception:
        return False


def _qd_collect_stack_specs(t):
    specs = []
    try:
        nodes = list(_ms_stack_nodes(t))
    except Exception:
        nodes = []
    for node in nodes:
        if not ex(node):
            continue
        enabled = True
        try:
            enabled = _ms_node_enabled(node)
        except Exception:
            pass
        if _qd_is_live_shell_node(node):
            specs.append({
                "kind": "Shell",
                "enabled": bool(enabled),
                "values": _qd_shell_values_from_node(node),
            })
            continue
        try:
            if is_live_bevel_node(node):
                w, seg, frac, m, ma, cham, fp, se, he, eba, fa = bvals(node)
                specs.append({
                    "kind": "Bevel",
                    "enabled": bool(enabled),
                    "values": (w, seg, frac, m, ma, cham, fp, se, he, eba, fa, bdepth(node)),
                })
        except Exception:
            pass
    return specs


def _qd_apply_stack_specs_to_target(t, specs, show_result=True):
    global _QD_STACK_REBUILDING
    if not ex(t) or not sh(t) or not specs:
        return False
    if _QD_STACK_REBUILDING:
        return False
    _QD_STACK_REBUILDING = True
    try:
        unlock_result(t)
        old_nodes = []
        try:
            old_nodes = list(_ms_stack_nodes(t))
        except Exception:
            old_nodes = []
        for node in old_nodes:
            try: c.lockNode(node, l=False)
            except Exception: pass

        b = base(t) or vis(t)
        if not b or not ex(b):
            return False
        old_result = res(t)

        # Remove old procedural result and native modifier nodes, but keep the
        # editable base mesh intact.
        if old_result and ex(old_result) and lg(old_result) != lg(b):
            try: c.delete(old_result)
            except Exception: pass
        for node in old_nodes:
            if ex(node):
                try: c.delete(node)
                except Exception: pass

        b = ren(b, sn(t) + "_baseShape") if ex(b) else b
        for shape_node in sh(t):
            setv(shape_node, lg(shape_node) == lg(b))

        result_shape = dupshape(t, sn(t) + "_resultShape")
        if not result_shape or not ex(result_shape):
            return False
        try:
            c.connectAttr(b + ".outMesh", result_shape + ".inMesh", force=True)
        except Exception:
            pass
        setv(b, False)
        setv(result_shape, True)

        new_nodes = []
        last_bevel_values = None
        for spec in specs:
            kind = str(spec.get("kind", ""))
            enabled = bool(spec.get("enabled", True))
            if kind == "Shell":
                node = _qd_create_shell_node(t, res(t) or result_shape, spec.get("values"))
                if node:
                    _qd_force_shell_all_faces_component(node)
                    new_nodes.append(node)
            elif kind == "Bevel":
                values = _ms_normalized_bevel_values(spec.get("values"))
                w, seg, frac, m, ma, cham, fp, se, he, eba, fa, depth = values
                node = mkbev(t, res(t) or result_shape, w, seg, frac, m, ma, cham, fp, se, he, eba, fa, depth)
                last_bevel_values = values
                if node:
                    new_nodes.append(node)
            else:
                node = None
            if node and ex(node):
                try:
                    _ms_set_node_enabled(node, enabled)
                except Exception:
                    pass

        if last_bevel_values:
            try:
                mark(t, *last_bevel_values)
            except Exception:
                pass
        else:
            _qd_mark_shell_transform(t)

        for node in new_nodes:
            try:
                if is_live_bevel_node(node):
                    c.lockNode(node, l=True)
            except Exception:
                pass

        final_result = res(t) or result_shape
        for shape_node in sh(t):
            setv(shape_node, lg(shape_node) == lg(final_result) if show_result else lg(shape_node) == lg(b))
        if show_result and final_result:
            try:
                protect_result(t, True)
            except Exception:
                pass
        try:
            c.dgdirty(t)
            if final_result:
                c.dgdirty(final_result)
            c.setAttr(t + ".visibility", 1)
            c.hilite(t, r=True)
            c.select(t, r=True)
            c.refresh(force=True)
        except Exception:
            pass
        return True
    finally:
        _QD_STACK_REBUILDING = False


def _qd_rebuild_shell_stack_from_base_if_needed(t):
    if not ex(t) or not tag(t):
        return False
    if not _qd_stack_contains_shell(t):
        return False
    # Only rebuild automatically when the user is coming back from Edit Base.
    # While result is already shown, native node attributes can update normally.
    if not _qd_base_shape_is_visible(t):
        try:
            for node in _ms_stack_nodes(t):
                if _qd_is_live_shell_node(node):
                    _qd_force_shell_all_faces_component(node)
        except Exception:
            pass
        return False
    specs = _qd_collect_stack_specs(t)
    if not specs:
        return False
    return _qd_apply_stack_specs_to_target(t, specs, show_result=True)


def show_res(t):
    try:
        if auto_boolean_transfer_from_live(t):
            return
    except Exception:
        pass
    if _qd_rebuild_shell_stack_from_base_if_needed(t):
        return
    try:
        for node in _ms_stack_nodes(t):
            if _qd_is_live_shell_node(node):
                _qd_force_shell_all_faces_component(node)
    except Exception:
        pass
    return _QD_PREV_SHOW_RES_FUNC(t)


def _qd_apply_source_stack_to_targets(src, targets, hide_source=False):
    if not src or not ex(src):
        return []
    specs = _qd_collect_stack_specs(src)
    if not specs:
        return []
    done = []
    for tgt in targets or []:
        if not tgt or not ex(tgt) or not sh(tgt) or lg(tgt) == lg(src):
            continue
        if _qd_apply_stack_specs_to_target(tgt, specs, show_result=True):
            done.append(tgt)
    if done and hide_source:
        try:
            strip_live_source(src, hide=True)
        except Exception:
            pass
    return done


def auto_boolean_transfer_from_live(t):
    # Preserve the old proven bevel path unless the source stack contains Shell.
    if not _qd_stack_contains_shell(t):
        return _QD_PREV_AUTO_BOOLEAN_TRANSFER(t)
    tgts = []
    try:
        tgts = bool_result_targets(t)
    except Exception:
        tgts = []
    if not tgts:
        return 0
    target = None
    for candidate in tgts:
        if candidate and ex(candidate) and not tag(candidate):
            target = candidate
            break
    if not target and tgts:
        target = tgts[0]
    if not target or not ex(target) or lg(target) == lg(t):
        return 0
    try:
        c.undoInfo(openChunk=True, chunkName="Transfer Shell Modifier Stack To Boolean Result")
    except Exception:
        pass
    try:
        done = _qd_apply_source_stack_to_targets(t, [target], hide_source=True)
        if done:
            try: c.select(done[-1], replace=True)
            except Exception: pass
            return 1
    finally:
        try:
            c.undoInfo(closeChunk=True)
        except Exception:
            pass
    return 0


def transfer_selected_boolean_outputs(targets):
    pairs = []
    for target in targets or []:
        src = boolean_source_for_target(target)
        if src and lg(src) != lg(target):
            pairs.append((src, target))
    shell_pairs = [(src, target) for src, target in pairs if _qd_stack_contains_shell(src)]
    if not shell_pairs:
        return _QD_PREV_TRANSFER_SELECTED_BOOLEAN_OUTPUTS(targets)
    done = []
    try:
        c.undoInfo(openChunk=True, chunkName="Transfer Shell Modifier Stack To Selected Boolean Outputs")
    except Exception:
        pass
    try:
        for src, target in shell_pairs:
            applied = _qd_apply_source_stack_to_targets(src, [target], hide_source=True)
            done.extend(applied)
        if done:
            try: c.select(done, replace=True)
            except Exception: pass
            return len(done)
    finally:
        try:
            c.undoInfo(closeChunk=True)
        except Exception:
            pass
    return 0


def auto_transfer_to_targets(targets=None):
    targets = targets or [t for t in sel() if not tag(t)]
    targets = [t for t in targets if ex(t) and sh(t) and not tag(t)]
    if not targets:
        return 0
    src = auto_source_for(targets)
    if src and _qd_stack_contains_shell(src):
        try:
            c.undoInfo(openChunk=True, chunkName="Transfer Shell Modifier Stack To Targets")
        except Exception:
            pass
        try:
            done = _qd_apply_source_stack_to_targets(src, targets, hide_source=False)
            if done:
                try: c.select(done, replace=True)
                except Exception: pass
                return len(done)
        finally:
            try:
                c.undoInfo(closeChunk=True)
            except Exception:
                pass
        return 0
    return _QD_PREV_AUTO_TRANSFER_TO_TARGETS(targets)


def _ms_set_node_enabled(n, on=True):
    # Bevel nodes were safe to lock in the original stack. Shell/polyExtrudeFace
    # nodes are left unlocked because Maya can become unstable while evaluating
    # or editing locked extrude nodes.
    if _qd_is_live_shell_node(n):
        try:
            c.lockNode(n, l=False)
        except Exception:
            pass
        try:
            if c.attributeQuery("nodeState", n=n, ex=True):
                c.setAttr(n + ".nodeState", 0 if on else 1)
        except Exception:
            pass
        try:
            c.refresh(force=True)
        except Exception:
            pass
        return
    return _QD_PREV_MS_SET_NODE_ENABLED(n, on)

