        row_count = max(1, len(self.input_names))
        row_h = self._scaled(32)
        min_for_rows = self._compact_input_list_height()


        result_h = self.result_bar_frame.height() or 34
        settings_h = self.settings_shell.height() or (self._settings_open_height if self.settings_header.isChecked() else self._settings_closed_height)
        spacing = self._scaled_gap(6, 4, 9)
        content_h = self.content_container.height()
        if content_h <= 0:
            content_h = result_h + min_for_rows + settings_h + spacing

        wanted = max(min_for_rows, content_h - result_h - settings_h - spacing)
        wanted = max(wanted, row_count * row_h + 2)
        self._set_input_list_fixed_height(wanted)

