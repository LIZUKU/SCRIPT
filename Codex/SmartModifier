def _polyboolean_input_count_hint(poly_node, idx=0):

    count = int(idx) + 1
    try:
        count = max(count, len(find_input_transforms(poly_node) or []))
    except Exception:
        pass

    for attr in ("operation", "op", "elementEnabled", "ee"):
        try:
            values = _int32_array_get(poly_node, attr)
            if values:
                count = max(count, len(values))
        except Exception:
            pass
    return max(1, count)


