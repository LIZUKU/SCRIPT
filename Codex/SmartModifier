            self.updateGeometry()
            hint = self.sizeHint()


            target_compact_w = self._target_dialog_width_for_scale()
            hint_w = hint.width() if hint.width() > 0 else target_compact_w


            w = max(self._closed_minimum_size.width(), target_compact_w, min(target_compact_w, hint_w))
            h = max(self.minimumHeight(), hint.height() if hint.height() > 0 else 178)
            try:
