    except Exception:
        pass

    if mel is not None:
        try:
            mel.eval('setAttr "{0}" -type Int32Array {1};'.format(
                _maya_name_for_cmd(plug),
                " ".join(str(int(v)) for v in payload),
            ))
            return True
        except Exception:
            pass
    return False


