def _ms_target_from_selection():
    ts = sel()
    if not ts:
        return None
    for t in ts:
        try:
            if tag(t):
                return t
        except Exception:
            pass
    return ts[0]

def _ms_live_targets():
    out = []
    for t in c.ls(type='transform', l=1) or []:
        try:
            if tag(t) and sh(t):
                out.append(lg(t))
        except Exception:
            pass
    return out

def _ms_stack_nodes(t):
    if not ex(t):
        return []
    out = []
    search = []
    rr = res(t)
    if rr: search.append(rr)
    for s in sh(t):
        if s not in search:
            search.append(s)
    for s in search:
        for n in hist(s):
            if ex(n) and is_live_bevel_node(n):
                ln = lg(n)
                if ln not in out:
                    out.append(ln)
    return out

def _ms_node_enabled(n):
    if not ex(n):
        return True
    try:
        if c.attributeQuery("nodeState", n=n, ex=1):
            return int(c.getAttr(n + ".nodeState")) == 0
    except Exception:
        pass
    return True

def _ms_set_node_enabled(n, on=True):
    if not ex(n):
        return
    try: c.lockNode(n, l=0)
    except Exception: pass
    try:
        if c.attributeQuery("nodeState", n=n, ex=1):
            c.setAttr(n + ".nodeState", 0 if on else 1)
    except Exception:
        pass
    try: c.lockNode(n, l=1)
    except Exception: pass
    try: c.refresh(f=1)
    except Exception: pass

def _ms_delete_node(n):
    if not ex(n):
        return
    try: c.lockNode(n, l=0)
    except Exception: pass
    try: c.delete(n)
    except Exception: pass

def _ms_open_node_keep_mesh(t, n):
    if not ex(n):
        return
    node = lg(n) or n
    safe_node = _maya_name_for_cmd(node)
    try:
        # showEditorExact can throw Maya showEditor.mel "Value is out of range"
        # on some AE tabs after repeated UI reloads. Use the safer native AE open
        # flow instead, then restore the mesh selection.
        c.select(node, r=1)
        if mel is not None:
            try: mel.eval('AttributeEditor;')
            except Exception: pass
            try: mel.eval('updateAE "{0}";'.format(safe_node))
            except Exception: pass
    except Exception:
        pass
    if ex(t):
        target = lg(t) or t
        def _restore_target_selection():
            try:
                if ex(target):
                    c.select(target, r=1)
            except Exception:
                pass
        try:
            if QtCore is not None:
                QtCore.QTimer.singleShot(80, _restore_target_selection)
            else:
                c.evalDeferred(_restore_target_selection)
        except Exception:
            try: c.select(target, r=1)
            except Exception: pass

def _ms_cancel_stack(t):
    if not ex(t) or not tag(t):
        return
    unlock_result(t)
    b = base(t) or vis(t)
    rr = res(t)
    nodes = _ms_stack_nodes(t)
    for n in nodes:
        try: c.lockNode(n, l=0)
        except Exception: pass
    if b:
        setv(b, 1)
    if rr and b and lg(rr) != lg(b):
        try: c.delete(rr)
        except Exception: pass
    for n in nodes:
        if ex(n):
            try: c.delete(n)
            except Exception: pass
    if b and ex(b):
        try: b = ren(b, sn(t) + "Shape")
        except Exception: pass
        setv(b, 1)
    clean(t)
    try:
        c.setAttr(t + ".visibility", 1)
        c.select(t, r=1)
        c.refresh(f=1)
    except Exception:
        pass

def _ms_normalized_bevel_values(values):
    """Return the full bevel settings tuple used by setbev/mark/create.

    Older UI passes used 11 values and did not expose depth. The Modifier Stack
    UI now exposes Depth as well, so this helper keeps both cases safe.
    """
    try:
        data = list(values or [])
    except Exception:
        data = []
    defaults = [0.05, 2, False, 0, 0, True, False, True, True, True, 30.0, 1.0]
    while len(data) < len(defaults):
        data.append(defaults[len(data)])
    data = data[:len(defaults)]
    return (
        float(data[0]),
        int(data[1]),
        bool(data[2]),
        int(data[3]),
        int(data[4]),
        bool(data[5]),
        bool(data[6]),
        bool(data[7]),
        bool(data[8]),
        bool(data[9]),
        float(data[10]),
        float(data[11]),
    )


def _ms_add_bevel(t, values):
    if not ex(t):
        return None
    w, seg, frac, m, ma, cham, fp, se, he, eba, fa, depth = _ms_normalized_bevel_values(values)

    if not tag(t) or not live(t):
        try: c.select(t, r=1)
        except Exception: pass
        create(w, seg, frac, m, ma, cham, fp, se, he, eba, fa, depth)
        nodes = _ms_stack_nodes(t)
        return nodes[-1] if nodes else None

    unlock_result(t)
    show_res(t)
    unlock_result(t)
    rr = res(t)
    if not rr:
        return None
    n = mkbev(t, rr, w, seg, frac, m, ma, cham, fp, se, he, eba, fa, depth)
    mark(t, w, seg, frac, m, ma, cham, fp, se, he, eba, fa, depth)
    show_res(t)
    try: c.select(t, r=1)
    except Exception: pass
    return n

def _ms_label_for_node(n):
    if not ex(n):
        return "Missing"
    typ = c.nodeType(n)
    if typ in ("polyBevel3", "polyBevel"):
        return "Bevel"
    return typ

