    def _clamp_target_height_without_moving(self, target_h):

        try:
            screen = self.screen() or QtWidgets.QApplication.primaryScreen()
            if not screen:
                return int(target_h)
            avail = screen.availableGeometry()
            geo = self.geometry()
            max_h_from_current_y = max(self.minimumHeight(), avail.bottom() - geo.y() - 10)
            return int(min(target_h, max_h_from_current_y))
        except Exception:
            return int(target_h)

    def _settings_window_delta_for_toggle(self, opening, shell_delta_h):

        try:
            current_list_h = int(self.list_frame.height() or getattr(self, "_last_list_height", 0) or self._compact_input_list_height())
            min_list_h = int(self._compact_input_list_height())
        except Exception:
            current_list_h = 0
            min_list_h = 0

        if opening:
            needed = max(0, int(shell_delta_h))
            spare = max(0, current_list_h - min_list_h)
            consume_from_list = min(needed, spare)
            if consume_from_list > 0:
                try:
                    self._set_input_list_fixed_height(current_list_h - consume_from_list)
                except Exception:
                    pass
            grow = max(0, needed - consume_from_list)
            self._last_settings_auto_grow = grow
            return grow

        shrink_available = max(0, int(getattr(self, "_last_settings_auto_grow", 0)))
        shrink = min(max(0, -int(shell_delta_h)), shrink_available)
        self._last_settings_auto_grow = 0
        return -shrink

    def _animate_settings_toggle(self, opening):
        self._stop_settings_animation()

        opening = bool(opening)
        current_shell_h = self.settings_shell.height() or (
            self._settings_closed_height if opening else self._settings_open_height
        )
        target_shell_h = self._settings_open_height if opening else self._settings_closed_height
        delta_h = int(target_shell_h - current_shell_h)

        start_geo = QtCore.QRect(self.geometry())


        if opening:
            self.settings_body.setVisible(True)
            self.setMinimumSize(self._closed_minimum_size)
        else:


            self.setMinimumSize(self._closed_minimum_size)
            self.settings_body.setVisible(True)

        window_delta_h = self._settings_window_delta_for_toggle(opening, delta_h)
        target_h = start_geo.height() + window_delta_h
        target_h = max(target_h, self._closed_minimum_size.height())
        if opening and window_delta_h > 0:
            target_h = max(target_h, min(self._open_minimum_size.height(), start_geo.height() + int(delta_h)))
        target_h = self._clamp_target_height_without_moving(target_h)

        target_geo = QtCore.QRect(start_geo.x(), start_geo.y(), start_geo.width(), int(target_h))


        if abs(target_shell_h - current_shell_h) <= 1 and abs(target_geo.height() - start_geo.height()) <= 1:
            self.settings_shell.setFixedHeight(target_shell_h)
            self.settings_body.setVisible(opening)
            self.setMinimumSize(self._open_minimum_size if opening else self._closed_minimum_size)
            self._queue_layout_rebalance()
            return

        self._settings_animating = True


        shell_anim = QtCore.QVariantAnimation(self)
        shell_anim.setStartValue(int(current_shell_h))
        shell_anim.setEndValue(int(target_shell_h))
        shell_anim.setDuration(180)
        shell_anim.setEasingCurve(self._settings_easing_curve())

        def _apply_shell_height(value):
            try:
                self.settings_shell.setFixedHeight(int(value))
                self.settings_shell.updateGeometry()
            except Exception:
                pass

        shell_anim.valueChanged.connect(_apply_shell_height)


        geo_anim = QtCore.QPropertyAnimation(self, b"geometry", self)
        geo_anim.setStartValue(start_geo)
        geo_anim.setEndValue(target_geo)
        geo_anim.setDuration(180)
        geo_anim.setEasingCurve(self._settings_easing_curve())

        group = QtCore.QParallelAnimationGroup(self)
        group.addAnimation(shell_anim)
        group.addAnimation(geo_anim)

        def _finish():
            try:
                self.settings_shell.setFixedHeight(target_shell_h)
                self.settings_body.setVisible(opening)
                self.setMinimumSize(self._open_minimum_size if opening else self._closed_minimum_size)
                self._settings_animating = False
                self._settings_anim_group = None
                self._settings_shell_anim = None
                self._queue_layout_rebalance()
            except Exception:
                self._settings_animating = False

        group.finished.connect(_finish)

        self._settings_shell_anim = shell_anim
        self._settings_anim_group = group
        group.start()

    def _fit_window_to_settings_state(self, opening=False, height_delta=0):

        try:
            self.layout().activate()
            self.content_container.updateGeometry()
            self.updateGeometry()

            shell_delta = int(height_delta)
            if not shell_delta:
                shell_delta = self._settings_body_open_height if opening else -self._settings_body_open_height
            window_delta = self._settings_window_delta_for_toggle(bool(opening), shell_delta)

            target_h = max(self._closed_minimum_size.height(), self.height() + int(window_delta))
            target_w = max(self.width(), self.minimumWidth())

            screen = self.screen() or QtWidgets.QApplication.primaryScreen()
            if screen:
                avail = screen.availableGeometry()
                target_h = min(target_h, max(self._closed_minimum_size.height(), avail.height() - 40))
                target_w = min(target_w, max(self.minimumWidth(), avail.width() - 40))

            self.resize(target_w, int(target_h))
            self._queue_layout_rebalance()
            _clamp_dialog_to_screen(self)
        except Exception:
            pass

