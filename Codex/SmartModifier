    def _update_input_list_height(self):
        try:
            row_count = max(1, len(self.input_names))
            row_h = self._scaled(32)
            min_for_rows = self._compact_input_list_height()
            result_h = self.result_bar_frame.height() or self._scaled_floor(55, 50)
            settings_h = self.settings_shell.height() or (self._settings_open_height if self.settings_header.isChecked() else self._settings_closed_height)
            footer_h = 0
            try:
                if getattr(self, "status_label", None) is not None and self.status_label.isVisible():
                    footer_h = self.status_label.height() or self._scaled_floor(20, 18)
            except Exception:
                footer_h = self._scaled_floor(20, 18)
            spacing = self._scaled_gap(6, 4, 9)
            content_h = self.content_container.height()
            if content_h <= 0:
                content_h = result_h + min_for_rows + settings_h + footer_h + spacing
            wanted = max(min_for_rows, content_h - result_h - settings_h - footer_h - (spacing * 2))
            wanted = max(wanted, row_count * row_h + 2)
            self._set_input_list_fixed_height(wanted)
        except Exception:
            try:
                pass
            except Exception:
                pass

    def refresh_from_scene(self):
        self._building = True
        try:
            if not self.target or not ex(self.target):
                self.target = _ms_target_from_selection()
            self.poly_node = self.target
            self.result_transform = self.target or ""
            self.input_names = _ms_stack_nodes(self.target) if self.target and ex(self.target) else []
            try:
                self.setWindowTitle("Modifier Stack")
            except Exception:
                pass
            self._sync_boolean_tabs_to_current()
            self._rebuild_input_rows()
            self._load_current_modifier_settings()

            has_target = bool(self.target and ex(self.target))
            for ctl in (self.add_selected_btn, getattr(self, "add_shell_btn", None), getattr(self, "edit_base_btn", None), self.hide_cutters_btn, self.remove_selected_btn, self.validate_boolean_btn):
                try: ctl.setEnabled(has_target)
                except Exception: pass
        finally:
            self._building = False
            try:
                self._refresh_mode_button_state()
            except Exception:
                pass
            self._sync_selection_from_maya()

    def _clear_current_boolean_state(self):
