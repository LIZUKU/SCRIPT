class ModifierStackExactUI(PolyBooleanCustomUI):

    # The base PolyBoolean UI wires these handlers while building the shared
    # controls. In the Modifier Stack adapter the same widgets are repurposed
    # for Bevel settings (Modifier Type / Miter / Miter Along). Keep these
    # overrides so Qt signal emissions never try to push Bevel labels such as
    # "Bevel", "Auto", "Patch" or "Center" into a polyBoolean node.
    def _on_interactive_changed(self, *_):
        try:
            return self._on_modifier_enabled_changed()
        except Exception:
            return None

    def _on_operation_for_new_inputs_changed(self, *_):
        try:
            return self._apply_settings_from_ui()
        except Exception:
            return None

    def _on_input_object_display_changed(self, *_):
        try:
            return self._apply_settings_from_ui()
        except Exception:
            return None

    def _on_geometry_mode_changed(self, *_):
        try:
            return self._apply_settings_from_ui()
        except Exception:
            return None

    def _on_intersection_classification_changed(self, checked=False):
        try:
            if checked:
                return self._apply_settings_from_ui()
        except Exception:
            return None

    def __init__(self, target=None, parent=None):
        self.target = target or _ms_target_from_selection()
        self.current_node = None
        PolyBooleanCustomUI.__init__(self, poly_node=None, parent=parent)

        self.setObjectName(WINDOW_OBJECT_NAME)
        self.setWindowTitle("Modifier Stack")
        try:
            self._fit_window_to_compact_default()
        except Exception:
            pass



    def _fit_modifier_collapsed_height(self):
        try:
            old_pos = self.pos()
        except Exception:
            old_pos = None
        try:
            locked_w = int(getattr(self, "_modifier_settings_toggle_locked_width", 0) or self.width())
        except Exception:
            locked_w = None
        try:
            self._set_input_list_fixed_height(self._compact_input_list_height())
        except Exception:
            pass
        try:
            if not self.settings_header.isChecked():
                self.settings_body.setVisible(False)
                self.settings_shell.setFixedHeight(self._settings_closed_height)
                self.setMinimumSize(self._closed_minimum_size)
        except Exception:
            pass
        try:
            if getattr(self, "status_label", None) is not None and not self.status_label.isVisible():
                self.status_label.setFixedHeight(0)
        except Exception:
            pass
        try:
            self.content_container.layout().activate()
            self.content_layout.activate()
            self.updateGeometry()
            hint_h = self.sizeHint().height()
            target_h = max(self._closed_minimum_size.height(), int(hint_h))
            self._apply_modifier_width_cap(force_resize=False)
            target_w = int(locked_w if locked_w else self.width())
            self._resize_modifier_keep_pos(int(target_w), int(target_h))
            if old_pos is not None:
                self.move(old_pos)
            self._queue_layout_rebalance()
        except Exception:
            pass

    def _fit_modifier_open_height(self):
        try:
            old_pos = self.pos()
        except Exception:
            old_pos = None
        try:
            locked_w = int(getattr(self, "_modifier_settings_toggle_locked_width", 0) or self.width())
        except Exception:
            locked_w = None
        try:
            self._refresh_modifier_settings_body_height()
        except Exception:
            pass
        try:
            self.settings_body.setVisible(True)
            self.settings_shell.setFixedHeight(self._settings_open_height)
            self.setMinimumSize(self._open_minimum_size)
        except Exception:
            pass
        try:
            self.content_container.layout().activate()
            self.content_layout.activate()
            self.updateGeometry()
            self._apply_modifier_width_cap(force_resize=False)
            target_w = int(locked_w if locked_w else self.width())
            target_h = max(self._open_minimum_size.height(), int(self.sizeHint().height()))
            self._resize_modifier_keep_pos(int(target_w), int(target_h))
            if old_pos is not None:
                self.move(old_pos)
            self._queue_layout_rebalance()
        except Exception:
            pass

    def _on_settings_header_toggled(self, checked):
        try:
            old_pos = self.pos()
        except Exception:
            old_pos = None
        try:
            locked_w = int(self.width())
        except Exception:
            locked_w = None
        try:
            self._modifier_settings_toggle_locked_width = locked_w
        except Exception:
            pass
        try:
            self._stop_settings_animation()
        except Exception:
            pass
        try:
            if checked:
                self._fit_modifier_open_height()
            else:
                self._fit_modifier_collapsed_height()
            if locked_w:
                self.resize(int(locked_w), int(self.height()))
            if old_pos is not None:
                self.move(old_pos)
        except Exception:
            try:
                self.settings_body.setVisible(bool(checked))
                self.settings_shell.setFixedHeight(self._settings_open_height if checked else self._settings_closed_height)
                self.setMinimumSize(self._open_minimum_size if checked else self._closed_minimum_size)
                if locked_w:
                    self.resize(int(locked_w), int(self.height()))
                if old_pos is not None:
                    self.move(old_pos)
            except Exception:
                pass
        finally:
            try:
                self._modifier_settings_toggle_locked_width = None
            except Exception:
                pass


    def _modifier_header_button_metrics(self):
        """Responsive header metrics for the Modifier Stack adapter.

        The parent Boolean UI is intentionally fixed/compact, but the modifier
        adapter has text buttons (Show Result / Cancel / Bake). These values keep
        the native Maya look while preventing cropped labels when the window or UI
        scale changes.
        """
        row_h = self._scaled_floor(24, 22)
        gap = self._scaled_gap(4, 3, 8)
        return {
            "row_h": row_h,
            "gap": gap,
            "auto_w": self._scaled_w_floor(78, 88),
            "stacks_w": self._scaled_w_floor(62, 58),
            "lock_w": self._scaled_w_floor(34, 32),
            "tab_min_w": self._scaled_w_floor(116, 104),
            "scale_w": self._scaled_w_floor(48, 54),
            "add_w": self._scaled_w_floor(78, 72),
            "shell_w": self._scaled_w_floor(72, 68),
            "edit_w": self._scaled_w_floor(78, 74),
            "show_min_w": self._scaled_w_floor(80, 74),
            "cancel_w": self._scaled_w_floor(74, 72),
            "bake_w": self._scaled_w_floor(58, 56),
        }

    def _header_required_width_for_scale(self):
        try:
            m = self._modifier_header_button_metrics()
            margin_x = self._scaled_w_floor(8, 6) * 2
            extra = int(getattr(self, "_header_min_extra_padding", 18))
            # Modifier Stack top row is: Auto Detect / Stacks / Lock / 100%.
            # Do not reserve the old Boolean tabbar width when the settings are folded.
            top_row_w = (
                m["auto_w"] + m["stacks_w"] + m.get("lock_w", self._scaled_w_floor(34, 32)) + m["scale_w"] +
                (3 * m["gap"]) + margin_x + extra
            )
            modifier_row_w = (m["add_w"] + m.get("shell_w", 0) + m["gap"] + margin_x + extra)
            action_row_w = (m["show_min_w"] + m["cancel_w"] + m["bake_w"] + (2 * m["gap"]) + margin_x + extra)
            return max(getattr(self, "_min_readable_dialog_width", 352), top_row_w, modifier_row_w, action_row_w)
        except Exception:
            return max(276, getattr(self, "_min_readable_dialog_width", 276))

    def _target_dialog_width_for_scale(self):
        try:
            return self._modifier_compact_dialog_width()
        except Exception:
            return getattr(self, "_min_readable_dialog_width", 360)

    def _modifier_compact_dialog_width(self):
        """Hard cap the Modifier Stack window to the useful UI width.

        The Modifier Stack does not need the large empty right area inherited from
        the Boolean template. Keep the width just large enough for the header,
        the Bevel row controls, and the compact Modifier Settings controls.
        """
        try:
            header_w = self._header_required_width_for_scale()
        except Exception:
            header_w = 0
        try:
            useful_w = int(self._modifier_panel_width() + self._scaled_w_floor(24, 20))
        except Exception:
            useful_w = 352
        try:
            min_w = int(getattr(self, "_min_readable_dialog_width", useful_w))
        except Exception:
            min_w = useful_w
        return int(max(min_w, header_w, useful_w))

    def _resize_modifier_keep_pos(self, width=None, height=None):
        """Resize the Modifier Stack dialog without changing its top-left position."""
        try:
            old_pos = self.pos()
        except Exception:
            old_pos = None
        try:
            if width is None:
                width = self._modifier_compact_dialog_width()
            if height is None:
                height = self.height()
            self.resize(int(width), int(height))
            if old_pos is not None:
                self.move(old_pos)
            return int(width)
        except Exception:
            return None

    def _modifier_panel_width(self):
        """Width used by the modifier list/settings panels, not by the window itself."""
        try:
            m = self._modifier_header_button_metrics()
            gap = int(m.get("gap", self._scaled_gap(4, 3, 8)))
            inner = self._scaled_w_floor(12, 12)
            top_row_w = int(m["auto_w"] + m["stacks_w"] + m.get("lock_w", self._scaled_w_floor(34, 32)) + m["scale_w"] + (3 * gap) + inner)
            action_row_w = int(m["show_min_w"] + m["cancel_w"] + m["bake_w"] + (2 * gap) + inner)
            min_row_w = self._scaled_w_floor(270, 330)
            return int(max(min_row_w, top_row_w, action_row_w))
        except Exception:
            return 326

    def _apply_modifier_panel_widths(self):
        """Keep a compact default width, but let the user freely resize the dialog.

        v28 locked every panel to a fixed width. That removed the dead right strip,
        but it also killed the useful wide drop/list area when the window was
        manually resized. This version uses the compact width only as a minimum.
        """
        try:
            w = int(self._modifier_panel_width())
            max_w = 16777215
            expanding_horizontal = QtWidgets.QSizePolicy.Expanding
            fixed_vertical = QtWidgets.QSizePolicy.Fixed
            expanding_vertical = QtWidgets.QSizePolicy.Expanding

            expanding_widgets = [
                getattr(self, "content_container", None),
                getattr(self, "list_frame", None),
                getattr(self, "scroll", None),
                getattr(self, "scroll_content", None),
            ]
            fixed_height_widgets = [
                getattr(self, "result_bar_frame", None),
                getattr(self, "settings_shell", None),
                getattr(self, "settings_header", None),
                getattr(self, "settings_body", None),
            ]

            for widget in expanding_widgets:
                if widget is None:
                    continue
                try:
                    widget.setMinimumWidth(w)
                    widget.setMaximumWidth(max_w)
                    widget.setSizePolicy(expanding_horizontal, expanding_vertical)
                except Exception:
                    pass

            for widget in fixed_height_widgets:
                if widget is None:
                    continue
                try:
                    widget.setMinimumWidth(w)
                    widget.setMaximumWidth(max_w)
                    widget.setSizePolicy(expanding_horizontal, fixed_vertical)
                except Exception:
                    pass

            try:
                if getattr(self, "scroll", None) is not None:
                    self.scroll.setWidgetResizable(True)
            except Exception:
                pass

            try:
                if getattr(self, "content_layout", None) is not None:
                    self.content_layout.setStretchFactor(self.result_bar_frame, 0)
                    self.content_layout.setStretchFactor(self.list_frame, 1)
                    self.content_layout.setStretchFactor(self.settings_shell, 0)
            except Exception:
                pass

            return w
        except Exception:
            return None

    def _apply_modifier_width_cap(self, force_resize=False):
        """Use the compact width as default/minimum, without changing width on settings fold/unfold."""
        try:
            panel_w = self._apply_modifier_panel_widths() or self._modifier_panel_width()
            target_w = int(max(self._header_required_width_for_scale(), panel_w + self._scaled_w_floor(22, 18)))
            locked_w = getattr(self, "_modifier_settings_toggle_locked_width", None)
            if locked_w:
                try:
                    target_w = min(int(target_w), int(locked_w))
                except Exception:
                    pass
            max_w = 16777215
            self.setMinimumWidth(target_w)
            self.setMaximumWidth(max_w)
            try:
                self.setSizeGripEnabled(True)
            except Exception:
                pass
            try:
                self.setSizePolicy(QtWidgets.QSizePolicy.Expanding, QtWidgets.QSizePolicy.Expanding)
            except Exception:
                pass

            if force_resize:
                self._resize_modifier_keep_pos(target_w, int(self.height()))
            return target_w
        except Exception:
            return None

