def _input_child_plug_candidates(poly_node, idx, key):

    plugs = []
    if not maya_available() or not poly_node or not cmds.objExists(poly_node):
        return plugs
    try:
        idx = int(idx)
    except Exception:
        return plugs

    wanted_by_key = {
        "operation": ["operation", "booloperation", "booleanoperation", "operationtype", "inputoperation", "op"],
        "display": ["display", "displaymode", "inputdisplay", "inputdisplaymode", "drawmode", "visibilitymode"],
        "active": ["elementenabled", "elementenabledstate", "enabled", "enable", "active", "isactive", "state"],
    }
    wanted = wanted_by_key.get(key, [])
    if not wanted:
        return plugs

    try:
        attrs = cmds.listAttr(poly_node, multi=True) or []
    except Exception:
        attrs = []
    try:
        attrs.extend(cmds.listAttr(poly_node) or [])
    except Exception:
        pass

    seen = set()
    for attr in attrs:
        attr = str(attr)
        if "[{}]".format(idx) not in attr:
            continue

        leaf = attr.split(".")[-1]
        norm = _normalize_attr_name(leaf)
        if not any(w == norm or w in norm or norm in w for w in wanted):
            continue
        plug = poly_node + "." + attr
        if plug in seen:
            continue
        seen.add(plug)
        if _plug_exists(plug):
            plugs.append(plug)
    return plugs


def _value_for_input_plug_label(poly_node, plug, key, label, ui_labels):

    if key == "operation":
        return int(_polyboolean_cmd_operation_value(label))
    if key == "display":
        return int(_polyboolean_cmd_display_value(label))
    attr_for_enum = plug.split(".", 1)[1]
    child_attr = attr_for_enum.split(".")[-1]
    root_attr = attr_for_enum.split("[")[0]
    for attr in (child_attr, root_attr):
        try:
            return _label_to_index_with_enum(poly_node, attr, label, ui_labels)
        except Exception:
            pass
    try:
        return int(ui_labels.index(label))
    except Exception:
        return 0


