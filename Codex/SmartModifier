            base_percent = float(getattr(self, "_ui_scale_base_percent", 100))
            return user_percent * base_percent / 100.0
        except Exception:
            return 100.0

    def _scaled(self, value):

        try:
            return max(1, int(round(float(value) * self._effective_ui_scale_percent() / 100.0)))
        except Exception:
            return int(value)

    def _scaled_floor(self, value, minimum):

        try:
            return max(int(minimum), self._scaled(value))
        except Exception:
            return int(max(value, minimum))

    def _effective_ui_width_scale_percent(self):

        try:
            user_percent = float(getattr(self, "_ui_scale_percent", 100))
            base_percent = float(getattr(self, "_ui_scale_base_percent", 100))


            softened_user = 100.0 + ((user_percent - 100.0) * 0.55)
            return max(80.0, base_percent * softened_user / 100.0)
        except Exception:
            return self._effective_ui_scale_percent()

    def _scaled_w(self, value):

        try:
            return max(1, int(round(float(value) * self._effective_ui_width_scale_percent() / 100.0)))
        except Exception:
            return int(value)

    def _scaled_w_floor(self, value, minimum):
        try:
            return max(int(minimum), self._scaled_w(value))
        except Exception:
            return int(max(value, minimum))

    def _scaled_gap(self, value, minimum=2, maximum=8):

        try:
            return max(int(minimum), min(int(maximum), self._scaled_w(value)))
        except Exception:
            return int(value)

    def _header_required_width_for_scale(self):

        try:
            row_h = self._scaled_floor(22, 20)
            arrow_w = max(self._scaled_w_floor(20, 22), min(row_h, 30))
            auto_w = self._scaled_w_floor(78, 88)
            list_w = self._scaled_w_floor(54, 62)
            tab_w = self._scaled_w_floor(88, 96)
            scale_w = self._scaled_w_floor(48, 54)
            gap = self._scaled_gap(4, 4, 7)
            margin_x = self._scaled_w_floor(6, 6) * 2
            extra = int(getattr(self, "_header_min_extra_padding", 18))

            has_tabs = bool(getattr(self, "_boolean_nav_has_tabs", False))
            arrows_visible = bool(getattr(self, "_boolean_nav_arrows_visible", False))
            try:
                if getattr(self, "boolean_tabbar", None) is not None:
                    count = self.boolean_tabbar.count()
                    has_tabs = count > 0
                    arrows_visible = count > 1
            except Exception:
                pass

            if arrows_visible:
                widths = [auto_w, list_w, arrow_w, tab_w, arrow_w, scale_w]
            elif has_tabs:
                widths = [auto_w, list_w, tab_w, scale_w]
            else:
                widths = [auto_w, list_w, scale_w]

            gaps = max(0, len(widths) - 1) * gap
            nav_w = sum(widths) + gaps + margin_x + extra


            add_w = self._scaled_w_floor(136, 142)
            hide_w = self._scaled_w_floor(96, 104)
            trash_w = max(self._scaled_w_floor(24, 26), min(row_h + 4, 36))
            validate_w = trash_w
            add_row_w = add_w + hide_w + trash_w + validate_w + (3 * gap) + margin_x + extra
            return max(nav_w, add_row_w)
        except Exception:
            return getattr(self, "_min_readable_dialog_width", 320)

    def _target_dialog_width_for_scale(self):
        try:
            return max(
                getattr(self, "_min_readable_dialog_width", 320),
                self._scaled_w(getattr(self, "_base_dialog_width", 365)),
                self._header_required_width_for_scale(),
            )
        except Exception:
            return getattr(self, "_min_readable_dialog_width", 320)

    def _on_ui_scale_changed(self, text):
