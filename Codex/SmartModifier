def _element_enabled_index_for_input_row(poly_node, row_index, input_names=None):

    try:
        row_index = int(row_index)
    except Exception:
        return None, 0
    if row_index < 0:
        return None, 0

    row_count = _polyboolean_row_count_hint(poly_node, input_names=input_names)


    if row_index == 0 and row_count > 1:
        return None, max(0, row_count - 1)

    if row_count > 1:
        return max(0, row_index - 1), max(1, row_count - 1)


    return row_index, max(1, row_index + 1)


