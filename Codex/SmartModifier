    def _on_boolean_tab_rename_requested(self, index):
        node = self._node_from_boolean_tab_index(index)
        if not self._is_valid_poly_node(node):
            self._warning("Impossible de renommer : node polyBoolean invalide ou supprime.")
            self._sync_boolean_tabs_to_current(force_all=self._tabs_show_all)
            return

        old_name = _short_name(node)


        dialog = UiBooleanRenameDialog(old_name, self)
        result = _exec_dialog_compat(dialog)
        if not _dialog_result_is_accepted(result):
            return
        new_name = dialog.textValue()
        if not new_name or new_name == old_name:
            return

        renamed = rename_node_safely(old_name, new_name)
        if renamed:
            self.poly_node = _short_name(renamed)
        self.refresh_from_scene()

    def _select_boolean_tab_relative(self, step):
        if not hasattr(self, "boolean_tabbar") or self.boolean_tabbar is None:
            return
        if self.boolean_tabbar.count() <= 0:
            self._on_list_all_booleans()
            return
        count = self.boolean_tabbar.count()
        if count <= 0:
            return
        current = self.boolean_tabbar.currentIndex()
        if current < 0:
            current = 0
        self.boolean_tabbar.setCurrentIndex((current + int(step)) % count)

    def _on_prev_boolean_tab(self):
        self._select_boolean_tab_relative(-1)

    def _on_next_boolean_tab(self):
        self._select_boolean_tab_relative(1)

