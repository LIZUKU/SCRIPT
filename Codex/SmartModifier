class NativeEyeButton(QtWidgets.QWidget):

    toggled = QtCore.Signal(bool)

    def __init__(self, checked=True, parent=None):
        super(NativeEyeButton, self).__init__(parent)
        self._checked = bool(checked)
        self.setFixedSize(34, 26)
        self.setCursor(QtGui.QCursor(QT_POINTING_HAND))
        self.setToolTip("Show / Hide input mesh in Outliner | Alt+Click = solo visibility")
        self.setMouseTracking(True)
        self._last_alt_click = False

    def wasAltClick(self):
        return bool(getattr(self, "_last_alt_click", False))

    def isChecked(self):
        return self._checked

    def setChecked(self, checked, emit_signal=False):
        checked = bool(checked)
        if checked == self._checked:
            return
        self._checked = checked
        self.update()
        if emit_signal:
            self.toggled.emit(self._checked)

    def mousePressEvent(self, event):

        self._last_alt_click = False
        try:
            mods = event.modifiers()
            if QT_ALT_MODIFIER is not None:
                try:
                    self._last_alt_click = bool(mods & QT_ALT_MODIFIER)
                except Exception:
                    self._last_alt_click = bool(int(mods) & int(QT_ALT_MODIFIER))
        except Exception:
            try:
                self._last_alt_click = bool(QtWidgets.QApplication.keyboardModifiers() & QT_ALT_MODIFIER)
            except Exception:
                self._last_alt_click = False
        self.setChecked(not self._checked, emit_signal=True)


        try:
            event.accept()
        except Exception:
            pass
        return

    def paintEvent(self, event):
        p = QtGui.QPainter(self)
