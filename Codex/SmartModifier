    return txt


def _unique_keep_order(items):
    out = []
    seen = set()
    for item in items or []:
        if not item:
            continue
        key = _short_name(item)
        if key in seen:
            continue
        seen.add(key)
        out.append(item)
    return out


def _mesh_transforms_from_names(names, exclude=None, skip_existing=None):

    if not maya_available():
        return []
    exclude = set([_short_name(x) for x in (exclude or []) if x])
    skip_existing = set([_short_name(x) for x in (skip_existing or []) if x])
    result = []
    for raw in names or []:
        candidate = _normalize_drag_candidate_name(raw)
        if not candidate:
            continue

        resolved = []

        for n in (candidate, _short_name(candidate)):
            if n and cmds.objExists(n):
                resolved.append(n)
        if not resolved:
            try:
                resolved.extend(cmds.ls(candidate, long=False) or [])
            except Exception:
                pass
        if not resolved:
            try:
                resolved.extend(cmds.ls(_short_name(candidate), long=False) or [])
            except Exception:
                pass

        for node in resolved:
            if not node or not cmds.objExists(node):
                continue
            transform = _as_transform(node)
            short = _short_name(transform)
            if not transform or short in exclude or short in skip_existing:
                continue
            if _safe_node_type(transform) != "transform":
                continue
            if not _has_mesh_shape(transform):
                continue
            result.append(short)
    return _unique_keep_order(result)


