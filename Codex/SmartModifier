    def _on_objects_dropped(self, objects):
        if not maya_available():
            return
        meshes = _mesh_transforms_from_names(objects, exclude=[], skip_existing=None)
        if not meshes:
            try:
                cmds.warning("Drop ignore : aucun mesh valide pour recevoir un modifier.")
            except Exception:
                pass
            return

        values = self._values_from_settings()
        added = []
        undo_open = False
        try:
            try:
                c.undoInfo(openChunk=True, chunkName="Modifier Stack Drop Add Bevel")
                undo_open = True
            except Exception:
                pass

            for mesh in meshes:
                if not ex(mesh) or not sh(mesh):
                    continue
                node = _ms_add_bevel(mesh, values)
                if node:
                    added.append((mesh, node))
        finally:
            if undo_open:
                try:
                    c.undoInfo(closeChunk=True)
                except Exception:
                    pass

        if not added:
            self._warning("Drop reçu, mais aucun Bevel modifier n'a pu être ajouté.")
            self.refresh_from_scene()
            return

        # Focus the UI on the last dropped/modified mesh, matching Maya's usual
        # last-selection behavior while keeping all dropped meshes selected.
        self.target = lg(added[-1][0]) or added[-1][0]
        self.current_node = added[-1][1]
        try:
            c.select([m for m, _n in added], r=True)
        except Exception:
            try: c.select(self.target, r=True)
            except Exception: pass
        self.refresh_from_scene()
        try:
            self._set_drop_active(False)
            self._set_status("Added Bevel modifier to: %s" % ", ".join(sn(m) for m, _n in added))
        except Exception:
            pass

    def _on_add_selected(self):
