# Override defaults/fallbacks without touching the rest of the shell backend.
def _qd_shell_defaults():
    return {
        "amount": 0.0,          # polyExtrudeFace.localTranslateZ
        "divisions": 1,
        "thickness": 0.1,
        "offset": 0.0,
        "keep_together": True,
    }


def _qd_shell_values(values=None):
    base_values = _qd_shell_defaults()
    if isinstance(values, dict):
        for key in base_values:
            if key in values:
                base_values[key] = values[key]
    else:
        try:
            data = list(values or [])
        except Exception:
            data = []
        keys = ["amount", "divisions", "thickness", "offset", "keep_together"]
        for index, key in enumerate(keys):
            if index < len(data):
                base_values[key] = data[index]
    try:
        base_values["amount"] = float(base_values.get("amount", 0.0))
    except Exception:
        base_values["amount"] = 0.0
    try:
        base_values["divisions"] = max(1, int(float(base_values.get("divisions", 1))))
    except Exception:
        base_values["divisions"] = 1
    try:
        base_values["thickness"] = float(base_values.get("thickness", 0.1))
    except Exception:
        base_values["thickness"] = 0.1
    try:
        base_values["offset"] = float(base_values.get("offset", 0.0))
    except Exception:
        base_values["offset"] = 0.0
    base_values["keep_together"] = bool(base_values.get("keep_together", True))
    return base_values


def _qd_shell_values_from_ui(ui):
    return _qd_shell_values({
        "amount": getattr(ui, "voxel_edit").value() if getattr(ui, "voxel_edit", None) is not None else 0.0,
        "divisions": getattr(ui, "segments_edit").value() if getattr(ui, "segments_edit", None) is not None else 1,
        "thickness": getattr(ui, "depth_edit").value() if getattr(ui, "depth_edit", None) is not None else 0.1,
        "offset": getattr(ui, "filter_angle_edit").value() if getattr(ui, "filter_angle_edit", None) is not None else 0.0,
        "keep_together": getattr(ui, "fractional_cb").isChecked() if getattr(ui, "fractional_cb", None) is not None else True,
    })


def _qd_set_shell_node(node, values=None):
    if not ex(node):
        return
    values = _qd_shell_values(values)
    try:
        c.lockNode(node, l=False)
    except Exception:
        pass
    try:
        _qd_force_shell_all_faces_component(node)
    except Exception:
        pass
    mapping = (
        ("keepFacesTogether", int(bool(values["keep_together"]))),
        ("divisions", int(values["divisions"])),
        ("localTranslateZ", float(values["amount"])),
        ("thickness", float(values["thickness"])),
        ("offset", float(values["offset"])),
        ("smoothingAngle", 30.0),
    )
    for attr_name, value in mapping:
        try:
            if c.attributeQuery(attr_name, n=node, ex=True):
                c.setAttr(node + "." + attr_name, value)
        except Exception:
            pass
    # Be explicit for Offset: Maya's polyExtrudeFace is native and sometimes
    # does not refresh viewport until dirtied after setAttr.
    try:
        if c.attributeQuery("offset", n=node, ex=True):
            c.setAttr(node + ".offset", float(values["offset"]))
    except Exception:
        pass
    try:
        c.dgdirty(node)
    except Exception:
        pass


def _qd_load_current_modifier_settings(self):
    node = self._current_node()
    if not node or not ex(node):
        self._building = True
        try:
            _qd_set_settings_mode(self, "empty")
        finally:
            self._building = False
        return
    if _qd_is_live_shell_node(node):
        self._building = True
        try:
            _qd_set_settings_mode(self, "Shell")
            values = _qd_shell_values_from_node(node)
            try: self.interactive_cb.setChecked(_ms_node_enabled(node))
            except Exception: pass
            self.voxel_edit.setValue(float(values["amount"]))
            self.segments_edit.setValue(int(values["divisions"]))
            self.depth_edit.setValue(float(values["thickness"]))
            self.filter_angle_edit.setValue(float(values["offset"]))
            self.fractional_cb.setChecked(bool(values["keep_together"]))
        finally:
            self._building = False
        return
    _qd_set_settings_mode(self, "Bevel")
    return _ORIG_LOAD_SETTINGS(self)


def _qd_apply_settings_from_ui(self):
    if getattr(self, "_building", False):
        return
    node = self._current_node()
    if not node or not ex(node):
        try:
            _qd_set_settings_mode(self, "empty")
        except Exception:
            pass
        return
    if _qd_is_live_shell_node(node):
        values = _qd_shell_values_from_ui(self)
        _qd_set_shell_node(node, values)
        try:
            if self.target and ex(self.target):
                _qd_mark_shell_transform(self.target)
                c.select(self.target, replace=True)
        except Exception:
            pass
        try:
            _qd_force_shell_all_faces_component(node)
            c.dgdirty(node)
            c.refresh(force=True)
        except Exception:
            pass
        return
    return _ORIG_APPLY_SETTINGS(self)


def _qd_on_add_shell(self):
    if not self.target or not ex(self.target):
        self.target = _ms_target_from_selection()
    if not self.target:
        self._warning("Select a mesh.")
        return
    self._building = True
    try:
        _qd_set_settings_mode(self, "Shell")
        self.voxel_edit.setValue(0.0)      # Local Translate Z default
        self.segments_edit.setValue(1)
        self.depth_edit.setValue(0.1)
        self.filter_angle_edit.setValue(0.0)
        self.fractional_cb.setChecked(True)
    finally:
        self._building = False
    try:
        c.undoInfo(openChunk=True, chunkName="Add Shell Modifier")
    except Exception:
        pass
    node = None
    try:
        node = _ms_add_shell(self.target, _qd_shell_values_from_ui(self))
    finally:
        try:
            c.undoInfo(closeChunk=True)
        except Exception:
            pass
    self.input_names = _ms_stack_nodes(self.target)
    if node in self.input_names:
        self._selected_row_index = self.input_names.index(node)
        self.current_node = node
    self.refresh_from_scene()


