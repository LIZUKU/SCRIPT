    def _sync_selection_from_maya(self):
        if self._building or not maya_available():
            return
        try:
            sel = _selection_transform_names()
        except Exception:
            sel = set()


        found_indices = set()
        for i, name in enumerate(self.input_names):
            short = _short_name(name)
            if name in sel or short in sel:
                found_indices.add(i)

        self._selected_row_indices = found_indices
        self._selected_row_index = sorted(found_indices)[-1] if found_indices else -1
        if self._selected_row_index >= 0:
            self._last_clicked_row_index = self._selected_row_index


        for i, row in enumerate(self.input_rows):
            row.setSelected(i in found_indices)

