        eye_path.cubicTo(cx + eye_w * 0.28, cy + eye_h * 0.92, cx - eye_w * 0.28, cy + eye_h * 0.92, cx - eye_w * 0.50, cy)

        p.setPen(QtGui.QPen(outline, 1.2))
