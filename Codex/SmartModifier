def _qt_event_local_pos(event):
    """Qt5/Qt6-safe local mouse position, avoiding QMouseEvent.pos() warnings when possible."""
    if event is None:
        try:
            return QtCore.QPoint(0, 0)
        except Exception:
            return None
    try:
        return event.position().toPoint()
    except Exception:
        pass
    try:
        return event.pos()
    except Exception:
        try:
            return QtCore.QPoint(0, 0)
        except Exception:
            return None


def _qt_event_global_pos(event):
    """Qt5/Qt6-safe global mouse position, avoiding QMouseEvent.globalPos() warnings when possible."""
    if event is None:
        try:
            return QtGui.QCursor.pos()
        except Exception:
            return None
    try:
        return event.globalPosition().toPoint()
    except Exception:
        pass
    try:
        return event.globalPos()
    except Exception:
        try:
            return QtGui.QCursor.pos()
        except Exception:
            return None


def _safe_disconnect_signal(signal, slot=None):
    """Disconnect a Qt signal without printing PySide RuntimeWarning noise in Maya."""
    if signal is None:
        return False
    try:
        with warnings.catch_warnings():
            warnings.simplefilter("ignore", RuntimeWarning)
            if slot is not None:
                signal.disconnect(slot)
            else:
                signal.disconnect()
        return True
    except (RuntimeError, TypeError):
        return False
    except Exception:
        return False


