def _set_input_viewport_display(object_name, label):

    if not maya_available() or not object_name or not cmds.objExists(object_name):
        return False

    label = str(label or "Wireframe")
    shapes = _mesh_shape_nodes_for_display(object_name)
    if not shapes:
        return False


    if label == "Hidden":
        values = {
            "overrideEnabled": 1,
            "overrideDisplayType": 0,
            "overrideLevelOfDetail": 0,
            "overrideShading": 1,
            "overrideTexturing": 1,
            "overrideVisibility": 0,
        }
        xray = False
    elif label == "Bounding Box":
        values = {
            "overrideEnabled": 1,
            "overrideDisplayType": 0,
            "overrideLevelOfDetail": 1,
            "overrideShading": 1,
            "overrideTexturing": 0,
            "overrideVisibility": 1,
        }
        xray = False
    elif label == "Shaded":
        values = {
            "overrideEnabled": 1,
            "overrideDisplayType": 0,
            "overrideLevelOfDetail": 0,
            "overrideShading": 1,
            "overrideTexturing": 1,
            "overrideVisibility": 1,
        }
        xray = False
    elif label == "X-Ray":
        values = {
            "overrideEnabled": 1,
            "overrideDisplayType": 0,
            "overrideLevelOfDetail": 0,
            "overrideShading": 1,
            "overrideTexturing": 1,
            "overrideVisibility": 1,
        }
        xray = True
    else:
        values = {
            "overrideEnabled": 1,
            "overrideDisplayType": 0,
            "overrideLevelOfDetail": 0,
            "overrideShading": 0,
            "overrideTexturing": 0,
            "overrideVisibility": 1,
        }
        xray = False

    changed = False
    for shape in shapes:
        for attr, value in values.items():
            changed = _set_attr_if_exists(shape, attr, value) or changed


        if label == "X-Ray":
            changed = _set_attr_if_exists(shape, "overrideRGBColors", 1) or changed
            changed = _set_attr_if_exists(shape, "overrideColorRGB", (0.0, 0.0, 0.0), attr_type="double3") or changed
            changed = _set_attr_if_exists(shape, "overrideColorA", 0.397) or changed
        elif label in ("Wireframe", "Shaded", "Bounding Box"):

            changed = _set_attr_if_exists(shape, "overrideColorA", 1.0) or changed
        changed = _set_shape_xray(shape, xray) or changed
    try:
        cmds.refresh()
    except Exception:
        pass
    return bool(changed)


def _get_input_viewport_display(object_name, default_label="Wireframe"):

    if not maya_available() or not object_name or not cmds.objExists(object_name):
        return default_label
    shapes = _mesh_shape_nodes_for_display(object_name)
    if not shapes:
        return default_label
    shape = shapes[0]
    try:
        if cmds.objExists(shape + ".overrideEnabled") and not bool(cmds.getAttr(shape + ".overrideEnabled")):
            return default_label
    except Exception:
        pass
    try:
        if cmds.objExists(shape + ".overrideVisibility") and not bool(cmds.getAttr(shape + ".overrideVisibility")):
            return "Hidden"
    except Exception:
        pass
    try:
        if _query_shape_xray(shape):
            return "X-Ray"
    except Exception:
        pass
    try:
        if cmds.objExists(shape + ".overrideLevelOfDetail") and int(cmds.getAttr(shape + ".overrideLevelOfDetail")) == 1:
            return "Bounding Box"
    except Exception:
        pass
    try:
        if cmds.objExists(shape + ".overrideShading"):
            return "Shaded" if bool(cmds.getAttr(shape + ".overrideShading")) else "Wireframe"
    except Exception:
        pass
    return default_label


def _snapshot_input_view_state(object_name):

    data = {"transform": object_name, "transform_attrs": {}, "shapes": {}}
    if not maya_available() or not object_name or not cmds.objExists(object_name):
        return data

    for attr in ("visibility",):
        plug = object_name + "." + attr
        try:
            if cmds.objExists(plug):
                data["transform_attrs"][attr] = cmds.getAttr(plug)
        except Exception:
            pass

    for shape in _mesh_shape_nodes_for_display(object_name):
        shape_data = {"attrs": {}, "xRay": None}
        for attr in (
            "overrideEnabled",
            "overrideDisplayType",
            "overrideLevelOfDetail",
            "overrideShading",
            "overrideTexturing",
            "overrideVisibility",
            "overrideRGBColors",
            "overrideColor",
            "overrideColorRGB",
            "overrideColorA",
        ):
            plug = shape + "." + attr
            try:
                if cmds.objExists(plug):
                    shape_data["attrs"][attr] = cmds.getAttr(plug)
            except Exception:
                pass
        try:
            shape_data["xRay"] = bool(_query_shape_xray(shape))
        except Exception:
            shape_data["xRay"] = None
        data["shapes"][shape] = shape_data
    return data


def _restore_input_view_state(snapshot):

    if not maya_available() or not snapshot:
        return False
    changed = False
    transform = snapshot.get("transform")
    if transform and cmds.objExists(transform):
        for attr, value in (snapshot.get("transform_attrs") or {}).items():
            plug = transform + "." + attr
            try:
                if cmds.objExists(plug):
                    cmds.setAttr(plug, value)
                    changed = True
            except Exception:
                pass

    for shape, shape_data in (snapshot.get("shapes") or {}).items():
        if not shape or not cmds.objExists(shape):
            continue
        for attr, value in (shape_data.get("attrs") or {}).items():
            plug = shape + "." + attr
            try:
                if not cmds.objExists(plug):
                    continue
                if attr == "overrideColorRGB":
                    if isinstance(value, (list, tuple)) and value:
                        rgb = value[0] if isinstance(value[0], (list, tuple)) else value
                        cmds.setAttr(plug, float(rgb[0]), float(rgb[1]), float(rgb[2]), type="double3")
                    else:
                        continue
                else:
                    if isinstance(value, (list, tuple)) and len(value) == 1:
                        value = value[0]
                    cmds.setAttr(plug, value)
                changed = True
            except Exception:
                pass
        if shape_data.get("xRay") is not None:
            try:
                _set_shape_xray(shape, bool(shape_data.get("xRay")))
                changed = True
            except Exception:
                pass
    return changed


