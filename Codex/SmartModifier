    def _show_input_row_context_menu(self, object_name, index, global_pos=None):

        if index < 0 or index >= len(self.input_names):
            return
        if not object_name:
            return


        if index not in self._clean_selected_row_indices():
            self._replace_selected_rows([index])
        else:
            self._apply_selected_rows_to_ui(select_in_maya=True)

        target_indices = self._target_row_indices_for_action(index)
        target_count = len(target_indices)

        menu = QtWidgets.QMenu(self)
        menu.setObjectName("InputRowContextMenu")
        menu.setStyleSheet(self._row_context_menu_stylesheet())

        suffix = " ({})".format(target_count) if target_count > 1 else ""
        duplicate_action = menu.addAction("Duplicate" + suffix)
        duplicate_copy_action = menu.addAction("Duplicate as Copy" + suffix)
        duplicate_instance_action = menu.addAction("Duplicate as Instance" + suffix)
        menu.addSeparator()
        smooth_action = menu.addAction("Use smooth mesh output" + suffix)
        try:
            smooth_action.setCheckable(True)
            smooth_states = []
            for idx in target_indices:
                if 0 <= idx < len(self.input_names):
                    smooth_states.append(self._get_input_smooth_mesh_output(self.input_names[idx], idx))
            smooth_action.setChecked(bool(smooth_states and all(smooth_states)))
        except Exception:
            pass
        menu.addSeparator()
        remove_action = menu.addAction("Remove" + suffix)

        selected = self._exec_menu_at(menu, global_pos)
        if selected is None:
            return


        target_names = [self.input_names[i] for i in target_indices if 0 <= i < len(self.input_names)]

        if selected == duplicate_action:
            for name in target_names:
                idx = self.input_names.index(name) if name in self.input_names else index
                self._duplicate_input_from_row(name, idx, mode="duplicate")
        elif selected == duplicate_copy_action:
            for name in target_names:
                idx = self.input_names.index(name) if name in self.input_names else index
                self._duplicate_input_from_row(name, idx, mode="copy")
        elif selected == duplicate_instance_action:
            for name in target_names:
                idx = self.input_names.index(name) if name in self.input_names else index
                self._duplicate_input_from_row(name, idx, mode="instance")
        elif selected == smooth_action:
            enabled = bool(smooth_action.isChecked())
            for name in target_names:
                idx = self.input_names.index(name) if name in self.input_names else index
                self._set_input_smooth_mesh_output(name, idx, enabled)
        elif selected == remove_action:
            if not self._confirm_bulk_remove_inputs(len(target_names)):
                return

            for name in list(target_names):
                idx = self.input_names.index(name) if name in self.input_names else index
                self._remove_input_from_boolean(name, idx)

    def _input_operation_label_for_index(self, index):
        try:
            if 0 <= int(index) < len(self.input_rows):
                return self.input_rows[int(index)].operation_btn.current_label
        except Exception:
            pass
        try:
            label = self.op_combo.currentText()
            return label if label in INPUT_OPERATION_LABELS or label in GLOBAL_OPERATION_LABELS else DEFAULT_NEW_INPUT_OPERATION_LABEL
        except Exception:
