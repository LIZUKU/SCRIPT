def list_all_polyboolean_nodes():

    if not maya_available():
        return []

    found = []
    seen = set()

    def _add(node):
        if not node or not cmds.objExists(node):
            return
        if not _is_polyboolean_node(node):
            return
        short = _short_name(node)
        if short in seen:
            return
        seen.add(short)
        found.append(short)

    for t in NODE_TYPES_CANDIDATES:
        try:
            for n in cmds.ls(type=t) or []:
                _add(n)
        except Exception:
            pass


    try:
        for n in cmds.ls() or []:
            if _is_polyboolean_node(n):
                _add(n)
    except Exception:
        pass

    return found


def _related_nodes_for_boolean_detection(raw_node):

    nodes = []
    if not maya_available() or not raw_node:
        return nodes

    node = str(raw_node).split('.', 1)[0]
    for candidate in (node, _short_name(node)):
        if candidate and cmds.objExists(candidate):
            nodes.append(candidate)

    try:
        transform = _as_transform(node)
        for candidate in (transform, _short_name(transform)):
            if candidate and cmds.objExists(candidate):
                nodes.append(candidate)
        for shape in _shape_nodes(transform):
            if shape and cmds.objExists(shape):
                nodes.append(shape)
    except Exception:
        pass

    return _unique_keep_order(nodes)


