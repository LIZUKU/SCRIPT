    def _set_status(self, text=None, warning=False, drop_active=False):
        lab = getattr(self, "status_label", None)
        if lab is None:
            return
        try:
            text = "" if text is None else str(text)
            if (not text) or text.startswith("Mesh:") or text.startswith("Mode switched"):
                lab.setText("")
                lab.setVisible(False)
                lab.setFixedHeight(0)
                lab.setProperty("warning", False)
                lab.setProperty("dropActive", False)
                lab.style().unpolish(lab)
                lab.style().polish(lab)
                lab.update()
                self._queue_layout_rebalance()
                return

            lab.setFixedHeight(self._scaled_floor(20, 18))
            lab.setVisible(True)
            lab.setText(text)
            lab.setProperty("warning", bool(warning))
            lab.setProperty("dropActive", bool(drop_active))
            lab.style().unpolish(lab)
            lab.style().polish(lab)
            lab.update()
            self._queue_layout_rebalance()
        except Exception:
            pass

    def _current_stack_mode_label(self):
        try:
            if not self.target or not ex(self.target):
                return "No Mesh"
            b = base(self.target)
            rr = res(self.target)
            if b and ex(b) and not c.getAttr(b + ".intermediateObject"):
                return "Edit Base"
            if rr and ex(rr) and not c.getAttr(rr + ".intermediateObject"):
                return "Show Result"
        except Exception:
            pass
        return "Show Result"

