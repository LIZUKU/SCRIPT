    def _update_input_list_height(self):
        try:
            row_count = max(1, len(self.input_names))
            row_h = self._scaled(32)
            min_for_rows = self._compact_input_list_height()
            result_h = self.result_bar_frame.height() or self._scaled_floor(55, 50)
            settings_h = self.settings_shell.height() or (self._settings_open_height if self.settings_header.isChecked() else self._settings_closed_height)
            footer_h = 0
            try:
                if getattr(self, "status_label", None) is not None and self.status_label.isVisible():
                    footer_h = self.status_label.height() or self._scaled_floor(20, 18)
            except Exception:
                footer_h = self._scaled_floor(20, 18)
            spacing = self._scaled_gap(6, 4, 9)
            content_h = self.content_container.height()
            if content_h <= 0:
                content_h = result_h + min_for_rows + settings_h + footer_h + spacing
            if not self.settings_header.isChecked():
                wanted = max(min_for_rows, row_count * row_h + 2)
            else:
                wanted = max(min_for_rows, content_h - result_h - settings_h - footer_h - (spacing * 2))
                wanted = max(wanted, row_count * row_h + 2)
            self._set_input_list_fixed_height(wanted)
        except Exception:
            try:
                pass
            except Exception:
                pass

    def refresh_from_scene(self):
        self._building = True
        try:


            self.setWindowTitle("UiBoolean")
            if self.poly_node and maya_available() and cmds.objExists(self.poly_node):
                if self.node_name_edit is not None:
                    self.node_name_edit.setText(self.poly_node)
                self.result_transform = find_result_transform(self.poly_node)
                self.input_names = self._merge_cached_inactive_inputs(find_input_transforms(self.poly_node))
            else:
                if self.node_name_edit is not None:
                    self.node_name_edit.setText("")
                self.result_transform = ""


                self.input_names = []

            self._sync_boolean_tabs_to_current()
            self._rebuild_input_rows()
            self._refresh_hide_cutters_button_state()

            interactive = query_polyboolean_interactive_update(self.poly_node, True)
            self.interactive_cb.setChecked(bool(interactive))

            self._set_combo_text(
                self.op_combo,
                query_polyboolean_new_input_operation(self.poly_node, DEFAULT_NEW_INPUT_OPERATION_LABEL),
            )
            self._set_combo_text(
                self.display_combo,
                query_polyboolean_new_input_display(self.poly_node, DEFAULT_NEW_INPUT_DISPLAY_LABEL),
            )
            self._set_combo_text(
                self.geometry_combo,
                enum_value_to_label(self.poly_node, "geometry_mode", GEOMETRY_MODE_LABELS, "Mesh"),
            )

            voxel = get_attr_value(self.poly_node, "voxel_size", 1.0)
            try:
                self.voxel_edit.setText("{:.3f}".format(float(voxel)))
            except Exception:
                self.voxel_edit.setText("1.000")

            inter = query_polyboolean_classification(self.poly_node, "Auto")


            radios = (self.radio_auto, self.radio_edge, self.radio_normal)
            old_blocks = []
            for rb in radios:
                try:
                    old_blocks.append(rb.blockSignals(True))
                except Exception:
                    old_blocks.append(False)
            try:
                if inter == "Edge":
                    self.radio_edge.setChecked(True)
                elif inter == "Normal":
                    self.radio_normal.setChecked(True)
                else:
                    self.radio_auto.setChecked(True)
            finally:
                for rb, old_state in zip(radios, old_blocks):
                    try:
                        rb.blockSignals(old_state)
                    except Exception:
                        pass


            has_node = self._is_valid_poly_node(self.poly_node)
            for ctl in (self.interactive_cb, self.op_combo, self.display_combo, self.geometry_combo,
                        self.voxel_edit, self.radio_auto, self.radio_edge, self.radio_normal,
                        self.hide_cutters_btn, self.remove_selected_btn, self.validate_boolean_btn):
                try:
                    ctl.setEnabled(bool(has_node))
                except Exception:
                    pass


            try:
                self.add_selected_btn.setEnabled(bool(maya_available()))
            except Exception:
                pass
        finally:
            self._building = False
            try:
                self._refresh_mode_button_state()
            except Exception:
                pass
            self._sync_selection_from_maya()

    def _is_valid_poly_node(self, node):
        return bool(node and maya_available() and cmds.objExists(node) and _is_polyboolean_node(node))

    def _warning(self, message):
        if maya_available():
            try:
                cmds.warning(message)
                return
            except Exception:
                pass
        return None

    def _sync_boolean_tabs_to_current(self, force_all=False, forced_nodes=None):

        if not hasattr(self, "boolean_tabbar") or self.boolean_tabbar is None:
            return

        if force_all:
            self._tabs_show_all = True

        if forced_nodes is not None:
            nodes = list(forced_nodes)
        elif self._tabs_show_all:
            nodes = list_all_polyboolean_nodes()
        else:
            nodes = [self.poly_node] if self._is_valid_poly_node(self.poly_node) else []

        if self._is_valid_poly_node(self.poly_node) and _short_name(self.poly_node) not in [_short_name(x) for x in nodes]:
            nodes.insert(0, _short_name(self.poly_node))

        nodes = _unique_keep_order([_short_name(n) for n in nodes if n])
        self.boolean_nodes = nodes

        current_short = _short_name(self.poly_node) if self.poly_node else ""
        current_index = -1
        for i, n in enumerate(nodes):
            if _short_name(n) == current_short:
                current_index = i
                break
        if current_index < 0 and nodes:
            current_index = 0

        self._tab_syncing = True
        try:
            while self.boolean_tabbar.count() > 0:
                self.boolean_tabbar.removeTab(0)
            for n in nodes:
                label = _short_name(n)
                idx = self.boolean_tabbar.addTab(label)
                try:
                    self.boolean_tabbar.setTabData(idx, n)
                except Exception:
                    pass
                try:
                    result = find_result_transform(n)
                    self.boolean_tabbar.setTabToolTip(idx, "{0}  ->  {1}".format(label, result))
                except Exception:
                    self.boolean_tabbar.setTabToolTip(idx, label)
            if current_index >= 0:
                self.boolean_tabbar.setCurrentIndex(current_index)
        finally:
            self._tab_syncing = False

        self._update_boolean_nav_enabled()

    def _update_boolean_nav_enabled(self):
        count = self.boolean_tabbar.count() if hasattr(self, "boolean_tabbar") and self.boolean_tabbar else 0
        has_tabs = count > 0
        arrows_visible = count > 1
        self._boolean_nav_has_tabs = has_tabs
        self._boolean_nav_arrows_visible = arrows_visible


        if getattr(self, "boolean_tabbar", None) is not None:
            try:
                self.boolean_tabbar.setVisible(has_tabs)
            except Exception:
                pass
        for btn in (getattr(self, "prev_boolean_btn", None), getattr(self, "next_boolean_btn", None)):
            if btn is not None:
                try:
                    btn.setVisible(arrows_visible)
                    btn.setEnabled(arrows_visible)
                except Exception:
                    pass

        try:
            if getattr(self, "tabs_row_layout", None) is not None:
                self.tabs_row_layout.invalidate()
            self._apply_header_size_overrides()
            self.updateGeometry()
        except Exception:
            pass

    def _node_from_boolean_tab_index(self, index):
        node = None
        try:
            node = self.boolean_tabbar.tabData(index)
        except Exception:
            pass
        if not node and 0 <= index < len(getattr(self, "boolean_nodes", [])):
            node = self.boolean_nodes[index]
        return _short_name(node) if node else None

    def _on_boolean_tab_changed(self, index):
        if self._tab_syncing or index < 0:
            return
        node = self._node_from_boolean_tab_index(index)
        if not self._is_valid_poly_node(node):
            self._warning("Onglet boolean invalide ou node supprime : {0}".format(node))
            self._sync_boolean_tabs_to_current(force_all=self._tabs_show_all)
            return
        if _short_name(node) == _short_name(self.poly_node):
            return
        self.poly_node = _short_name(node)
        self.refresh_from_scene()

    def _exec_menu_at(self, menu, global_pos):
        if global_pos is None:
            try:
                global_pos = QtGui.QCursor.pos()
            except Exception:
                global_pos = self.mapToGlobal(QtCore.QPoint(0, 0))
        try:
            return menu.exec(global_pos)
        except AttributeError:
            try:
                return menu.exec_(global_pos)
            except Exception:
                return None
        except Exception:
            try:
                return menu.exec_(global_pos)
            except Exception:
                return None

