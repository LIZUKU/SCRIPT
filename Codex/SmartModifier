class InputRow(QtWidgets.QFrame):
    operation_changed = QtCore.Signal(str, int, str)
    display_changed = QtCore.Signal(str, int, str)
    visibility_changed = QtCore.Signal(str, int, bool)
    active_changed = QtCore.Signal(str, int, bool)
    selected = QtCore.Signal(int)
    context_menu_requested = QtCore.Signal(str, int, object)
    reorder_drag_started = QtCore.Signal(int)
    reorder_drag_moved = QtCore.Signal(int, object)
    reorder_drag_released = QtCore.Signal(int, object)

    def __init__(self, object_name, index=0, is_base=False, parent=None):
        QtWidgets.QFrame.__init__(self, parent)
        self.object_name = object_name
        self.index = index
        self._is_base = bool(is_base)
        self._selected = False
        self._hover = False
        self._menu_open = False
        self._mmb_drag_active = False
        self._lmb_reorder_pending = False
        self._lmb_reorder_press_global = None
        self._reorder_indicator = 0
        self._filter_widgets = []
        self.setObjectName("InputRow")
        self.setFixedHeight(32)
        self.setSizePolicy(QtWidgets.QSizePolicy.Expanding, QtWidgets.QSizePolicy.Fixed)
        self.setMouseTracking(True)
        self.setAutoFillBackground(False)
        try:
            self.setAttribute(QT_WA_STYLED_BACKGROUND, False)
        except Exception:
            pass

        layout = QtWidgets.QHBoxLayout(self)

        layout.setContentsMargins(0, 0, 8, 0)
        layout.setSpacing(5)

        self.left_bar = LeftInputBar(active=False, base_input=self._is_base)
        layout.addWidget(self.left_bar)

        self.name_label = QtWidgets.QLabel(object_name)
        self.name_label.setObjectName("InputName")
        self.name_label.setMouseTracking(True)
        self.name_label.setAutoFillBackground(False)
        layout.addWidget(self.name_label, 1)

        self.operation_btn = IconMenuButton("operation", INPUT_OPERATION_LABELS, "Union")
        self.operation_btn.setToolTip("Input boolean operation")
        self.operation_btn.valueChanged.connect(self._emit_operation)
        layout.addWidget(self.operation_btn, 0)

        self.display_btn = IconMenuButton("display", DISPLAY_LABELS, "Wireframe")
        self.display_btn.setToolTip("Input display mode")
        self.display_btn.valueChanged.connect(self._emit_display)
        layout.addWidget(self.display_btn, 0)


        self.visibility_btn = NativeEyeButton(True)
        self.visibility_btn.toggled.connect(self._emit_visibility)
        layout.addWidget(self.visibility_btn, 0)

        self.toggle = NativeToggle(True)
        self.toggle.toggled.connect(self._emit_active)
        layout.addWidget(self.toggle, 0)


        for widget in (self, self.left_bar, self.name_label, self.operation_btn, self.display_btn, self.visibility_btn, self.toggle):
            self._install_hover_filter(widget)
        for btn in (self.operation_btn, self.display_btn):
            try:
                btn.menu_obj.aboutToShow.connect(self._on_menu_about_to_show)
                btn.menu_obj.aboutToHide.connect(self._on_menu_about_to_hide)
            except Exception:
                pass

    def setBaseInput(self, is_base):
        is_base = bool(is_base)
        if self._is_base == is_base:
            return
        self._is_base = is_base
        try:
            self.left_bar.setBaseInput(is_base)
        except Exception:
            pass
        self.setProperty("baseInput", self._is_base)
        self.update()

    def isBaseInput(self):
        return bool(self._is_base)

    def _name_label_style(self):
        try:
            row_active = bool(self.toggle.isChecked())
        except Exception:
            row_active = True
        if not row_active:
            color = "#8a8a8a" if not self._is_base else "#a8965f"
        elif self.isHighlighted():
            color = "#fff1c0" if self._is_base else "#f0f0f0"
        else:
            color = "#d0bd78" if self._is_base else "#b0b0b0"
        return "color: {}; background: transparent; padding-left: 0px; padding-right: 0px;".format(color)

    def _install_hover_filter(self, widget):
        if not widget:
            return
        try:
            widget.setMouseTracking(True)
            widget.installEventFilter(self)
            self._filter_widgets.append(widget)
        except Exception:
            pass

    def eventFilter(self, obj, event):
        et = event.type()


        if et == QT_EVENT_MOUSE_PRESS and self._event_is_right_button(event):


            self._set_hover(True)
            self.context_menu_requested.emit(self.object_name, self.index, self._event_global_pos(event))
            return True


        if et == QT_EVENT_MOUSE_PRESS and self._event_is_middle_button(event):
            self._clear_left_reorder_pending()
            self._begin_reorder_drag(event)
            return True
        if et == QT_EVENT_MOUSE_PRESS and self._event_is_left_button(event) and self._is_left_reorder_zone(obj):
            self._start_left_reorder_pending(event)
        if et == QT_EVENT_MOUSE_MOVE and self._lmb_reorder_pending and self._left_reorder_drag_distance_reached(event):
            self._clear_left_reorder_pending()
            self._begin_reorder_drag(event)
            return True
        if et == QT_EVENT_MOUSE_MOVE and self._mmb_drag_active:
            self._move_reorder_drag(event)
            return True
        if et == QT_EVENT_MOUSE_RELEASE and self._mmb_drag_active:
            self._clear_left_reorder_pending()
            self._end_reorder_drag(event)
            return True
        if et == QT_EVENT_MOUSE_RELEASE and self._lmb_reorder_pending:
            self._clear_left_reorder_pending()

        if et == QT_EVENT_ENTER:
            self._set_hover(True)
        elif et == QT_EVENT_LEAVE:

            self._queue_hover_update_from_cursor()
        elif et == QT_EVENT_MOUSE_PRESS:


            self._set_hover(True)
            if self._event_is_left_button(event) and self._is_left_selection_zone(obj):
                if (not self._selected) or self._event_has_multi_selection_modifier(event):
                    self.selected.emit(self.index)
        return QtWidgets.QFrame.eventFilter(self, obj, event)

    def _event_is_left_button(self, event):
        if QT_LEFT_BUTTON is None or event is None:
            return False
        try:
            return event.button() == QT_LEFT_BUTTON
        except Exception:
            return False

    def _event_buttons_has_left(self, event):
        if QT_LEFT_BUTTON is None or event is None:
            return False
        try:
            return bool(event.buttons() & QT_LEFT_BUTTON)
        except Exception:
            try:
                return bool(int(event.buttons()) & int(QT_LEFT_BUTTON))
            except Exception:
                return False

    def _event_is_middle_button(self, event):
        if QT_MIDDLE_BUTTON is None or event is None:
            return False
        try:
            return event.button() == QT_MIDDLE_BUTTON
        except Exception:
            return False

    def _event_is_right_button(self, event):
        if QT_RIGHT_BUTTON is None or event is None:
            return False
        try:
            return event.button() == QT_RIGHT_BUTTON
        except Exception:
            return False

    def _event_has_multi_selection_modifier(self, event):

        try:
            mods = event.modifiers()
        except Exception:
            try:
                mods = QtWidgets.QApplication.keyboardModifiers()
            except Exception:
                mods = None
        for modifier in (QT_CONTROL_MODIFIER, QT_SHIFT_MODIFIER):
            if modifier is None or mods is None:
                continue
            try:
                if bool(mods & modifier):
                    return True
            except Exception:
                try:
                    if bool(int(mods) & int(modifier)):
                        return True
                except Exception:
                    pass
        return False

    def _event_global_pos(self, event):
        return _qt_event_global_pos(event)

    def _is_left_reorder_zone(self, obj):


        return obj in (self, self.left_bar, self.name_label)

    def _is_left_selection_zone(self, obj):


        return self._is_left_reorder_zone(obj)

    def _start_left_reorder_pending(self, event):
        self._lmb_reorder_pending = True
        self._lmb_reorder_press_global = self._event_global_pos(event)

    def _clear_left_reorder_pending(self):
        self._lmb_reorder_pending = False
        self._lmb_reorder_press_global = None

    def _left_reorder_drag_distance_reached(self, event):
        if not self._lmb_reorder_pending or self._lmb_reorder_press_global is None:
            return False
        if not self._event_buttons_has_left(event):
            return False
        current = self._event_global_pos(event)
        try:
            delta = current - self._lmb_reorder_press_global
            distance = max(abs(delta.x()), abs(delta.y()))
        except Exception:
            return False
        try:
            threshold = QtWidgets.QApplication.startDragDistance()
        except Exception:
            threshold = 6
        return distance >= max(3, int(threshold))

    def _begin_reorder_drag(self, event):
        self._clear_left_reorder_pending()
        self._mmb_drag_active = True


        if not self._selected:
            self.selected.emit(self.index)
        self._set_hover(True)
        try:
            self.grabMouse()
        except Exception:
            pass
        self.reorder_drag_started.emit(self.index)
        self.reorder_drag_moved.emit(self.index, self._event_global_pos(event))

    def _move_reorder_drag(self, event):
        if not self._mmb_drag_active:
            return
        self.reorder_drag_moved.emit(self.index, self._event_global_pos(event))

    def _end_reorder_drag(self, event):
        if not self._mmb_drag_active:
            return
        self._mmb_drag_active = False
        try:
            self.releaseMouse()
        except Exception:
            pass
        self.reorder_drag_released.emit(self.index, self._event_global_pos(event))

    def setReorderIndicator(self, where):
        where = int(where or 0)
        where = -1 if where < 0 else (1 if where > 0 else 0)
        if self._reorder_indicator == where:
            return
        self._reorder_indicator = where
        self.update()

    def _queue_hover_update_from_cursor(self):

        if QtCore is None:
            return
        row_ref = weakref.ref(self)

        def _safe_call():
            row = row_ref()
            if row is None or not _qt_object_is_valid(row):
                return
            try:
                row._update_hover_from_cursor()
            except RuntimeError as exc:
                if "already deleted" not in str(exc):
                    raise

        QtCore.QTimer.singleShot(0, _safe_call)

    def _on_menu_about_to_show(self):
        if not _qt_object_is_valid(self):
            return
        self._menu_open = True

        self._set_hover(True)

    def _on_menu_about_to_hide(self):
        if not _qt_object_is_valid(self):
            return
        self._menu_open = False
        self._queue_hover_update_from_cursor()

    def _set_hover(self, hover):
        if not _qt_object_is_valid(self):
            return
        hover = bool(hover)
        if self._hover == hover:
            return
        self._hover = hover
        try:
            self.update()
        except RuntimeError as exc:
            if "already deleted" not in str(exc):
                raise

    def _update_hover_from_cursor(self):
        if not _qt_object_is_valid(self):
            return
        if self._menu_open:
            self._set_hover(True)
            return
        try:
            local = self.mapFromGlobal(QtGui.QCursor.pos())
            inside = self.rect().contains(local)
        except RuntimeError as exc:
            if "already deleted" in str(exc):
                return
            inside = False
        except Exception:
            inside = False
        self._set_hover(inside)

    def isHighlighted(self):
        return bool(self._selected or self._hover or self._menu_open)

    def setSelected(self, selected):
        self._selected = bool(selected)
        self.left_bar.setActive(self._selected or self._hover or self._menu_open)
        self.setProperty("selected", self._selected)
        self.name_label.setStyleSheet(self._name_label_style())
        self.update()

    def enterEvent(self, event):
        self._set_hover(True)
        QtWidgets.QFrame.enterEvent(self, event)

    def leaveEvent(self, event):
        self._queue_hover_update_from_cursor()
        QtWidgets.QFrame.leaveEvent(self, event)

    def mousePressEvent(self, event):
        if self._event_is_right_button(event):
            self._set_hover(True)
            self.context_menu_requested.emit(self.object_name, self.index, self._event_global_pos(event))
            return
        if self._event_is_middle_button(event):
            self._begin_reorder_drag(event)
            return
        if self._event_is_left_button(event):
            self._start_left_reorder_pending(event)
        if not self._selected:
            self.selected.emit(self.index)
        self._set_hover(True)
        QtWidgets.QFrame.mousePressEvent(self, event)

    def mouseMoveEvent(self, event):
        if self._lmb_reorder_pending and self._left_reorder_drag_distance_reached(event):
            self._clear_left_reorder_pending()
            self._begin_reorder_drag(event)
            return
        if self._mmb_drag_active:
            self._move_reorder_drag(event)
            return
        QtWidgets.QFrame.mouseMoveEvent(self, event)

    def mouseReleaseEvent(self, event):
        if self._mmb_drag_active:
            self._end_reorder_drag(event)
            return
        self._clear_left_reorder_pending()
        QtWidgets.QFrame.mouseReleaseEvent(self, event)

    def paintEvent(self, event):

        p = QtGui.QPainter(self)
        rect = self.rect()

        if self._is_base:


            if self._mmb_drag_active:
                bg = _qcolor("#5a471b")
                top = _qcolor("#a68a3a")
                bottom = _qcolor("#261f09")
            elif self._selected:
                bg = _qcolor("#3f3520")
                top = _qcolor("#726032")
                bottom = _qcolor("#211b10")
            elif self._menu_open or self._hover:
                bg = _qcolor("#322d26")
                top = _qcolor("#4c453a")
                bottom = _qcolor("#1b1814")
            else:
                bg = _qcolor("#2f2b20")
                top = _qcolor("#4a4329")
                bottom = _qcolor("#1f1c14")
        elif self._mmb_drag_active:
            bg = _qcolor("#5a1b1b")
            top = _qcolor("#a63a3a")
            bottom = _qcolor("#260909")
        elif self._selected:

            bg = _qcolor("#3f2020")
            top = _qcolor("#723232")
            bottom = _qcolor("#211010")
        elif self._menu_open or self._hover:
            bg = _qcolor("#322626")
            top = _qcolor("#4c3a3a")
            bottom = _qcolor("#1b1414")
        else:

            bg = _qcolor("#292929")
            top = _qcolor("#3a3a3a")
            bottom = _qcolor("#1c1c1c")

        p.fillRect(rect, bg)
        p.setPen(QtGui.QPen(top, 1))
        p.drawLine(rect.left(), rect.top(), rect.right(), rect.top())
        p.setPen(QtGui.QPen(bottom, 1))
        p.drawLine(rect.left(), rect.bottom(), rect.right(), rect.bottom())


        try:
            row_active = bool(self.toggle.isChecked())
        except Exception:
            row_active = True
        if not row_active:
            p.save()
            stripe_color = _qcolor("#111111", 95)
            stripe_pen = QtGui.QPen(stripe_color, 2)
            p.setPen(stripe_pen)
            step = 9
            x = rect.left() - rect.height()
            while x < rect.right() + rect.height():
