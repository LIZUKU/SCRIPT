    def _apply_ui_scale(self, refit=True):

        try:
            self._apply_style()
        except Exception:
            pass
        self._refresh_direct_button_styles()
        self._apply_scaled_widget_sizes()

        try:
            self._closed_minimum_size = QtCore.QSize(
                max(
                    getattr(self, "_min_readable_dialog_width", 320),
                    self._scaled_w(self._base_closed_minimum_size.width()),
                    self._header_required_width_for_scale(),
                ),
                self._scaled(self._base_closed_minimum_size.height()),
            )
            base_body = self._settings_body_open_height_base or getattr(self, "_settings_body_open_height", 178)
            self._settings_closed_height = self._scaled_floor(22, 20)
            self._settings_body_open_height = self._scaled(base_body)
            self._settings_open_height = self._settings_closed_height + self._settings_body_open_height
            self._open_minimum_size = QtCore.QSize(
                self._closed_minimum_size.width(),
                self._closed_minimum_size.height() + self._settings_body_open_height,
            )
            self.setMinimumSize(self._open_minimum_size if self.settings_header.isChecked() else self._closed_minimum_size)
        except Exception:
            pass

        try:
            self._apply_header_size_overrides()
        except Exception:
            pass
        try:
            self._apply_layout_size_overrides()
        except Exception:
            pass
        try:
            self.settings_header.setFixedHeight(self._settings_closed_height)
            self.settings_body.setFixedHeight(self._settings_body_open_height)
            self.settings_shell.setFixedHeight(self._settings_open_height if self.settings_header.isChecked() else self._settings_closed_height)
        except Exception:
            pass
        try:
            self.settings_layout.setContentsMargins(self._scaled_w(10), self._scaled(7), self._scaled_w(18), self._scaled(8))
            self.settings_layout.setHorizontalSpacing(self._scaled_gap(6, 4, 10))
            self.settings_layout.setVerticalSpacing(max(0, self._scaled(2)))
            self.settings_layout.setColumnMinimumWidth(0, self._scaled_w(142))
            self.settings_layout.setColumnMinimumWidth(1, self._scaled_w(116))
        except Exception:
            pass

        self._last_list_height = 0
        self._update_input_list_height()
        if refit:
            try:
                target_w = self._target_dialog_width_for_scale()
                target_h = max(self.minimumHeight(), self.sizeHint().height())
                self.resize(int(target_w), target_h)
                self._queue_layout_rebalance()
                _clamp_dialog_to_screen(self)
                if not self.settings_header.isChecked():
                    self._fit_window_to_compact_default()
            except Exception:
                pass

