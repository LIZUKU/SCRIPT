def _selection_transform_names():

    names = set()
    if not maya_available():
        return names
    try:
        raw_sel = cmds.ls(sl=True, long=True, flatten=True) or []
    except Exception:
        raw_sel = []
    for raw in raw_sel:

        node = str(raw).split('.', 1)[0]
        if not node:
            continue
        for candidate in (node, _short_name(node)):
            if candidate:
                names.add(candidate)
        try:
