    def _element_enabled_snapshot_from_ui(self, target_indices=None, target_active=True):

        target_indices = set(int(i) for i in (target_indices or []))
        desired_count = 0
        try:
            desired_count = max(0, len(self.input_names) - 1)
        except Exception:
            desired_count = 0
        values = [_ui_active_to_element_enabled_value(True)] * max(1, desired_count)

        for row_idx, name in enumerate(getattr(self, "input_names", []) or []):
            try:
                array_idx, _count = _element_enabled_index_for_input_row(
                    self.poly_node,
                    row_idx,
                    input_names=getattr(self, "input_names", None),
                )
            except Exception:
                array_idx = None
            if array_idx is None:
                continue
            while len(values) <= int(array_idx):
                values.append(_ui_active_to_element_enabled_value(True))

            if row_idx in target_indices:
                state = bool(target_active)
            else:
                state = True
                try:
                    if 0 <= row_idx < len(self.input_rows):
                        state = bool(self.input_rows[row_idx].toggle.isChecked())
                except Exception:
                    try:
                        state = bool(self._cached_input_active_state(name, True, row_idx))
                    except Exception:
                        state = True
            values[int(array_idx)] = _ui_active_to_element_enabled_value(state)

        return values

    def _queue_element_enabled_snapshot_reapply(self, values, target_indices=None, target_active=True):

        if QtCore is None:
            return
        try:
            snapshot = _normalize_element_enabled_storage_values(values)
        except Exception:
            return
        if not snapshot:
            return
        poly_node = self.poly_node
        try:
            target_indices = sorted(set(int(i) for i in (target_indices or [])))
        except Exception:
            target_indices = []
        target_active = bool(target_active)
        ui_ref = weakref.ref(self)

        def _reapply_once():
            ui = ui_ref()
            if ui is None or not _qt_object_is_valid(ui):
                return
            if not maya_available() or not poly_node or not cmds.objExists(poly_node):
                return
            original_selection = []
            try:
                original_selection = cmds.ls(sl=True, long=False) or []
            except Exception:
                original_selection = []
            try:
                current = _normalize_element_enabled_storage_values(_get_polyboolean_element_enabled_values(poly_node))
                needs_write = True
                try:
                    needs_write = current[:len(snapshot)] != snapshot[:len(current)] or len(current) < len(snapshot)
                except Exception:
                    needs_write = True
                if needs_write:
                    _set_polyboolean_element_enabled_values(poly_node, snapshot)
                for idx in target_indices:
                    try:
                        if 0 <= idx < len(ui.input_rows):
                            ui.input_rows[idx].toggle.setChecked(target_active, emit_signal=False)
                            ui.input_rows[idx].update()
                    except Exception:
                        pass
                try:
                    cmds.dgdirty(poly_node)
                except Exception:
                    pass
                for attr in ("elementEnabled", "ee"):
                    try:
                        if _polyboolean_data_attr_exists(poly_node, attr):
                            cmds.dgdirty(poly_node + "." + attr)
                    except Exception:
                        pass
                try:
                    cmds.refresh(force=True)
                except Exception:
                    pass
            finally:
                try:
                    kept = [x for x in original_selection if cmds.objExists(x)]
                    if kept:
                        cmds.select(kept, r=True)
                    else:
                        cmds.select(clear=True)
                except Exception:
                    pass


        try:
            QtCore.QTimer.singleShot(60, _reapply_once)
        except Exception:
            pass

    def _on_input_active_changed(self, object_name, index, active):

        target_indices = self._target_row_indices_for_action(index)
        if not target_indices:
            target_indices = [index]
        if not maya_available() or not self.poly_node or not cmds.objExists(self.poly_node):
            return

        target_indices = [
            int(i) for i in target_indices
            if _polyboolean_element_enabled_row_has_slot(self.poly_node, int(i), input_names=self.input_names)
        ]
        if not target_indices:
            try:
                idx = int(index)
                if 0 <= idx < len(self.input_rows):
                    self.input_rows[idx].toggle.setChecked(True, emit_signal=False)
                    self.input_rows[idx].toggle.update()
            except Exception:
                pass
            self._warning("Input enabled : cette ligne source/base n'a pas de slot elementEnabled exploitable sur ce build Maya.")
            return

        changed_count = 0
        undo_open = False
        original_selection = []
        desired_values = self._element_enabled_snapshot_from_ui(target_indices=target_indices, target_active=active)
        try:
            try:
                original_selection = cmds.ls(sl=True, long=False) or []
            except Exception:
                original_selection = []
            try:
                cmds.undoInfo(openChunk=True, chunkName="UiBoolean Toggle Input Enabled")
                undo_open = True
            except Exception:
                pass

            if _set_polyboolean_element_enabled_values(self.poly_node, desired_values):
                changed_count = len(set(target_indices))
                for idx in sorted(set(int(i) for i in target_indices)):
                    if idx < 0 or idx >= len(self.input_names):
                        continue
                    name = self.input_names[idx]
                    self._remember_input_active_state(name, bool(active))
                    try:
                        if 0 <= idx < len(self.input_rows):
                            self.input_rows[idx].toggle.setChecked(bool(active), emit_signal=False)
                            self.input_rows[idx].update()
                    except Exception:
                        pass


                for row_idx, name in enumerate(getattr(self, "input_names", []) or []):
                    try:
                        arr_idx, _count = _element_enabled_index_for_input_row(
                            self.poly_node,
                            row_idx,
                            input_names=getattr(self, "input_names", None),
                        )
                        if arr_idx is None or arr_idx >= len(desired_values):
                            continue
                        self._remember_input_active_state(name, _element_enabled_value_to_ui_active(desired_values[arr_idx], default=True))
                    except Exception:
                        pass

                self._queue_element_enabled_snapshot_reapply(
                    desired_values,
                    target_indices=target_indices,
                    target_active=active,
                )


            try:
                cmds.dgdirty(self.poly_node)
            except Exception:
                pass
            try:
                mel.eval('if(`exists gameVertexCountRefresh`) { gameVertexCountRefresh(); };')
            except Exception:
                pass
            try:
                cmds.refresh(force=True)
            except Exception:
                pass

        finally:
            if undo_open:
                try:
                    cmds.undoInfo(closeChunk=True)
                except Exception:
                    pass
            try:
                kept = [x for x in original_selection if cmds.objExists(x)]
                if kept:
                    cmds.select(kept, r=True)
                else:
                    cmds.select(clear=True)
            except Exception:
                pass


        self._refresh_hide_cutters_button_state()
        try:
            if changed_count:
                cmds.inViewMessage(
                    amg="Input enabled: <hl>{}</hl> on <hl>{}</hl> row(s)".format("ON" if active else "OFF", changed_count),
                    pos="midCenterTop",
                    fade=True,
                )
            else:
                cmds.warning("Input enabled : impossible d'ecrire elementEnabled/ee sur cette row.")
        except Exception:
            pass


def _clamp_dialog_to_screen(widget):

    if QtWidgets is None or widget is None:
        return
    try:
        screen = widget.screen() or QtWidgets.QApplication.primaryScreen()
        if not screen:
            return
        avail = screen.availableGeometry()
        w = min(widget.width(), max(widget.minimumWidth(), avail.width() - 40))
        h = min(widget.height(), max(widget.minimumHeight(), avail.height() - 40))
        if w != widget.width() or h != widget.height():
            widget.resize(w, h)
        geo = widget.geometry()
        x = min(max(geo.x(), avail.left() + 10), avail.right() - widget.width() - 10)
        y = min(max(geo.y(), avail.top() + 10), avail.bottom() - widget.height() - 10)
        widget.move(x, y)
    except Exception:
        pass


def _center_dialog_on_maya_screen(widget):

    if QtWidgets is None or QtCore is None or widget is None:
        return
    try:
        app = QtWidgets.QApplication.instance()
        if app is None:
            return

        screen = None
        try:
            if hasattr(app, "screenAt") and QtGui is not None:
                screen = app.screenAt(QtGui.QCursor.pos())
        except Exception:
            screen = None
        if screen is None:
            try:
                screen = widget.screen()
            except Exception:
                screen = None
        if screen is None:
            screen = QtWidgets.QApplication.primaryScreen()
        if screen is None:
            return

        avail = screen.availableGeometry()
        frame = widget.frameGeometry()
        if frame.width() <= 0 or frame.height() <= 0:
            frame = QtCore.QRect(0, 0, max(widget.width(), widget.minimumWidth()), max(widget.height(), widget.minimumHeight()))

        center = avail.center()
        try:
            main = maya_main_window()
            if main is not None and _qt_object_is_valid(main) and main.isVisible():
                main_geo = main.frameGeometry()
                if main_geo.isValid() and avail.intersects(main_geo):
                    center = main_geo.center()
        except Exception:
            pass

        frame.moveCenter(center)
        x = min(max(frame.x(), avail.left() + 10), avail.right() - frame.width() - 10)
        y = min(max(frame.y(), avail.top() + 10), avail.bottom() - frame.height() - 10)
        widget.move(int(x), int(y))
        _clamp_dialog_to_screen(widget)
    except Exception:
        pass


