    wrote_any = False
    for attr in ("elementEnabled", "ee"):
        try:
            if not _polyboolean_data_attr_exists(poly_node, attr):
                continue
            wrote_any = _int32_array_set(poly_node, attr, values) or wrote_any
        except Exception:
            pass
    return bool(wrote_any)


def _set_polyboolean_element_enabled_value(poly_node, idx, active, desired_count=None, fallback_values=None):

    if not maya_available() or not poly_node or not cmds.objExists(poly_node):
        return False
    try:
        idx = int(idx)
    except Exception:
        return False
    try:
        count = int(desired_count) if desired_count is not None else _polyboolean_input_count_hint(poly_node, idx)
    except Exception:
        count = _polyboolean_input_count_hint(poly_node, idx)
    values = _merge_element_enabled_values(
        poly_node,
        max(count, idx + 1),
        overrides={idx: bool(active)},
        fallback_values=fallback_values,
    )
    return bool(_set_polyboolean_element_enabled_values(poly_node, values))


