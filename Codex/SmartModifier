def _polyboolean_int_array_lengths(poly_node, attrs=("elementEnabled", "ee", "operation", "op")):

    result = []
    if not maya_available() or not poly_node or not cmds.objExists(poly_node):
        return result
    for attr in attrs:
        try:
            plug = poly_node + "." + attr
            try:
                attr_type = cmds.getAttr(plug, type=True)
            except Exception:
                attr_type = ""


            if attr_type and str(attr_type).lower() != "int32array":
                continue
            values = _int32_array_get(poly_node, attr)
            if values:
                result.append((attr, len(values)))
