def _decode_mime_bytes(data):
    try:
        raw = bytes(data)
    except Exception:
        try:
            raw = data.data()
        except Exception:
            raw = b""
    if not raw:
        return ""
    for enc in ("utf-8", "utf-16", "latin-1"):
        try:
            txt = raw.decode(enc, errors="ignore")
            if txt:
                return txt
        except Exception:
            pass
    return ""


def _names_from_mime_data(mime_data):

    names = []
    if mime_data is None:
        return names


    try:
        text = mime_data.text()
        if text:
            names.extend(re.split(r"[\r\n\t,; ]+", text))
    except Exception:
        pass


    try:
        for url in mime_data.urls() or []:
            try:
                names.append(url.toLocalFile() or url.toString())
            except Exception:
                pass
    except Exception:
        pass


    try:
        formats = list(mime_data.formats())
    except Exception:
        formats = []
    for fmt in formats:
        try:
            payload = _decode_mime_bytes(mime_data.data(fmt))
        except Exception:
            payload = ""
        if not payload:
            continue


        tokens = re.findall(r"(?:\|?[A-Za-z_][A-Za-z0-9_:\|]*)(?:\.[A-Za-z_][A-Za-z0-9_]*)?", payload)
        names.extend(tokens)

    return _unique_keep_order([_normalize_drag_candidate_name(x) for x in names])


def _objects_from_drop_event(event, exclude=None, skip_existing=None):

    exclude = exclude or []
    skip_existing = skip_existing or []
    names = []
    try:
        names = _names_from_mime_data(event.mimeData())
    except Exception:
        names = []

    objects = _mesh_transforms_from_names(names, exclude=exclude, skip_existing=skip_existing)
    if objects:
        return objects


    return _current_selected_mesh_transforms(exclude=exclude, skip_existing=skip_existing)


