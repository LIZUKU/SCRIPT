def _flatten_maya_int_array(value):

    if value is None:
        return []
    if isinstance(value, (list, tuple)):
        if len(value) == 1 and isinstance(value[0], (list, tuple)):
            return [int(x) for x in value[0]]
        return [int(x) for x in value]
    try:
        return [int(value)]
    except Exception:
        return []


