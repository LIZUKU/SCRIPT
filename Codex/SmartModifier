        self._show_result = True
        self._knob = 1.0
        self._anim = None
        self.setObjectName("ModifierModeToggle")
        self.setCursor(QtGui.QCursor(QT_POINTING_HAND))
        self.setMinimumSize(88, 24)
        self.setMaximumHeight(24)
        self.setToolTip("Toggle Edit Base / Show Result")

    def _get_knob(self):
        return float(self._knob)

    def _set_knob(self, value):
        self._knob = max(0.0, min(1.0, float(value)))
        self.update()

    knobPosition = QtCore.Property(float, _get_knob, _set_knob)

    def setMode(self, show_result=True, animated=True):
        show_result = bool(show_result)
        target = 1.0 if show_result else 0.0
        self._show_result = show_result
        if not animated:
            self._set_knob(target)
            return
        try:
            if self._anim:
                self._anim.stop()
            self._anim = QtCore.QPropertyAnimation(self, b"knobPosition")
            self._anim.setDuration(135)
            self._anim.setStartValue(float(self._knob))
            self._anim.setEndValue(target)
            try:
                self._anim.setEasingCurve(QtCore.QEasingCurve.OutCubic)
            except Exception:
                pass
            self._anim.start()
        except Exception:
            self._set_knob(target)

    def mouseReleaseEvent(self, event):
        try:
            if self.rect().contains(_qt_event_local_pos(event)):
                self.modeChanged.emit(not self._show_result)
                return
        except Exception:
            self.modeChanged.emit(not self._show_result)
            return
        QtWidgets.QWidget.mouseReleaseEvent(self, event)

    def _draw_edit_icon(self, p, rect):
        p.save()
        p.setRenderHint(QT_ANTIALIAS, True)
        cx = rect.center().x()
        cy = rect.center().y()
        p.setPen(QtGui.QPen(_qcolor("#dedede"), 1.35))
        p.setBrush(QtGui.QBrush(_qcolor("#363636")))
        box = QtCore.QRectF(cx - 8, cy - 7, 13, 13)
        p.drawRect(box)
        p.setPen(QtGui.QPen(_qcolor("#e05252"), 1.6))
        for pt in (box.topLeft(), box.topRight(), box.bottomLeft(), box.bottomRight()):
            p.drawEllipse(QtCore.QRectF(pt.x() - 1.7, pt.y() - 1.7, 3.4, 3.4))
        p.setPen(QtGui.QPen(_qcolor("#f0f0f0"), 1.2))
        p.drawLine(QtCore.QPointF(cx + 2, cy + 6), QtCore.QPointF(cx + 9, cy - 1))
        p.drawLine(QtCore.QPointF(cx + 7, cy - 3), QtCore.QPointF(cx + 10, cy))
        p.restore()

    def _draw_result_icon(self, p, rect):
        p.save()
        p.setRenderHint(QT_ANTIALIAS, True)
        cx = rect.center().x()
        cy = rect.center().y()
        eye = QtGui.QPainterPath()
        eye.moveTo(cx - 11, cy)
        eye.cubicTo(cx - 6, cy - 7, cx + 6, cy - 7, cx + 11, cy)
        eye.cubicTo(cx + 6, cy + 7, cx - 6, cy + 7, cx - 11, cy)
        p.setPen(QtGui.QPen(_qcolor("#dedede"), 1.35))
        p.setBrush(QtGui.QBrush(_qcolor("#333333")))
        p.drawPath(eye)
        p.setPen(QtGui.QPen(_qcolor("#e05252"), 1.0))
        p.setBrush(QtGui.QBrush(_qcolor("#e05252")))
        p.drawEllipse(QtCore.QRectF(cx - 3.0, cy - 3.0, 6.0, 6.0))
        p.setPen(QtGui.QPen(_qcolor("#ffffff"), 1.1))
        p.drawLine(QtCore.QPointF(cx + 7, cy + 6), QtCore.QPointF(cx + 12, cy + 1))
        p.drawLine(QtCore.QPointF(cx + 12, cy + 1), QtCore.QPointF(cx + 17, cy + 8))
        p.restore()

    def paintEvent(self, event):
        p = QtGui.QPainter(self)
        p.setRenderHint(QT_ANTIALIAS, True)
        r = QtCore.QRectF(self.rect()).adjusted(0.5, 0.5, -0.5, -0.5)
        radius = 3.0
        p.setPen(QtGui.QPen(_qcolor("#101010"), 1.0))
        p.setBrush(QtGui.QBrush(_qcolor("#2a2a2a")))
        p.drawRoundedRect(r, radius, radius)
        half_w = r.width() * 0.5
        knob_x = r.left() + (half_w * self._knob)
        knob = QtCore.QRectF(knob_x + 1.5, r.top() + 1.5, half_w - 3.0, r.height() - 3.0)
        # Red active highlight instead of neutral grey.
        if self._show_result:
            knob_border = _qcolor("#b43d3d")
            knob_fill = _qcolor("#5a1b1b")
        else:
            knob_border = _qcolor("#a83838")
            knob_fill = _qcolor("#4c1717")
        p.setPen(QtGui.QPen(knob_border, 1.0))
        p.setBrush(QtGui.QBrush(knob_fill))
        p.drawRoundedRect(knob, radius, radius)
        left = QtCore.QRectF(r.left(), r.top(), half_w, r.height())
        right = QtCore.QRectF(r.left() + half_w, r.top(), half_w, r.height())
        self._draw_edit_icon(p, left)
        self._draw_result_icon(p, right)
        p.end()



