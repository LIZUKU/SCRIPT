    def _capture_scale_baselines(self):

        skip_names = set([
            "InputListFrame", "InputScroll", "InputScrollContent", "InputScrollViewport", "EmptyInputState",
            "SectionShell", "SettingsBody", "ResultBarFrame", "BodyScrollContent",
        ])
        try:
            widgets = [w for w in self.findChildren(QtWidgets.QWidget) if w is not None]
        except Exception:
            widgets = []
        for w in widgets:
            try:
                if w is self or w.objectName() in skip_names:
                    continue
                if w.property("_uiScaleBaseCaptured"):
                    continue
                mn = w.minimumSize()
                mx = w.maximumSize()
                w.setProperty("_uiScaleBaseCaptured", True)
                w.setProperty("_uiScaleBaseMinW", int(mn.width()))
                w.setProperty("_uiScaleBaseMinH", int(mn.height()))
                w.setProperty("_uiScaleBaseMaxW", int(mx.width()))
                w.setProperty("_uiScaleBaseMaxH", int(mx.height()))
            except Exception:
                pass

    def _apply_scaled_widget_sizes(self):

        self._capture_scale_baselines()
        max_unlimited = 16700000
        try:
            widgets = [w for w in self.findChildren(QtWidgets.QWidget) if w is not None]
        except Exception:
            widgets = []
        for w in widgets:
            try:
                if not w.property("_uiScaleBaseCaptured"):
                    continue
                min_w = int(w.property("_uiScaleBaseMinW") or 0)
                min_h = int(w.property("_uiScaleBaseMinH") or 0)
                max_w = int(w.property("_uiScaleBaseMaxW") or 16777215)
                max_h = int(w.property("_uiScaleBaseMaxH") or 16777215)
                fixed_w = (max_w < max_unlimited and min_w == max_w)
                fixed_h = (max_h < max_unlimited and min_h == max_h)


                new_min_w = self._scaled_w(min_w) if min_w > 0 else 0
                new_min_h = self._scaled(min_h) if min_h > 0 else 0
                new_max_w = self._scaled_w(max_w) if max_w < max_unlimited else 16777215
                new_max_h = self._scaled(max_h) if max_h < max_unlimited else 16777215
                if fixed_w and fixed_h:
                    w.setFixedSize(new_max_w, new_max_h)
                elif fixed_w:
                    w.setFixedWidth(new_max_w)
                    if min_h > 0:
                        w.setMinimumHeight(new_min_h)
                    if max_h < max_unlimited:
                        w.setMaximumHeight(new_max_h)
                elif fixed_h:
                    w.setFixedHeight(new_max_h)
                    if min_w > 0:
                        w.setMinimumWidth(new_min_w)
                    if max_w < max_unlimited:
                        w.setMaximumWidth(new_max_w)
                else:
                    if min_w > 0 or min_h > 0:
                        w.setMinimumSize(new_min_w, new_min_h)
