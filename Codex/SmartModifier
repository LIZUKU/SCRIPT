    def _replace_setting_widget(self, row, old_widget, new_widget, label_text=None):
        try:
            if label_text:
                item = self.settings_layout.itemAtPosition(int(row), 0)
                lab = item.widget() if item else None
                if lab and hasattr(lab, "setText"):
                    lab.setText(label_text)
        except Exception:
            pass
        try:
            self.settings_layout.removeWidget(old_widget)
            old_widget.setParent(None)
            old_widget.hide()
        except Exception:
            pass
        try:
            self.settings_layout.addWidget(new_widget, int(row), 1)
        except Exception:
            pass

