def make_icon(kind, label, size=18):
    pm = QtGui.QPixmap(size, size)
    pm.fill(QT_TRANSPARENT)
    p = QtGui.QPainter(pm)
    rect = QtCore.QRect(0, 0, size, size)
    if kind == "operation":
        draw_operation_icon(p, rect, label)
    else:
        draw_display_icon(p, rect, label)
    p.end()
    return QtGui.QIcon(pm)


class NativeMenuItem(QtWidgets.QFrame):

    clicked = QtCore.Signal(str)
    hoverChanged = QtCore.Signal(str, bool)

    def __init__(self, kind, label, parent=None):
        super(NativeMenuItem, self).__init__(parent)
        self.kind = kind
        self.label = label
        self._highlighted = False
        self.setMouseTracking(True)
        self.setCursor(QtGui.QCursor(QT_POINTING_HAND))
        self.setFixedHeight(24)
        self.setMinimumWidth(174 if kind == "operation" else 150)
        self.setSizePolicy(QtWidgets.QSizePolicy.Expanding, QtWidgets.QSizePolicy.Fixed)
        try:
            self.setAttribute(QT_WA_STYLED_BACKGROUND, False)
        except Exception:
            pass

    def setHighlighted(self, highlighted):
        highlighted = bool(highlighted)
        if self._highlighted == highlighted:
            return
        self._highlighted = highlighted
        self.update()

    def enterEvent(self, event):
        self.hoverChanged.emit(self.label, True)
        QtWidgets.QFrame.enterEvent(self, event)

    def leaveEvent(self, event):
        self.hoverChanged.emit(self.label, False)
        QtWidgets.QFrame.leaveEvent(self, event)

    def mouseReleaseEvent(self, event):
        try:
            if self.rect().contains(_qt_event_local_pos(event)):
                self.clicked.emit(self.label)
                return
        except Exception:
            self.clicked.emit(self.label)
            return
        QtWidgets.QFrame.mouseReleaseEvent(self, event)

    def paintEvent(self, event):
        p = QtGui.QPainter(self)
        p.setRenderHint(QT_ANTIALIAS, True)
        rect = self.rect()
        if self._highlighted:
            p.fillRect(rect.adjusted(1, 0, -1, 0), _qcolor("#3a1010"))
            p.setPen(QtGui.QPen(_qcolor("#6a2424"), 1))
            p.drawLine(rect.left() + 1, rect.top(), rect.right() - 1, rect.top())
            p.setPen(QtGui.QPen(_qcolor("#1a0808"), 1))
            p.drawLine(rect.left() + 1, rect.bottom(), rect.right() - 1, rect.bottom())
        else:
            p.fillRect(rect, _qcolor("#202020"))

        icon_rect = QtCore.QRect(6, 2, 18, 18)
        if self.kind == "operation":
            draw_operation_icon(p, icon_rect, self.label)
        else:
            draw_display_icon(p, icon_rect, self.label)

        p.setPen(QtGui.QPen(_qcolor("#f0f0f0" if self._highlighted else "#b0b0b0"), 1))
        p.drawText(QtCore.QRect(30, 0, rect.width() - 34, rect.height()),
                   QT_ALIGN_LEFT | QT_ALIGN_VCENTER, self.label)
        p.end()

class IconMenuButton(QtWidgets.QToolButton):
    valueChanged = QtCore.Signal(str)

    def __init__(self, kind, labels, current_label=None, parent=None):
        super(IconMenuButton, self).__init__(parent)
        self.kind = kind
        self.labels = labels
        self.current_label = current_label or (labels[0] if labels else "")
        self._menu_widgets = []
        self._menu_hover_label = None


        self.setFixedSize(54 if kind == "operation" else 54, 28)
        self.setPopupMode(QtWidgets.QToolButton.InstantPopup)
        self.setAutoRaise(True)
        self.setCursor(QtGui.QCursor(QT_POINTING_HAND))
        self.menu_obj = QtWidgets.QMenu(self)
        self.menu_obj.setObjectName("InputIconMenu")
        self.menu_obj.setMouseTracking(True)
        self.menu_obj.setStyleSheet(r"""
QMenu#InputIconMenu {
    background-color: #1e1e1e;
    color: #808080;
    border: 1px solid #111111;
    padding: 4px;
}
QMenu#InputIconMenu::item {
    background-color: transparent;
    min-height: 22px;
    padding: 0px;
    margin: 0px;
}
QMenu#InputIconMenu::item:selected {
    background-color: #3a1010;
    color: #f0f0f0;
}
""")
        self.setMenu(self.menu_obj)
        self._build_menu()
        self.menu_obj.aboutToShow.connect(self._on_menu_about_to_show)
        self.menu_obj.aboutToHide.connect(self._on_menu_about_to_hide)
        self.setToolTip(self.current_label)

    def _build_menu(self):
        self.menu_obj.clear()
        self._menu_widgets = []
        for label in self.labels:
            action = QtWidgets.QWidgetAction(self.menu_obj)
            item = NativeMenuItem(self.kind, label, self.menu_obj)
            item.clicked.connect(self._on_menu_item_clicked)
            item.hoverChanged.connect(self._on_menu_item_hover_changed)
            action.setDefaultWidget(item)
            self.menu_obj.addAction(action)
            self._menu_widgets.append(item)

    def _queue_refresh_menu_hover_from_cursor(self):
        if QtCore is None:
            return
        btn_ref = weakref.ref(self)

        def _safe_call():
            btn = btn_ref()
            if btn is None or not _qt_object_is_valid(btn):
                return
            try:
                btn._refresh_menu_hover_from_cursor()
            except RuntimeError as exc:
                if "already deleted" not in str(exc):
                    raise

        QtCore.QTimer.singleShot(0, _safe_call)

    def _on_menu_about_to_show(self):
        if not _qt_object_is_valid(self):
            return

        self._menu_hover_label = None
        self._refresh_menu_highlights()
        self._queue_refresh_menu_hover_from_cursor()

    def _on_menu_about_to_hide(self):
        if not _qt_object_is_valid(self):
            return
        self._menu_hover_label = None
        self._refresh_menu_highlights()

    def _on_menu_item_hover_changed(self, label, inside):
        if not _qt_object_is_valid(self):
            return
        if inside:
            self._menu_hover_label = label
            self._refresh_menu_highlights()
        else:

            self._queue_refresh_menu_hover_from_cursor()

    def _refresh_menu_hover_from_cursor(self):
        if not _qt_object_is_valid(self):
            return
        found = None
        try:
            global_pos = QtGui.QCursor.pos()
            for item in list(self._menu_widgets):
                if not _qt_object_is_valid(item):
                    continue
                if item.isVisible() and item.rect().contains(item.mapFromGlobal(global_pos)):
                    found = item.label
                    break
        except RuntimeError as exc:
            if "already deleted" in str(exc):
                return
            found = None
        except Exception:
            found = None
        self._menu_hover_label = found
        self._refresh_menu_highlights()

    def _refresh_menu_highlights(self):
        if not _qt_object_is_valid(self):
            return


        for item in list(self._menu_widgets):
            if not _qt_object_is_valid(item):
                continue
            highlighted = (item.label == self._menu_hover_label) or (
                self._menu_hover_label is None and item.label == self.current_label and _qt_object_is_valid(self.menu_obj) and self.menu_obj.isVisible()
            )
            item.setHighlighted(highlighted)

    def _on_menu_item_clicked(self, label):
        self.set_value(label, emit_signal=True)
        try:
            self.menu_obj.close()
        except Exception:
            pass

    def set_value(self, label, emit_signal=False):
        self.current_label = label
        self.setToolTip(label)
        self._refresh_menu_highlights()
        self.update()
        if emit_signal:
            self.valueChanged.emit(label)

    def paintEvent(self, event):
        p = QtGui.QPainter(self)
        p.setRenderHint(QT_ANTIALIAS, True)
        parent_row = self.parent()
        row_is_highlighted = bool(getattr(parent_row, "isHighlighted", lambda: False)())
        row_is_selected = bool(getattr(parent_row, "_selected", False))


        button_rect = self.rect().adjusted(1, 4, -1, -4)
        label_norm = str(getattr(self, "current_label", "") or "").strip().lower()
        is_modifier_mode_btn = (self.kind == "display" and label_norm in ("node", "show result", "edit base"))

        if is_modifier_mode_btn:
            if row_is_selected:
                bg = _qcolor("#4a1717")
                border = _qcolor("#8a3232")
            elif row_is_highlighted:
                bg = _qcolor("#431515")
                border = _qcolor("#7a2b2b")
            elif self.underMouse():
                bg = _qcolor("#501818")
                border = _qcolor("#a43b3b")
            else:
                bg = _qcolor("#3a1212")
                border = _qcolor("#6a2525")
        else:
            if row_is_selected:
                bg = _qcolor("#352b2b")
                border = _qcolor("#5e4848")
            elif row_is_highlighted:
                bg = _qcolor("#302d2d")
                border = _qcolor("#4d4545")
            elif self.underMouse():
                bg = _qcolor("#353535")
                border = _qcolor("#505050")
            else:
                bg = _qcolor("#2d2d2d")
                border = _qcolor("#3d3d3d")

        p.setPen(QtGui.QPen(border, 1))
        p.setBrush(QtGui.QBrush(bg))
        p.drawRoundedRect(button_rect, 3, 3)

        icon_size = 20
        icon_rect = QtCore.QRect(5, max(1, (self.height() - icon_size) // 2), icon_size, icon_size)
        if self.kind == "operation":
            draw_operation_icon(p, icon_rect, self.current_label)
        else:
            draw_display_icon(p, icon_rect, self.current_label)

        arrow_x = self.width() - 12
        arrow_y = self.height() // 2 - 1
        arrow_col = _qcolor("#ffffff" if row_is_highlighted else "#e0e0e0")
        _draw_down_arrow(p, arrow_x, arrow_y, arrow_col)
        p.end()

