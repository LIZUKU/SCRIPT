        row_is_highlighted = bool(getattr(parent_row, "isHighlighted", lambda: False)())

        if self._checked:
            bg = _qcolor("#331414") if row_is_highlighted else _qcolor("#251414")
            border = _qcolor("#6a2525") if row_is_highlighted else _qcolor("#4a2020")
            outline = _qcolor("#ff6a6a")
            sclera = _qcolor("#402727") if row_is_highlighted else _qcolor("#362121")
            iris = _qcolor("#ff5a5a")
            pupil = _qcolor("#ffe0e0")
            slash = _qcolor("#ff9a9a")
        else:
            bg = _qcolor("#282828") if row_is_highlighted else _qcolor("#222222")
            border = _qcolor("#4f4f4f") if row_is_highlighted else _qcolor("#3b3b3b")
            outline = _qcolor("#c3c3c3")
            sclera = _qcolor("#404040") if row_is_highlighted else _qcolor("#343434")
