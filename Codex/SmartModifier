def find_result_transform(poly_node):

    if not maya_available() or not poly_node or not cmds.objExists(poly_node):
        return "polySurface1"

    input_shorts = _direct_input_transform_short_names(poly_node)
    ranked = []
    seen = set()

    def _add_candidate_from_node(node, rank=10):
        if not node or not cmds.objExists(node):
            return
        try:
            ntype = _safe_node_type(node)
            transforms = []
            if ntype == "mesh":
                transforms.extend(cmds.listRelatives(node, parent=True, fullPath=False) or [])
            elif ntype == "transform":
                transforms.append(node)
            else:

                tr = _as_transform(node)
                if tr and cmds.objExists(tr) and _safe_node_type(tr) == "transform":
                    transforms.append(tr)

            for tr in transforms:
                if not tr or not cmds.objExists(tr):
                    continue
                short = _short_name(tr)
                if not short or short in seen:
                    continue
                if short in input_shorts:
                    continue
                if _safe_node_type(tr) != "transform" or not _has_mesh_shape(tr):
                    continue
                seen.add(short)
                ranked.append((int(rank), short))
        except Exception:
            pass


    try:
        conn = cmds.listConnections(poly_node, s=False, d=True, plugs=True, connections=True) or []
    except Exception:
        conn = []
    for i in range(0, len(conn), 2):
        if i + 1 >= len(conn):
            continue
        a, b = conn[i], conn[i + 1]
        if str(a).startswith(poly_node + "."):
            dest = b
        elif str(b).startswith(poly_node + "."):
            dest = a
        else:
            continue
        dest_node = str(dest).split(".", 1)[0]
        _add_candidate_from_node(dest_node, rank=0)


    try:
        cons = cmds.listConnections(poly_node, s=False, d=True, plugs=False) or []
    except Exception:
        cons = []
    for c in cons:
        _add_candidate_from_node(c, rank=5)


    try:
        future = cmds.listHistory(poly_node, future=True, pruneDagObjects=False) or []
    except Exception:
        future = []
    for n in future:
        _add_candidate_from_node(n, rank=20)

    if ranked:
        ranked.sort(key=lambda x: x[0])
        return ranked[0][1]


    return "polySurface1"


def find_input_connection_indices(poly_node):

    mapping = {}
    if not maya_available() or not poly_node or not cmds.objExists(poly_node):
        return mapping

    try:
        conn = cmds.listConnections(poly_node, s=True, d=False, plugs=True, connections=True) or []
    except Exception:
        conn = []


    pairs = []
    for i in range(0, len(conn), 2):
        if i + 1 < len(conn):
            a, b = conn[i], conn[i + 1]
            if str(a).startswith(poly_node + "."):
                dest, src = a, b
            elif str(b).startswith(poly_node + "."):
                dest, src = b, a
            else:
                continue
            pairs.append((dest, src))

    for dest, src in pairs:
        m = re.search(r"\[(\d+)\]", dest)
        if not m:
            continue
        idx = int(m.group(1))
        src_node = src.split(".")[0]
        transform = _as_transform(src_node)
        short = _short_name(transform)
        if short and short not in mapping:
            mapping[short] = idx

    return mapping


def find_input_transforms(poly_node):

    if not maya_available() or not poly_node or not cmds.objExists(poly_node):
        return ["pCube4", "pCube3"]

    result = find_result_transform(poly_node)
    inputs = []

    try:
        srcs = cmds.listConnections(poly_node, s=True, d=False, plugs=False) or []
    except Exception:
        srcs = []

    for s in srcs:
        if not cmds.objExists(s):
            continue
        transform = _as_transform(s)
        if transform:
            short = _short_name(transform)
            if short != result and short not in inputs and _safe_node_type(transform) == "transform":
                inputs.append(short)


    try:
        index_map = find_input_connection_indices(poly_node)
        if index_map:
            inputs.sort(key=lambda x: index_map.get(_short_name(x), 999999))
    except Exception:
        pass


    if not inputs:
        try:
            hist = cmds.listHistory(poly_node, future=False, pruneDagObjects=False) or []
        except Exception:
            hist = []
        for h in hist:
            if _safe_node_type(h) == "mesh":
                parents = cmds.listRelatives(h, parent=True, fullPath=False) or []
                if parents:
                    short = _short_name(parents[0])
                    if short != result and short not in inputs:
                        inputs.append(short)

    return inputs or ["pCube4", "pCube3"]


def _normalize_attr_name(name):
    return re.sub(r"[^a-z0-9]", "", str(name).lower())


def find_attr(node, candidates):

    if not maya_available() or not node or not cmds.objExists(node):
        return None

    for attr in candidates:
        try:
            if cmds.attributeQuery(attr, node=node, exists=True):
                return attr
        except Exception:
            pass

    try:
        attrs = cmds.listAttr(node) or []
    except Exception:
        attrs = []

    normalized_candidates = [_normalize_attr_name(x) for x in candidates]
    for attr in attrs:
        n_attr = _normalize_attr_name(attr)
        if n_attr in normalized_candidates:
            return attr

    for attr in attrs:
        n_attr = _normalize_attr_name(attr)
        for cand in normalized_candidates:
            if cand and (cand in n_attr or n_attr in cand):
                return attr

    return None


