    def _merge_cached_inactive_inputs(self, connected_inputs):

        inputs = list(connected_inputs or [])
        if not maya_available():
            return inputs
        try:
            key = self._operation_cache_key()
            active_cache = self._input_active_cache.get(key, {})
            inactive_order = list(self._inactive_input_order_cache.get(key, []) or [])
        except Exception:
            return inputs
        connected_short = set(_short_name(x) for x in inputs if x)
        kept_order = []
        for name in inactive_order:
            try:
                short = _short_name(name)
                if active_cache.get(short, True):
                    continue
                if short in connected_short:
                    continue
                if not cmds.objExists(name):
                    continue
                transform = _as_transform(name)
                if not transform or not cmds.objExists(transform):
                    continue
                if _safe_node_type(transform) != "transform" or not _has_mesh_shape(transform):
                    continue
                inputs.append(_short_name(transform))
                kept_order.append(_short_name(transform))
            except Exception:
                pass
        try:
            self._inactive_input_order_cache[key] = kept_order
        except Exception:
            pass
        return _unique_keep_order(inputs)

