def _label_to_index_with_enum(node, attr, label, ui_labels):
    def norm_label(s):
        return re.sub(r"[^a-z0-9]", "", str(s).lower())

    enum_items = _enum_items(node, attr)
    target_index = None
    if enum_items:
        wanted = norm_label(label)
        for i, item in enumerate(enum_items):
            if norm_label(item) == wanted:
                target_index = i
                break
        if target_index is None:
            for i, item in enumerate(enum_items):
                ni = norm_label(item)
                if wanted in ni or ni in wanted:
                    target_index = i
                    break

    if target_index is None:
        try:
            target_index = ui_labels.index(label)
        except Exception:
            target_index = 0
    return int(target_index)


