# ---------------------------------------------------------------------------
# v6.11 stability patch: stable row order + non-pushing Shell thickness
# ---------------------------------------------------------------------------
# Two important rules live here, after every older compatibility patch:
# 1) Modifier rows are sorted by the actual DG dependency chain instead of raw
#    listHistory order. Maya can return history in a different order when the
#    visible shape toggles between Edit Base and Show Result, which made rows look
#    inverted even though the DG stack itself was unchanged.
# 2) Shell UI Thickness drives polyExtrudeFace.thickness again, while Local
#    Translate Z stays separate. Driving Thickness through localTranslateZ made the
#    shell visibly push whole faces forward at the default setting.

_SM_PREV_STACK_NODES_V611 = _ms_stack_nodes


def _sm_node_connections(node, source=False, destination=True):
    if not node or not ex(node):
        return []
    out = []
    try:
        raw = c.listConnections(node, s=source, d=destination, plugs=False) or []
    except Exception:
        raw = []
    for item in raw:
        try:
            if not item or not ex(item):
                continue
            item = lg(item)
        except Exception:
            pass
        if item and item not in out:
            out.append(item)
    return out


def _sm_node_is_upstream_of(upstream, downstream, max_steps=200):
    if not upstream or not downstream or not ex(upstream) or not ex(downstream):
        return False
    try:
        upstream = lg(upstream)
        downstream = lg(downstream)
    except Exception:
        pass
    if upstream == downstream:
        return False
    seen = set([upstream])
    todo = list(_sm_node_connections(upstream, source=False, destination=True))
    steps = 0
    while todo and steps < int(max_steps):
        steps += 1
        node = todo.pop(0)
        if not node or node in seen:
            continue
        if node == downstream:
            return True
        seen.add(node)
        try:
            if c.nodeType(node) in ("mesh", "transform") and node != downstream:
                # DAG shape/transform fan-out can be large and is not useful for
                # ordering history nodes once we have left the modifier chain.
                continue
        except Exception:
            pass
        todo.extend(_sm_node_connections(node, source=False, destination=True))
    return False


def _sm_sort_modifier_nodes_by_dg(nodes):
    ordered = []
    for node in nodes or []:
        if not node or not ex(node) or node in ordered:
            continue
        inserted = False
        for index, existing in enumerate(list(ordered)):
            try:
                if _sm_node_is_upstream_of(node, existing):
                    ordered.insert(index, node)
                    inserted = True
                    break
            except Exception:
                pass
        if not inserted:
            ordered.append(node)
    return ordered


def _ms_stack_nodes(t):
    try:
        raw_nodes = list(_SM_PREV_STACK_NODES_V611(t) or [])
    except Exception:
        raw_nodes = []
    return _sm_sort_modifier_nodes_by_dg(raw_nodes)


