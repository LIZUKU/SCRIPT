            base = QtWidgets.QTabBar.tabSizeHint(self, index)
        except Exception:
            base = QtCore.QSize(78, 22)
        h = max(20, int(self.height() or base.height() or 22))


        w = max(64, min(max(72, int(self.width() or base.width() or 78)), 140))
        return QtCore.QSize(w, h)

    def mouseDoubleClickEvent(self, event):

        try:
            idx = self.tabAt(_qt_event_local_pos(event))
        except Exception:
            idx = self.currentIndex()
        if idx is not None and idx >= 0:
            try:
                self.renameRequested.emit(int(idx))
                event.accept()
                return
            except Exception:
                pass
        try:
            QtWidgets.QTabBar.mouseDoubleClickEvent(self, event)
