def _merge_element_enabled_values(poly_node, desired_count, overrides=None, fallback_values=None):

    try:
        desired_count = max(1, int(desired_count))
    except Exception:
        desired_count = 1
    overrides = overrides or {}

    values = []

    try:
        known = _polyboolean_known_element_enabled_attr_values(poly_node)
        if known:
            known.sort(key=lambda item: len(item[1]), reverse=True)
            values = list(known[0][1])
    except Exception:
        values = []


    if not values and fallback_values:
        try:
            values = _normalize_element_enabled_storage_values(fallback_values)
        except Exception:
            values = []


    if not values:
        values = [_ui_active_to_element_enabled_value(True)] * desired_count

    while len(values) < desired_count:
        values.append(_ui_active_to_element_enabled_value(True))

    for idx, active in overrides.items():
        try:
            idx = int(idx)
        except Exception:
            continue
        if idx < 0:
            continue
        while len(values) <= idx:
            values.append(_ui_active_to_element_enabled_value(True))
        values[idx] = _ui_active_to_element_enabled_value(active)

    return _normalize_element_enabled_storage_values(values)


def _set_polyboolean_element_enabled_values(poly_node, values):

