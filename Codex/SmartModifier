        if not maya_available():
            return

        if not self.poly_node or not cmds.objExists(self.poly_node):


            self.poly_node = find_polyboolean_from_selection()

        if not self.poly_node or not cmds.objExists(self.poly_node):
            cmds.warning("Drop impossible : aucun node polyBoolean actif trouve.")
            return


        filtered = _mesh_transforms_from_names(objects, exclude=self._drop_exclude_names(), skip_existing=self.input_names)
        if not filtered:
            cmds.warning("Drop ignore : aucun nouveau mesh valide detecte depuis l'Outliner.")
            return

        op_label = self._new_input_operation_label_for_add()
        anchor_name, anchor_index = self._add_insert_anchor_from_current_rows()
        ok = add_objects_to_boolean(self.poly_node, filtered, op_label)
        if ok:
            for obj in filtered:
                self._remember_input_operation_label(obj, op_label)
            _force_new_boolean_inputs_visible_wireframe(filtered)
            if anchor_name:
                self._reorder_new_inputs_below_anchor(filtered, anchor_name=anchor_name, anchor_index=anchor_index)
            _force_boolean_stack_inputs_display_mode(self.poly_node, filtered, DEFAULT_NEW_INPUT_DISPLAY_LABEL)
            self.refresh_from_scene()
            self._apply_cached_input_operation_icons()
            self._refit_after_input_stack_change()

            wanted = set(_short_name(x) for x in filtered)
            for i, name in enumerate(self.input_names):
                if _short_name(name) in wanted:
                    self._set_selected_row(i)
                    break
        else:
            self.refresh_from_scene()

