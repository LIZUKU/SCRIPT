# ---------------------------------------------------------------------------
# v6.9 Shell neutral extrude transform fix
# ---------------------------------------------------------------------------
# Maya polyExtrudeFace stores many hidden transform-style attributes. If a user
# previously used the native Extrude manipulator, or if Maya keeps tool-state
# values, localScale/localTranslateX/Y/localRotate/random can stay non-neutral
# and make the extruded faces look enlarged or skewed. For a Shell modifier we
# only drive the requested native attributes: Local Translate Z, Divisions,
# Thickness, Offset and Keep Faces Together. Everything else is reset to neutral.


def _sm_set_attr_if_exists(node, attr_name, value):
    if not ex(node):
        return False
    try:
        if c.attributeQuery(attr_name, n=node, ex=True):
            c.setAttr(node + "." + attr_name, value)
            return True
    except Exception:
        pass
    return False


def _sm_set_double3_if_exists(node, attr_name, x, y, z):
    if not ex(node):
        return False
    try:
        if c.attributeQuery(attr_name, n=node, ex=True):
            c.setAttr(node + "." + attr_name, float(x), float(y), float(z), type="double3")
            return True
    except Exception:
        pass
    return False


def _sm_reset_shell_extrude_hidden_transform_attrs(node, amount_z=0.0):
    """Reset polyExtrudeFace attrs that are not exposed in SmartModifier Shell UI."""
    if not ex(node):
        return
    try:
        c.lockNode(node, l=False)
    except Exception:
        pass

    # Compound attrs first when Maya exposes them.
    _sm_set_double3_if_exists(node, "localTranslate", 0.0, 0.0, float(amount_z))
    _sm_set_double3_if_exists(node, "localRotate", 0.0, 0.0, 0.0)
    _sm_set_double3_if_exists(node, "localScale", 1.0, 1.0, 1.0)
    _sm_set_double3_if_exists(node, "pivot", 0.0, 0.0, 0.0)

    # Child attrs fallback. These names are the important ones visible in Maya's
    # native polyExtrudeFace node/channel box.
    neutral = (
        ("localTranslateX", 0.0),
        ("localTranslateY", 0.0),
        ("localTranslateZ", float(amount_z)),
        ("localRotateX", 0.0),
        ("localRotateY", 0.0),
        ("localRotateZ", 0.0),
        ("localScaleX", 1.0),
        ("localScaleY", 1.0),
        ("localScaleZ", 1.0),
        ("pivotX", 0.0),
        ("pivotY", 0.0),
        ("pivotZ", 0.0),
        ("random", 0.0),
        ("twist", 0.0),
        ("taper", 1.0),
    )
    for attr_name, value in neutral:
        _sm_set_attr_if_exists(node, attr_name, value)


def _qd_set_shell_node(node, values=None):
    if not ex(node):
        return
    values = _qd_shell_values(values)
    try:
        c.lockNode(node, l=False)
    except Exception:
        pass
    try:
        _qd_force_shell_all_faces_component(node)
    except Exception:
        pass

    # Keep hidden transform channels neutral before applying the actual Shell
    # controls. This prevents unexpected face enlargement/skewing.
    _sm_reset_shell_extrude_hidden_transform_attrs(node, amount_z=float(values["amount"]))

    mapping = (
        ("keepFacesTogether", int(bool(values["keep_together"]))),
        ("divisions", int(values["divisions"])),
        ("localTranslateZ", float(values["amount"])),
        ("thickness", float(values["thickness"])),
        ("offset", float(values["offset"])),
        ("smoothingAngle", 30.0),
    )
    for attr_name, value in mapping:
        _sm_set_attr_if_exists(node, attr_name, value)

    # Explicitly keep local scale neutral after all writes too. Some Maya builds
    # can update compound/child attrs in a surprising order.
    for attr_name, value in (
        ("localTranslateX", 0.0),
