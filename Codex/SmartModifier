    def _on_input_reorder_drag_released(self, source_index, global_pos):
        if not self._row_reorder_active:
            self._clear_reorder_indicators()
            return
        target_index, side = self._row_reorder_target_from_global(global_pos)
        source_index = self._row_reorder_source_index
        source_indices = set(getattr(self, "_row_reorder_source_indices", set([source_index])))
        self._row_reorder_active = False
        self._row_reorder_source_index = -1
        self._row_reorder_source_indices = set()
        self._row_reorder_target_index = -1
        self._row_reorder_target_side = 0
        self._clear_reorder_indicators()
        if len(source_indices) > 1:
            self._apply_input_reorder_group(source_indices, target_index, side)
        else:
            self._apply_input_reorder(source_index, target_index, side)

    def _row_reorder_target_from_global(self, global_pos):
        if not self.input_rows:
            return -1, 0


        for i, row in enumerate(self.input_rows):
            try:
                local = row.mapFromGlobal(global_pos)
                if row.rect().contains(local):
                    return i, (-1 if local.y() < row.height() * 0.5 else 1)
            except Exception:
                pass


        try:
            y = self.scroll_content.mapFromGlobal(global_pos).y()
            first_y = self.input_rows[0].y()
            last = self.input_rows[-1]
            last_bottom = last.y() + last.height()
            if y <= first_y:
                return 0, -1
            if y >= last_bottom:
                return len(self.input_rows) - 1, 1
            for i, row in enumerate(self.input_rows):
                mid = row.y() + row.height() * 0.5
                if y < mid:
                    return i, -1
        except Exception:
            pass
        return -1, 0

    def _reordered_insert_index(self, source_index, target_index, side):
        if source_index < 0 or target_index < 0:
            return None
        if source_index >= len(self.input_names) or target_index >= len(self.input_names):
            return None
        insert_at = target_index if side < 0 else target_index + 1
        if source_index < insert_at:
            insert_at -= 1
        insert_at = max(0, min(len(self.input_names) - 1, insert_at))
        if insert_at == source_index:
            return None
        return insert_at

    def _apply_input_reorder(self, source_index, target_index, side):
        insert_at = self._reordered_insert_index(source_index, target_index, side)
        if insert_at is None:
            return False

        moved_name = self.input_names[source_index]
        undo_open = False
        try:
            if maya_available() and self.poly_node and cmds.objExists(self.poly_node):
                try:
                    cmds.undoInfo(openChunk=True, chunkName="UiBoolean Reorder Input")
                    undo_open = True
                except Exception:
                    pass
                ok = self._apply_polyboolean_reorder_mesh(moved_name, insert_at)
                if not ok:
                    self._warning("Reorder input : Maya n'a pas accepte polyBooleanCmd -reorderMesh pour {}.".format(moved_name))
        finally:
            if undo_open:
                try:
                    cmds.undoInfo(closeChunk=True)
                except Exception:
                    pass


        if maya_available() and self.poly_node and cmds.objExists(self.poly_node):
            refreshed = find_input_transforms(self.poly_node)
            if refreshed:
                self.input_names = refreshed
            else:
                items = list(self.input_names)
                moved = items.pop(source_index)
                items.insert(insert_at, moved)
                self.input_names = items
        else:
            items = list(self.input_names)
            moved = items.pop(source_index)
            items.insert(insert_at, moved)
            self.input_names = items

        try:
            self._selected_row_index = self.input_names.index(moved_name)
        except Exception:
            self._selected_row_index = insert_at
        self._rebuild_input_rows()
        self._update_input_list_height()
        return True

    def _apply_input_reorder_group(self, source_indices, target_index, side):

        if not self.input_names:
            return False
        try:
            source_indices = sorted(set(int(i) for i in source_indices if 0 <= int(i) < len(self.input_names)))
        except Exception:
            source_indices = []
        if not source_indices:
            return False
        if target_index < 0 or target_index >= len(self.input_names):
            return False


        if int(target_index) in source_indices:
            return False

        original = list(self.input_names)
        moving_names = [original[i] for i in source_indices]
        moving_set = set(moving_names)
        remaining = [n for n in original if n not in moving_set]

        raw_insert = int(target_index) + (1 if side > 0 else 0)
        moved_before = len([i for i in source_indices if i < raw_insert])
        insert_at = max(0, min(len(remaining), raw_insert - moved_before))
        new_order = remaining[:insert_at] + moving_names + remaining[insert_at:]

        if new_order == original:
            return False

        ok_any = False
        undo_open = False
        if maya_available():
            try:
                cmds.undoInfo(openChunk=True, chunkName="UiBoolean Reorder Input Block")
                undo_open = True
            except Exception:
                pass
        try:
            for new_idx, name in enumerate(new_order):
                if name not in original:
                    continue
                if self._apply_polyboolean_reorder_mesh(name, new_idx):
                    ok_any = True
        finally:
            if undo_open:
                try:
                    cmds.undoInfo(closeChunk=True)
                except Exception:
                    pass

        if not ok_any:
            self._warning("Reorder inputs : Maya n'a pas accepte le deplacement du bloc selectionne.")
            return False

        moved_names = list(moving_names)
        self.refresh_from_scene()
        selected_after = []
        for name in moved_names:
            try:
                selected_after.append(self.input_names.index(name))
            except Exception:
                pass
        if selected_after:
            self._replace_selected_rows(selected_after)
        return True

    def _apply_polyboolean_reorder_mesh(self, mesh_name, new_index):

        if not maya_available() or not self.poly_node or not mesh_name:
            return False
        if not cmds.objExists(self.poly_node) or not cmds.objExists(mesh_name):
            return False
        try:
            cmds.polyBooleanCmd(self.poly_node, edit=True, reorderMesh=[mesh_name, int(new_index)])
            return True
        except Exception:
            pass
        try:
            cmds.polyBooleanCmd(self.poly_node, e=True, rom=[mesh_name, int(new_index)])
            return True
        except Exception:
            pass
        if mel is not None:
            try:
                mel.eval('polyBooleanCmd -edit -reorderMesh "{mesh}" {idx} "{node}";'.format(
                    mesh=_maya_name_for_cmd(mesh_name),
                    idx=int(new_index),
                    node=_maya_name_for_cmd(self.poly_node),
                ))
                return True
            except Exception:
                pass
        return False

    def _reorder_new_inputs_below_anchor(self, new_names, anchor_name=None, anchor_index=None):

        if not maya_available() or not self.poly_node:
            return False
        if not cmds.objExists(self.poly_node):
            return False
        requested = []
        seen_req = set()
        for name in new_names or []:
            short = _short_name(name)
            if short and short not in seen_req:
                seen_req.add(short)
                requested.append(short)
        if not requested:
            return False

        try:
            current = find_input_transforms(self.poly_node) or list(getattr(self, "input_names", []) or [])
        except Exception:
            current = list(getattr(self, "input_names", []) or [])
        if not current:
            return False


        current_new = []
        used = set()
        for wanted_short in requested:
            for item in current:
                item_short = _short_name(item)
                if item_short == wanted_short and item_short not in used:
                    current_new.append(item)
                    used.add(item_short)
                    break
        if not current_new:
            return False

        new_short_set = set(_short_name(x) for x in current_new)
        base_order = [n for n in current if _short_name(n) not in new_short_set]

        insert_pos = None
        anchor_short = _short_name(anchor_name) if anchor_name else ""
        if anchor_short:
            for i, name in enumerate(base_order):
                if _short_name(name) == anchor_short:
                    insert_pos = i + 1
                    break

        if insert_pos is None:
            try:
                idx = int(anchor_index)
                if 0 <= idx < len(base_order):
                    insert_pos = idx + 1
            except Exception:
                insert_pos = None

        if insert_pos is None:
            insert_pos = len(base_order)
        insert_pos = max(0, min(len(base_order), int(insert_pos)))

        ok_any = False

        for offset, name in enumerate(current_new):
            target_idx = insert_pos + offset
            if self._apply_polyboolean_reorder_mesh(name, target_idx):
                ok_any = True

        if ok_any:
            try:
                cmds.dgdirty(self.poly_node)
                cmds.refresh(force=True)
            except Exception:
                pass
        return bool(ok_any)

    def _add_insert_anchor_from_current_rows(self):

        before_names = list(getattr(self, "input_names", []) or [])
        if not before_names:
            return None, None

        anchor_index = None
        selected = self._clean_selected_row_indices()
        if selected:
            try:
                anchor_index = max(selected)
            except Exception:
                anchor_index = None

        if anchor_index is None:
            try:
                last_clicked = int(getattr(self, "_last_clicked_row_index", -1))
                if 0 <= last_clicked < len(before_names):
                    anchor_index = last_clicked
            except Exception:
                anchor_index = None

        if anchor_index is None:
            try:
                current = int(getattr(self, "_selected_row_index", -1))
                if 0 <= current < len(before_names):
                    anchor_index = current
            except Exception:
                anchor_index = None

        if anchor_index is None or not (0 <= int(anchor_index) < len(before_names)):
            return None, None
        return before_names[int(anchor_index)], int(anchor_index)

