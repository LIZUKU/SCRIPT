    def _force_grid_widget(self, widget, row, column, row_span=1, col_span=1):
        if widget is None:
            return
        try:
            self.settings_layout.removeWidget(widget)
        except Exception:
            pass
        try:
            self.settings_layout.addWidget(widget, int(row), int(column), int(row_span), int(col_span))
        except Exception:
            pass

    def _combo_fit_width(self, combo, fallback=58):
        try:
            txt = str(combo.currentText() or "Auto")
            fm = combo.fontMetrics()
            if hasattr(fm, "horizontalAdvance"):
                tw = fm.horizontalAdvance(txt)
            else:
                tw = fm.width(txt)
            # Text width + arrow sub-control + tight internal padding.
            return max(self._scaled_w_floor(44, 40), int(tw) + self._scaled_w_floor(30, 26))
        except Exception:
            return int(fallback)

    def _hide_modifier_list_scrollbars(self):
        try:
            policy = getattr(QtCore.Qt, "ScrollBarAlwaysOff", None)
            if policy is None and hasattr(QtCore.Qt, "ScrollBarPolicy"):
                policy = QtCore.Qt.ScrollBarPolicy.ScrollBarAlwaysOff
            if policy is None:
                return
            if getattr(self, "scroll", None) is not None:
                self.scroll.setHorizontalScrollBarPolicy(policy)
                # One modifier row should not expose navigation arrows; height is managed manually.
                self.scroll.setVerticalScrollBarPolicy(policy)
        except Exception:
            pass

    def _apply_modifier_settings_layout_overrides(self):
        """Compact the Modifier Settings grid without stretching combo boxes.

        The parent Boolean template wants large controls. For Modifier Stack the
        combo boxes are labels with a drop arrow, so they should be compact and
        sized close to their text, while sliders keep a stable usable width.
        """
        try:
            label_w = self._scaled_w_floor(76, 72)
            spacing = self._scaled_gap(4, 3, 6)
            combo_bevel_w = self._combo_fit_width(getattr(self, "op_combo", None), self._scaled_w_floor(56, 52))
            combo_miter_w = self._combo_fit_width(getattr(self, "display_combo", None), self._scaled_w_floor(50, 46))
            combo_along_w = self._combo_fit_width(getattr(self, "geometry_combo", None), self._scaled_w_floor(50, 46))
            slider_w = self._scaled_w_floor(160, 150)
            spin_w = self._scaled_w_floor(52, 48)

            self.settings_layout.setContentsMargins(7, 6, 7, 7)
            self.settings_layout.setHorizontalSpacing(spacing)
            self.settings_layout.setVerticalSpacing(max(2, self._scaled(3)))
            self.settings_layout.setColumnMinimumWidth(0, label_w)
            self.settings_layout.setColumnMinimumWidth(1, 1)
            self.settings_layout.setColumnMinimumWidth(2, 1)
            self.settings_layout.setColumnStretch(0, 0)
            self.settings_layout.setColumnStretch(1, 0)
            self.settings_layout.setColumnStretch(2, 0)
            try:
                self.settings_layout.setAlignment((QT_ALIGN_LEFT or 0) | (QT_ALIGN_TOP or 0))
            except Exception:
                pass
        except Exception:
            label_w = 76
            combo_bevel_w = 56
            combo_miter_w = 50
            combo_along_w = 50
            slider_w = 160
            spin_w = 52

        self._force_grid_widget(getattr(self, "fractional_cb", None), 11, 1, 1, 2)
        self._force_grid_widget(getattr(self, "chamfer_cb", None), 12, 1, 1, 2)
        self._force_grid_widget(getattr(self, "force_parallel_cb", None), 13, 1, 1, 2)

        compact_combos = (
            (getattr(self, "op_combo", None), combo_bevel_w),
            (getattr(self, "display_combo", None), combo_miter_w),
            (getattr(self, "geometry_combo", None), combo_along_w),
        )
        for ctl, width in compact_combos:
            try:
                if ctl is None:
                    continue
                ctl.setMinimumWidth(int(width))
                ctl.setMaximumWidth(int(width))
                ctl.setFixedWidth(int(width))
                ctl.setSizePolicy(QtWidgets.QSizePolicy.Fixed, QtWidgets.QSizePolicy.Fixed)
            except Exception:
                pass

        for ctl in (getattr(self, "voxel_edit", None), getattr(self, "segments_edit", None), getattr(self, "depth_edit", None), getattr(self, "filter_angle_edit", None)):
            try:
                if ctl is None:
                    continue
                ctl.setMinimumWidth(int(slider_w))
                ctl.setMaximumWidth(int(slider_w))
                ctl.setFixedWidth(int(slider_w))
                ctl.setSizePolicy(QtWidgets.QSizePolicy.Fixed, QtWidgets.QSizePolicy.Fixed)
                if hasattr(ctl, "spin"):
                    ctl.spin.setMinimumWidth(int(spin_w))
                    ctl.spin.setMaximumWidth(int(spin_w))
                    ctl.spin.setFixedWidth(int(spin_w))
            except Exception:
                pass

        try:
            for _row in range(0, 18):
                item = self.settings_layout.itemAtPosition(_row, 0)
                lab = item.widget() if item else None
                if lab is not None and hasattr(lab, "setAlignment"):
                    lab.setMinimumWidth(label_w)
                    lab.setMaximumWidth(label_w)
                    try:
                        lab.setAlignment(QT_ALIGN_RIGHT | QT_ALIGN_VCENTER)
                    except Exception:
                        pass
        except Exception:
            pass

        for ctl in (getattr(self, "interactive_cb", None), getattr(self, "fractional_cb", None), getattr(self, "chamfer_cb", None), getattr(self, "force_parallel_cb", None)):
            try:
                if ctl is not None:
                    ctl.setMinimumHeight(self._scaled_floor(19, 18))
                    ctl.setMaximumHeight(self._scaled_floor(24, 20))
                    ctl.setSizePolicy(QtWidgets.QSizePolicy.Fixed, QtWidgets.QSizePolicy.Fixed)
            except Exception:
                pass

        try:
            radio_item = self.settings_layout.itemAtPosition(10, 1) or self.settings_layout.itemAtPosition(5, 1)
            radio_widget = radio_item.widget() if radio_item else None
            if radio_widget is not None:
                radio_widget.setMinimumHeight(self._scaled_floor(58, 52))
                radio_widget.setMaximumHeight(self._scaled_floor(70, 60))
                radio_widget.setMaximumWidth(int(slider_w))
                radio_widget.setSizePolicy(QtWidgets.QSizePolicy.Fixed, QtWidgets.QSizePolicy.Fixed)
        except Exception:
            pass

    def _refresh_modifier_settings_body_height(self):
        try:
            self._apply_modifier_settings_layout_overrides()
            self.settings_body.layout().activate()

            current_hint = int(self.settings_body.sizeHint().height()) + self._scaled_floor(6, 4)
            if getattr(self, "_advanced_bevel_visible", False):
                current_hint = max(current_hint, self._scaled_floor(300, 265))
            else:
                current_hint = max(current_hint, self._scaled_floor(205, 188))

            try:
                scale_ratio = max(0.01, float(self._effective_ui_scale_percent()) / 100.0)
                base_hint = int(round(float(current_hint) / scale_ratio))
            except Exception:
                base_hint = current_hint
            base_hint = max(base_hint, 188 if not getattr(self, "_advanced_bevel_visible", False) else 265)

            self._settings_body_open_height_base = base_hint
            self._settings_body_open_height = max(current_hint, self._scaled(base_hint))
            self._settings_open_height = self._settings_closed_height + self._settings_body_open_height

            self.settings_body.setFixedHeight(self._settings_body_open_height)
            self.settings_shell.setFixedHeight(self._settings_open_height if self.settings_header.isChecked() else self._settings_closed_height)
            open_min_w = max(self._closed_minimum_size.width(), self._modifier_compact_dialog_width())
            locked_w = getattr(self, "_modifier_settings_toggle_locked_width", None)
            if locked_w:
                try:
                    open_min_w = min(int(open_min_w), int(locked_w))
                except Exception:
                    pass
            self._open_minimum_size = QtCore.QSize(open_min_w, self._closed_minimum_size.height() + self._settings_body_open_height)
            if self.settings_header.isChecked():
                self.setMinimumSize(self._open_minimum_size)
            else:
                self.setMinimumSize(self._closed_minimum_size)
            self._apply_modifier_width_cap(force_resize=False)
        except Exception:
            pass

