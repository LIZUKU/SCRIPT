class ModifierValueSlider(QtWidgets.QWidget):
    valueChanged = QtCore.Signal(float)
    editingFinished = QtCore.Signal()

    def __init__(self, minimum=0.0, maximum=1.0, value=0.0, decimals=3, integer=False, parent=None):
        super(ModifierValueSlider, self).__init__(parent)
        try:
            self.setSizePolicy(QtWidgets.QSizePolicy.Expanding, QtWidgets.QSizePolicy.Fixed)
            self.setMinimumHeight(22)
        except Exception:
            pass
        self._integer = bool(integer)
        self._decimals = int(decimals)
        self._factor = 1 if self._integer else 1000
        self._updating = False
        self._slider_min = float(minimum)
        self._slider_max = float(maximum)
        self._spin_min = float(minimum)
        self._spin_max = float(maximum)

        lay = QtWidgets.QHBoxLayout(self)
        lay.setContentsMargins(0, 0, 0, 0)
        lay.setSpacing(4)

        self.slider = QtWidgets.QSlider(QtCore.Qt.Horizontal)
        self.slider.setObjectName("ModifierValueSlider")

        self.minus_btn = QtWidgets.QPushButton(u"-")
        self.minus_btn.setObjectName("ModifierStepButton")
        self.minus_btn.setFixedSize(17, 18)
        self.minus_btn.setToolTip("Decrease value")

        self.plus_btn = QtWidgets.QPushButton("+")
        self.plus_btn.setObjectName("ModifierStepButton")
        self.plus_btn.setFixedSize(17, 18)
        self.plus_btn.setToolTip("Increase value")

        self.spin = QtWidgets.QSpinBox() if self._integer else ModifierCommaDoubleSpinBox()
        self.spin.setObjectName("VoxelEdit")
        self.spin.setFixedWidth(72)
        try:
            self.spin.setButtonSymbols(QtWidgets.QAbstractSpinBox.NoButtons)
        except Exception:
            pass

        try:
            self.slider.setStyleSheet(_ms_modifier_slider_qss())
            self.spin.setStyleSheet(_ms_modifier_spinbox_qss())
            step_qss = """
QPushButton#ModifierStepButton {
    background-color: #242424;
    border: 1px solid #151515;
    border-radius: 2px;
    color: #cfcfcf;
    padding: 0px;
    font-weight: bold;
}
QPushButton#ModifierStepButton:hover {
    background-color: #333333;
    border: 1px solid #555555;
    color: #ffffff;
}
QPushButton#ModifierStepButton:pressed {
    background-color: #151515;
    border: 1px solid #777777;
}
"""
            self.minus_btn.setStyleSheet(step_qss)
            self.plus_btn.setStyleSheet(step_qss)
        except Exception:
            pass

        if not self._integer:
            self.spin.setDecimals(self._decimals)
            self.spin.setSingleStep(0.01)
        else:
            self.spin.setSingleStep(1)

        self.setRange(minimum, maximum)
        lay.addWidget(self.slider, 1)
        lay.addWidget(self.minus_btn, 0)
        lay.addWidget(self.spin, 0)
        lay.addWidget(self.plus_btn, 0)

        self.setValue(value)
        self.slider.valueChanged.connect(self._from_slider)
        self.spin.valueChanged.connect(self._from_spin)
        self.minus_btn.clicked.connect(lambda: self.stepBy(-1))
        self.plus_btn.clicked.connect(lambda: self.stepBy(1))
        try:
            self.spin.editingFinished.connect(self._commit_spin_text)
            self.spin.editingFinished.connect(self.editingFinished.emit)
        except Exception:
            pass

    def setRange(self, minimum, maximum):
        self._slider_min = float(minimum)
        self._slider_max = float(maximum)
        self.slider.setRange(int(round(self._slider_min * self._factor)), int(round(self._slider_max * self._factor)))
        if self._integer:
            self.spin.setRange(int(round(self._spin_min)), int(round(self._spin_max)))
        else:
            self.spin.setRange(float(self._spin_min), float(self._spin_max))

    def setSpinRange(self, minimum, maximum):
        self._spin_min = float(minimum)
        self._spin_max = float(maximum)
        if self._integer:
            self.spin.setRange(int(round(self._spin_min)), int(round(self._spin_max)))
        else:
            self.spin.setRange(float(self._spin_min), float(self._spin_max))

    def setSingleStep(self, step):
        try:
            self.spin.setSingleStep(int(step) if self._integer else float(step))
        except Exception:
            pass

    def value(self):
        return float(self.spin.value())

    def text(self):
        if self._integer:
            return str(int(self.spin.value()))
        return ("%%.%df" % self._decimals) % float(self.spin.value())

    def setText(self, text):
        try:
            self.setValue(float(str(text).replace(",", ".")))
        except Exception:
            pass

    def _commit_spin_text(self):
        try:
            txt = self.spin.lineEdit().text() if hasattr(self.spin, "lineEdit") else ""
            if txt:
                self.setValue(float(str(txt).replace(",", ".")))
        except Exception:
            pass

    def setValue(self, value):
        self._updating = True
        try:
            v = int(round(float(value))) if self._integer else float(value)
            v = max(self._spin_min, min(self._spin_max, float(v)))
            if self._integer:
                v = int(round(v))
            self.spin.setValue(v)
            sv = max(self._slider_min, min(self._slider_max, float(v)))
            self.slider.setValue(int(round(float(sv) * self._factor)))
        finally:
            self._updating = False

    def stepBy(self, steps):
        try:
            step = self.spin.singleStep()
            self.setValue(self.value() + (float(step) * float(steps)))
            self.valueChanged.emit(float(self.spin.value()))
            self.editingFinished.emit()
        except Exception:
            pass

    def _from_slider(self, ivalue):
        if self._updating:
            return
        self._updating = True
        try:
            v = int(ivalue) if self._integer else float(ivalue) / float(self._factor)
            self.spin.setValue(v)
        finally:
            self._updating = False
        self.valueChanged.emit(float(self.spin.value()))

    def _from_spin(self, value):
        if self._updating:
            return
        self._updating = True
        try:
            sv = max(self._slider_min, min(self._slider_max, float(value)))
            self.slider.setValue(int(round(float(sv) * self._factor)))
        finally:
            self._updating = False
        self.valueChanged.emit(float(self.spin.value()))


