def rename_node_safely(old_name, new_name):
    if not maya_available() or not old_name or not new_name:
        return old_name
    if not cmds.objExists(old_name):
        return old_name
    new_name = new_name.strip()
    if not new_name or old_name == new_name:
        return old_name
    try:
        return cmds.rename(old_name, new_name)
    except Exception as exc:
        try:
            cmds.warning("Impossible de renommer {0} en {1}: {2}".format(old_name, new_name, exc))
        except Exception:
            pass
        return old_name


