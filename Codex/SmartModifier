def _qd_grid_pos_for_widget(ui, widget):
    if ui is None or widget is None or not hasattr(ui, "settings_layout"):
        return None
    try:
        idx = ui.settings_layout.indexOf(widget)
        if idx < 0:
            return None
        return ui.settings_layout.getItemPosition(idx)  # row, col, rowSpan, colSpan
    except Exception:
        return None


def _qd_setting_label_for_widget(ui, widget):
    pos = _qd_grid_pos_for_widget(ui, widget)
    if not pos:
        return None
    row = int(pos[0])
    try:
        item = ui.settings_layout.itemAtPosition(row, 0)
        lab = item.widget() if item else None
        if lab is not widget:
            return lab
    except Exception:
        pass
    return None


def _qd_rename_label_for_widget(ui, widget, text):
