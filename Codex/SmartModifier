def _find_polyboolean_from_selection_copy_tab_style():

    if not maya_available():
        return None

    try:
        sel = cmds.ls(sl=True, long=True, flatten=True) or []
    except Exception:
        sel = []

    if not sel:
        return None

    raw = str(sel[0]).split('.', 1)[0]
    if not raw:
        return None

    obj = None
    for candidate in (raw, _short_name(raw)):
        try:
            if candidate and cmds.objExists(candidate):
                obj = candidate
                break
        except Exception:
            pass

    if not obj:
        return None

    source = obj
    try:
        shapes = cmds.listRelatives(obj, s=True, ni=True, fullPath=True) or []
        if shapes:
            source = shapes[0]
    except Exception:
        pass


    try:
        hist = cmds.listHistory(source, pruneDagObjects=True) or []
    except Exception:
        hist = []
    booleans = []
    for node in hist:
        try:
            if _is_polyboolean_node(node):
                booleans.append(node)
        except Exception:
            pass
    if booleans:
        return _short_name(booleans[-1])


    try:
        future = cmds.listHistory(source, future=True, pruneDagObjects=True) or []
    except Exception:
        future = []
    booleans_future = []
    for node in future:
        try:
            if _is_polyboolean_node(node):
                booleans_future.append(node)
        except Exception:
            pass
    if booleans_future:
        return _short_name(booleans_future[0])


    try:
        if cmds.objExists(obj) and _is_polyboolean_node(obj):
            return _short_name(obj)
    except Exception:
        pass

    return None


def find_polybooleans_from_selection_strict():

    if not maya_available():
        return []

    try:
        sel = cmds.ls(sl=True, long=False, flatten=True) or []
    except Exception:
        sel = []
    if not sel:
        return []

    candidates = []
    preferred = _find_polyboolean_from_selection_copy_tab_style()
    if preferred:
        _append_boolean_candidate(candidates, preferred)

    selected_transforms = set()

    for raw in sel:
        raw_node = str(raw).split('.', 1)[0]
        if not raw_node:
            continue


        for n in _related_nodes_for_boolean_detection(raw_node):
            _append_boolean_candidate(candidates, n)


        for n in _related_nodes_for_boolean_detection(raw_node):
            for future in (False, True):
                try:
                    hist = cmds.listHistory(n, future=future, pruneDagObjects=False) or []
                except Exception:
                    hist = []
                for h in hist:
                    _append_boolean_candidate(candidates, h)


            try:
                conns = cmds.listConnections(n, s=True, d=True, plugs=False) or []
            except Exception:
                conns = []
            for c in conns:
                _append_boolean_candidate(candidates, c)

        try:
            transform = _as_transform(raw_node)
            if transform and cmds.objExists(transform):
                selected_transforms.add(_short_name(transform))
        except Exception:
            pass


    if selected_transforms:
        for pb in list_all_polyboolean_nodes():
            try:
                result = _short_name(find_result_transform(pb))
            except Exception:
                result = ""
            if result and result in selected_transforms:
                _append_boolean_candidate(candidates, pb)
                continue
            try:
                inputs = set(_short_name(x) for x in find_input_transforms(pb))
            except Exception:
                inputs = set()
            if inputs.intersection(selected_transforms):
                _append_boolean_candidate(candidates, pb)

    return _unique_keep_order(candidates)


