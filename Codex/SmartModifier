    def _select_created_duplicate_inputs(self, new_names):

        if not maya_available():
            return

        wanted_shorts = []
        seen = set()
        for name in new_names or []:
            short = _short_name(name)
            if short and short not in seen:
                seen.add(short)
                wanted_shorts.append(short)
        if not wanted_shorts:
            return

        def _resolve_existing():
            resolved = []
            used = set()
            for short in wanted_shorts:
                candidates = []
                try:
                    if cmds.objExists(short):
                        candidates.append(short)
                except Exception:
                    pass
                try:
                    candidates.extend(cmds.ls(short, long=False) or [])
                except Exception:
                    pass
                try:
                    candidates.extend(cmds.ls("*" + short, long=False) or [])
                except Exception:
                    pass
                for candidate in candidates:
                    c_short = _short_name(candidate)
                    if c_short != short or c_short in used:
                        continue
                    try:
                        tr = _as_transform(candidate)
                        if tr and cmds.objExists(tr):
                            resolved.append(tr)
                            used.add(c_short)
                            break
                    except Exception:
                        pass
            return _unique_keep_order(resolved)

        def _select_now(sync_ui=True):
            resolved = _resolve_existing()
            if not resolved:
                return
            try:
                cmds.select(resolved, r=True)
            except Exception:
                pass
            if sync_ui:
                try:
                    wanted = set(_short_name(x) for x in resolved)
                    row_indices = [i for i, name in enumerate(self.input_names) if _short_name(name) in wanted]
                    if row_indices:
                        self._replace_selected_rows(row_indices, select_in_maya=False)
                    else:
                        self._sync_selection_from_maya()
                except Exception:
                    pass


        _select_now(sync_ui=True)


        if QtCore is not None:
            try:
                self._duplicate_select_token = int(getattr(self, "_duplicate_select_token", 0)) + 1
                token = self._duplicate_select_token
            except Exception:
                token = 0

            def _deferred_select():
                if not _qt_object_is_valid(self):
                    return
                try:
                    if token and token != getattr(self, "_duplicate_select_token", 0):
                        return
                except Exception:
                    pass
                _select_now(sync_ui=True)

            try:
                QtCore.QTimer.singleShot(0, _deferred_select)
                QtCore.QTimer.singleShot(80, _deferred_select)
            except Exception:
                pass

    def _duplicate_input_from_row(self, object_name, index, mode="copy"):

        if not maya_available():
            return False
        if not self.poly_node or not cmds.objExists(self.poly_node):
            self._warning("Duplicate input : aucun polyBoolean actif.")
            return False
        if not object_name or not cmds.objExists(object_name):
            self._warning("Duplicate input : objet introuvable : {0}".format(object_name))
            return False

        new_obj = None
        undo_open = False
        try:
            try:
                cmds.undoInfo(openChunk=True, chunkName="UiBoolean Duplicate Input")
                undo_open = True
            except Exception:
                pass

            if str(mode).lower() == "instance":
                try:
                    inst = cmds.instance(object_name, name=_short_name(object_name) + "_inst#") or []
                except Exception:
                    inst = []
                new_obj = inst[0] if inst else None
            else:


                try:
                    dup = cmds.duplicate(object_name, returnRootsOnly=True, renameChildren=True) or []
                except Exception:
                    dup = []
                new_obj = dup[0] if dup else None
                if new_obj:
                    try:
                        new_obj = cmds.rename(new_obj, _short_name(object_name) + "_copy#")
                    except Exception:
                        pass

            if not new_obj or not cmds.objExists(new_obj):
                self._warning("Duplicate input : impossible de creer la copie/instance de {0}.".format(object_name))
                return False

            try:
                cmds.setAttr(new_obj + ".visibility", _get_transform_visibility(object_name, True))
            except Exception:
                pass

            op_label = self._input_operation_label_for_index(index)
            if not add_objects_to_boolean(self.poly_node, [new_obj], op_label):
                self._warning("Duplicate input : la copie a ete creee mais n'a pas pu etre ajoutee au boolean.")
            else:
                self._remember_input_operation_label(new_obj, op_label)


                self._reorder_new_inputs_below_anchor([new_obj], anchor_name=object_name, anchor_index=index)
                _force_boolean_stack_inputs_display_mode(self.poly_node, [new_obj], DEFAULT_NEW_INPUT_DISPLAY_LABEL)
        finally:
            if undo_open:
                try:
                    cmds.undoInfo(closeChunk=True)
                except Exception:
                    pass

        self.refresh_from_scene()
        self._refit_after_input_stack_change()
        self._refresh_hide_cutters_button_state()


        self._select_created_duplicate_inputs([new_obj])
        return True

    def _remove_input_from_boolean(self, object_name, index):

        if not maya_available():
            return False
        if not self.poly_node or not cmds.objExists(self.poly_node):
            self._warning("Remove input : aucun polyBoolean actif.")
            return False
        if not object_name:
            return False

        ok = False
        undo_open = False
        try:
            try:
                cmds.undoInfo(openChunk=True, chunkName="UiBoolean Remove Input")
                undo_open = True
            except Exception:
                pass


            attempts = [
                lambda: cmds.polyBooleanCmd(self.poly_node, edit=True, removeMesh=object_name),
                lambda: cmds.polyBooleanCmd(self.poly_node, edit=True, removeMesh=int(index)),
                lambda: cmds.polyBooleanCmd(self.poly_node, e=True, rm=object_name),
                lambda: cmds.polyBooleanCmd(self.poly_node, e=True, rm=int(index)),
                lambda: cmds.polyBooleanCmd(self.poly_node, edit=True, removeInput=int(index)),
                lambda: cmds.polyBooleanCmd(self.poly_node, e=True, ri=int(index)),
            ]
            for fn in attempts:
                try:
                    fn()
                    ok = True
                    break
                except Exception:
                    pass
            if not ok and mel is not None:
                for cmd in (
                    'polyBooleanCmd -edit -removeMesh "{mesh}" "{node}";'.format(mesh=_maya_name_for_cmd(object_name), node=_maya_name_for_cmd(self.poly_node)),
                    'polyBooleanCmd -edit -removeMesh {idx} "{node}";'.format(idx=int(index), node=_maya_name_for_cmd(self.poly_node)),
                    'polyBooleanCmd -edit -removeInput {idx} "{node}";'.format(idx=int(index), node=_maya_name_for_cmd(self.poly_node)),
                ):
                    try:
                        mel.eval(cmd)
                        ok = True
                        break
                    except Exception:
                        pass
        finally:
            if undo_open:
                try:
                    cmds.undoInfo(closeChunk=True)
                except Exception:
                    pass

        if not ok:
            self._warning("Remove input : Maya n'a pas accepte le retrait de {0}.".format(object_name))
            return False
        self.refresh_from_scene()
        return True

    def _input_smooth_plug_candidates(self, object_name, index):
        plugs = []
        if not maya_available() or not self.poly_node or not cmds.objExists(self.poly_node):
            return plugs
        try:
            mapping = find_input_connection_indices(self.poly_node)
            idx = mapping.get(object_name, index)
        except Exception:
            idx = index
        patterns = [
            "inputObjects[{i}].useSmoothMeshOutput",
            "inputObjects[{i}].useSmoothMesh",
            "inputObjects[{i}].smoothMeshOutput",
            "inputObject[{i}].useSmoothMeshOutput",
            "inputObject[{i}].useSmoothMesh",
            "inputData[{i}].useSmoothMeshOutput",
            "inputData[{i}].useSmoothMesh",
            "input[{i}].useSmoothMeshOutput",
            "input[{i}].useSmoothMesh",
            "inputPoly[{i}].useSmoothMeshOutput",
            "inputPoly[{i}].useSmoothMesh",
        ]
        for pattern in patterns:
            plug = self.poly_node + "." + pattern.format(i=int(idx))
            if _plug_exists(plug):
                plugs.append(plug)
        return plugs

    def _get_input_smooth_mesh_output(self, object_name, index):
        if not maya_available():
            return False
        for plug in self._input_smooth_plug_candidates(object_name, index):
            try:
                return bool(cmds.getAttr(plug))
            except Exception:
                pass
        try:
            for shape in _shape_nodes(object_name):
                plug = shape + ".displaySmoothMesh"
                if cmds.objExists(plug):
                    return bool(cmds.getAttr(plug))
        except Exception:
            pass
        return False

    def _set_input_smooth_mesh_output(self, object_name, index, enabled):
        if not maya_available():
            return False
        enabled = bool(enabled)
        changed = False
        undo_open = False
        try:
            try:
                cmds.undoInfo(openChunk=True, chunkName="UiBoolean Smooth Mesh Output")
                undo_open = True
            except Exception:
                pass

            for plug in self._input_smooth_plug_candidates(object_name, index):
                try:
                    cmds.setAttr(plug, enabled)
                    changed = True
                except Exception:
                    pass


            try:
                for shape in _shape_nodes(object_name):
                    if cmds.objExists(shape + ".displaySmoothMesh"):
                        try:
                            cmds.setAttr(shape + ".displaySmoothMesh", 2 if enabled else 0)
                            changed = True
                        except Exception:
                            pass
                    if cmds.objExists(shape + ".useSmoothPreviewForRender"):
                        try:
                            cmds.setAttr(shape + ".useSmoothPreviewForRender", enabled)
                            changed = True
                        except Exception:
                            pass
            except Exception:
                pass
        finally:
            if undo_open:
                try:
                    cmds.undoInfo(closeChunk=True)
                except Exception:
                    pass

        if maya_available():
            try:
                if changed:
                    cmds.inViewMessage(
                        amg="Input <hl>{}</hl> smooth mesh output: <hl>{}</hl>".format(object_name, "ON" if enabled else "OFF"),
                        pos="midCenterTop",
                        fade=True,
                    )
                else:
                    cmds.warning("Use smooth mesh output : aucun attribut compatible trouve pour {0}.".format(object_name))
            except Exception:
                pass
        self.refresh_from_scene()
        return changed

    def _clean_selected_row_indices(self):
        try:
            selected = set(int(i) for i in getattr(self, "_selected_row_indices", set()))
        except Exception:
            selected = set()
        return set(i for i in selected if 0 <= i < len(self.input_names))

    def _keyboard_modifier_active(self, modifier):
        if modifier is None or QtWidgets is None:
            return False
        try:
            mods = QtWidgets.QApplication.keyboardModifiers()
            try:
                return bool(mods & modifier)
            except Exception:
                return bool(int(mods) & int(modifier))
        except Exception:
            return False

    def _replace_selected_rows(self, indices, select_in_maya=True):
        clean = set()
        for idx in indices or []:
            try:
                idx = int(idx)
            except Exception:
                continue
            if 0 <= idx < len(self.input_names):
                clean.add(idx)
        self._selected_row_indices = clean
        self._selected_row_index = sorted(clean)[-1] if clean else -1
        if self._selected_row_index >= 0:
            self._last_clicked_row_index = self._selected_row_index
        self._apply_selected_rows_to_ui(select_in_maya=select_in_maya)

    def _apply_selected_rows_to_ui(self, select_in_maya=True):
        self._selected_row_indices = self._clean_selected_row_indices()
        if self._selected_row_index not in self._selected_row_indices:
            self._selected_row_index = sorted(self._selected_row_indices)[-1] if self._selected_row_indices else -1
        for i, row in enumerate(self.input_rows):
            row.setSelected(i in self._selected_row_indices)
        if select_in_maya and maya_available() and self._selected_row_indices:
            objects = []
            for i in sorted(self._selected_row_indices):
                if 0 <= i < len(self.input_names):
                    obj = self.input_names[i]
                    if cmds.objExists(obj):
                        objects.append(obj)
            if objects:
                try:
                    cmds.select(objects, r=True)
                except Exception:
                    pass

    def _target_row_indices_for_action(self, index):
        selected = self._clean_selected_row_indices()
        try:
            index = int(index)
        except Exception:
            index = -1
        if index in selected and len(selected) > 1:
            return sorted(selected)
        if 0 <= index < len(self.input_names):
            return [index]
        return []

    def _set_selected_row(self, index):
        try:
            index = int(index)
        except Exception:
            return
        if index < 0 or index >= len(self.input_names):
            self._replace_selected_rows([])
            return

        ctrl = self._keyboard_modifier_active(QT_CONTROL_MODIFIER)
        shift = self._keyboard_modifier_active(QT_SHIFT_MODIFIER)
        selected = self._clean_selected_row_indices()


        if ctrl and shift:
            if index in selected:
                selected.remove(index)
            else:
                selected.add(index)
        elif shift:
            selected.discard(index)
        elif ctrl:
            selected.add(index)
        else:
            selected = set([index])

        self._selected_row_indices = selected
        self._selected_row_index = index if index in selected else (sorted(selected)[-1] if selected else -1)
        self._last_clicked_row_index = index
        self._apply_selected_rows_to_ui(select_in_maya=True)


    def _rename_node_from_field(self):


        if self._building or self.node_name_edit is None:
            return
        new_name = self.node_name_edit.text().strip()
        if not self.poly_node:
            return
        renamed = rename_node_safely(self.poly_node, new_name)
        self.poly_node = renamed
        self.refresh_from_scene()

    def _refit_after_input_stack_change(self):

        try:
            old_pos = self.pos()
            self._last_list_height = 0
            self._set_input_list_fixed_height(self._compact_input_list_height())
            self.updateGeometry()
            target_w = max(self.width(), self._target_dialog_width_for_scale())
            hint = self.sizeHint()
            target_h = max(self.minimumHeight(), hint.height() if hint and hint.height() > 0 else self.height())
            if QtWidgets is not None:
                try:
                    screen = self.screen() or QtWidgets.QApplication.primaryScreen()
                    if screen:
                        avail = screen.availableGeometry()
                        target_w = min(target_w, max(self.minimumWidth(), avail.width() - 40))
                        target_h = min(target_h, max(self.minimumHeight(), avail.height() - 40))
                except Exception:
                    pass
            self.resize(int(target_w), int(target_h))
            try:
                self.move(old_pos)
            except Exception:
                pass
            self._queue_layout_rebalance()
        except Exception:
            pass

    def _selected_input_indices_from_ui_or_maya(self):

        indices = self._clean_selected_row_indices()
        if indices:
            return sorted(indices)
        if not maya_available():
            return []
        try:
            selected = cmds.ls(sl=True, long=False) or []
        except Exception:
            selected = []
        if not selected:
            return []
        selected_short = set(_short_name(x) for x in selected if x)
        result = []
        for i, name in enumerate(self.input_names):
            if _short_name(name) in selected_short:
                result.append(i)
        return result

