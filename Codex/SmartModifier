def _qt_attr(parent, old_name, enum_group=None, new_name=None):

    if parent is None:
        return None
    if hasattr(parent, old_name):
        return getattr(parent, old_name)
    if enum_group is not None and hasattr(parent, enum_group):
        group = getattr(parent, enum_group)
        lookup_name = new_name or old_name
        if hasattr(group, lookup_name):
            return getattr(group, lookup_name)
    return None


